---
// UniversityTable.astro
const universities = [
  { name: 'CBSE / Generic', formula: 'CGPA × 9.5', eg8: '76.0%', eg7: '66.5%', eg9: '85.5%', note: 'Most widely used default' },
  { name: 'SPPU (Pune Univ.)', formula: '(CGPA × 10) − 7.5', eg8: '72.5%', eg7: '62.5%', eg9: '82.5%', note: 'B.E./B.Tech & PG Engineering' },
  { name: 'VTU (Bangalore)', formula: 'CGPA × 10', eg8: '80.0%', eg7: '70.0%', eg9: '90.0%', note: 'Direct ×10 mapping' },
  { name: 'Mumbai University', formula: '(7.1 × CGPA) + 11', eg8: '67.8%', eg7: '60.7%', eg9: '74.9%', note: 'Linear regression formula' },
  { name: 'Anna University', formula: '(CGPA × 10) − 7.5', eg8: '72.5%', eg7: '62.5%', eg9: '82.5%', note: 'Same as SPPU' },
  { name: 'AKTU / UPTU', formula: 'CGPA × 9.5', eg8: '76.0%', eg7: '66.5%', eg9: '85.5%', note: 'Same as CBSE' },
  { name: 'GTU (Gujarat)', formula: '(CGPA × 10) − 7.5', eg8: '72.5%', eg7: '62.5%', eg9: '82.5%', note: 'Same as SPPU' },
  { name: 'KTU (Kerala)', formula: 'CGPA × 10', eg8: '80.0%', eg7: '70.0%', eg9: '90.0%', note: 'Same as VTU' },
];
---

<section class="uni-section" id="universities">
  <div class="uni-inner">
    <div class="uni-header">
      <div class="section-eyebrow">University Formulas</div>
      <h2 class="section-title">Every university. Every formula.</h2>
      <p class="section-sub">Indian universities each define their own CGPA conversion formula. Using the wrong formula can give you a percentage that's off by as much as 7.5 points.</p>
    </div>

    <div class="table-wrap">
      <table class="data-table" aria-label="University CGPA to percentage formulas">
        <thead>
          <tr>
            <th scope="col">University</th>
            <th scope="col">Formula</th>
            <th scope="col">7.0 CGPA</th>
            <th scope="col">8.0 CGPA</th>
            <th scope="col">9.0 CGPA</th>
            <th scope="col">Notes</th>
          </tr>
        </thead>
        <tbody>
          {universities.map((u) => (
            <tr>
              <td class="uni-name">{u.name}</td>
              <td class="uni-formula"><code>{u.formula}</code></td>
              <td>{u.eg7}</td>
              <td class="highlight-col">{u.eg8}</td>
              <td>{u.eg9}</td>
              <td class="uni-note">{u.note}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <p class="table-disclaimer">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
      Formulas are based on official university ordinances. For official applications, always obtain a percentage equivalence certificate from your university registrar.
    </p>
  </div>
</section>

<style>
  .uni-section {
    padding: 80px 24px;
    background: var(--bg);
  }

  .uni-inner {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 36px;
  }

  .uni-header {
    display: flex;
    flex-direction: column;
    gap: 10px;
    text-align: center;
  }

  .section-eyebrow {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: var(--text-mute);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .section-title {
    font-size: clamp(24px, 3vw, 32px);
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--text-ink);
    margin: 0;
  }

  .section-sub {
    font-size: 15px;
    color: var(--text-body);
    max-width: 560px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .table-wrap {
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--bg-card);
    box-shadow: var(--shadow-sm);
  }

  .data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
  }

  .data-table th {
    background: var(--bg-soft);
    padding: 11px 16px;
    text-align: left;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    font-weight: 400;
    color: var(--text-mute);
    border-bottom: 1px solid var(--border);
    white-space: nowrap;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .data-table td {
    padding: 12px 16px;
    border-bottom: 1px solid var(--border);
    color: var(--text-body);
    vertical-align: middle;
  }

  .data-table tbody tr:last-child td {
    border-bottom: none;
  }

  .data-table tbody tr:hover td {
    background: var(--bg-soft);
  }

  .uni-name {
    font-weight: 600;
    color: var(--text-ink) !important;
    white-space: nowrap;
  }

  .uni-formula code {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 2px 7px;
    color: var(--text-ink);
    white-space: nowrap;
  }

  .highlight-col {
    font-weight: 600;
    color: var(--text-ink) !important;
  }

  .uni-note {
    font-size: 12px;
    color: var(--text-mute) !important;
    white-space: nowrap;
  }

  .table-disclaimer {
    display: flex;
    align-items: flex-start;
    gap: 7px;
    font-size: 12px;
    color: var(--text-mute);
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 12px 16px;
    line-height: 1.5;
  }

  .table-disclaimer svg {
    flex-shrink: 0;
    margin-top: 1px;
  }
</style>
