---
// Hero.astro — Full-width hero with mesh gradient backdrop
---

<section class="hero-section" id="home">
  <!-- Mesh gradient backdrop -->
  <div class="mesh-gradient" aria-hidden="true"></div>

  <div class="hero-inner">
    <!-- Badge -->
    <div class="hero-badge">
      <span class="badge-dot" aria-hidden="true"></span>
      Free · No signup · Instant results · University-specific formulas
    </div>

    <!-- Headline -->
    <h1 class="hero-headline">
      Convert CGPA to<br />
      Percentage — Instantly.
    </h1>

    <!-- Subheading -->
    <p class="hero-sub">
      The most accurate CGPA calculator for Indian students. Supports SPPU, VTU, Mumbai University, Anna University, AKTU and more — with the exact formula your university uses.
    </p>

    <!-- CTA row -->
    <div class="hero-ctas">
      <a href="#calculator" class="cta-primary">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="3"/>
          <line x1="8" y1="12" x2="16" y2="12"/>
          <line x1="12" y1="8" x2="12" y2="16"/>
        </svg>
        Open Calculator
      </a>
      <a href="#universities" class="cta-secondary">View University Formulas</a>
    </div>

    <!-- Trust strip -->
    <div class="hero-trust">
      <span>Trusted by students across</span>
      <div class="trust-unis">
        <span class="trust-tag">SPPU</span>
        <span class="trust-tag">VTU</span>
        <span class="trust-tag">Mumbai Univ.</span>
        <span class="trust-tag">Anna Univ.</span>
        <span class="trust-tag">AKTU</span>
        <span class="trust-tag">GTU</span>
        <span class="trust-tag">KTU</span>
        <span class="trust-tag">+ more</span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    padding: 96px 24px 80px;
    text-align: center;
    overflow: hidden;
    background: var(--bg-card);
    border-bottom: 1px solid var(--border);
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    max-width: 700px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }

  /* Badge */
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: 9999px;
    padding: 5px 14px;
    font-size: 12px;
    font-weight: 400;
    color: var(--text-mute);
    letter-spacing: 0;
    font-family: 'JetBrains Mono', monospace;
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #00c853;
    animation: pulse-dot 2s ease-in-out infinite;
    flex-shrink: 0;
  }

  @keyframes pulse-dot {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(0.8); }
  }

  /* Headline */
  .hero-headline {
    font-size: clamp(36px, 6vw, 60px);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.04em;
    color: var(--text-ink);
    margin: 0;
  }

  /* Subheading */
  .hero-sub {
    font-size: 17px;
    font-weight: 400;
    line-height: 1.65;
    color: var(--text-body);
    max-width: 560px;
    margin: 0;
  }

  /* CTA row */
  .hero-ctas {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 4px;
  }

  .cta-primary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #171717;
    color: #ffffff;
    font-size: 15px;
    font-weight: 500;
    border-radius: 100px;
    padding: 0 20px;
    height: 44px;
    text-decoration: none;
    border: 1px solid #171717;
    transition: opacity 0.15s, transform 0.15s;
  }

  .cta-primary:hover {
    opacity: 0.82;
    transform: translateY(-1px);
  }

  [data-theme="dark"] .cta-primary {
    background: #ededed;
    color: #111111;
    border-color: #ededed;
  }

  .cta-secondary {
    display: inline-flex;
    align-items: center;
    background: var(--bg-card);
    color: var(--text-ink);
    font-size: 15px;
    font-weight: 500;
    border-radius: 100px;
    padding: 0 20px;
    height: 44px;
    text-decoration: none;
    border: 1px solid var(--border);
    transition: border-color 0.15s, background 0.15s, transform 0.15s;
  }

  .cta-secondary:hover {
    border-color: var(--border-strong);
    background: var(--bg-soft);
    transform: translateY(-1px);
  }

  /* Trust strip */
  .hero-trust {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    margin-top: 8px;
  }

  .hero-trust > span {
    font-size: 12px;
    color: var(--text-mute);
    font-family: 'JetBrains Mono', monospace;
  }

  .trust-unis {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    justify-content: center;
  }

  .trust-tag {
    font-size: 11px;
    font-weight: 500;
    color: var(--text-body);
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: 9999px;
    padding: 3px 10px;
    letter-spacing: -0.01em;
  }

  @media (max-width: 600px) {
    .hero-section { padding: 64px 20px 60px; }
    .hero-sub { font-size: 15px; }
    .cta-primary, .cta-secondary { height: 42px; font-size: 14px; }
  }
</style>
