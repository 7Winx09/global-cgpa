---
// SubjectGradeCalculator.astro — Dynamic Add/Remove Subject weighted SGPA/CGPA calculator
// Real-time weighted aggregate with grade points and credits
---

<div class="subject-grade-calc" id="subject-grade-calc">
  <div class="sgc-header">
    <h3 class="sgc-title">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
        <polyline points="14 2 14 8 20 8"></polyline>
        <line x1="16" y1="13" x2="8" y2="13"></line>
        <line x1="16" y1="17" x2="8" y2="17"></line>
        <polyline points="10 9 9 9 8 9"></polyline>
      </svg>
      Subject Grade Calculator (Weighted SGPA/CGPA)
    </h3>
    <p class="sgc-subtitle">Add subjects with grade points and credits — get live weighted aggregate</p>
  </div>

  <!-- AD_SLOT_SUBJECT_CALC_TOP -->
  <div class="ad-slot" style="text-align:center;padding:12px 0;margin:0 -24px 20px;border-top:1px dashed var(--border);border-bottom:1px dashed var(--border);">
    <span style="font-size:0.7rem;font-weight:700;text-transform:uppercase;letter-spacing:1px;color:var(--muted);">Advertisement</span>
    <!-- AD_SLOT_SUBJECT_CALC_TOP -->
  </div>

  <div class="sgc-table-wrap">
    <table class="sgc-table" aria-label="Subject grade entries">
      <thead>
        <tr>
          <th scope="col" style="width: 50px;">#</th>
          <th scope="col">Subject Name</th>
          <th scope="col" style="width: 140px;">Grade Point</th>
          <th scope="col" style="width: 120px;">Credits</th>
          <th scope="col" style="width: 120px;">Weighted</th>
          <th scope="col" style="width: 50px;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <line x1="12" y1="5" x2="12" y2="19"></line>
              <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
          </th>
        </tr>
      </thead>
      <tbody id="sgc-tbody">
        <!-- Rows inserted dynamically -->
      </tbody>
    </table>
  </div>

  <div class="sgc-actions">
    <button type="button" class="sgc-btn sgc-btn-primary" id="sgc-add-row">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="12" y1="5" x2="12" y2="19"></line>
        <line x1="5" y1="12" x2="19" y2="12"></line>
      </svg>
      <span>Add Subject</span>
    </button>
    <button type="button" class="sgc-btn sgc-btn-secondary" id="sgc-clear-all">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="3 6 5 6 21 6"></polyline>
        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
      </svg>
      <span>Clear All</span>
    </button>
  </div>

  <div class="sgc-result" id="sgc-result" aria-live="polite">
    <div class="sgc-result-row">
      <div class="sgc-result-item">
        <span class="sgc-result-label">Total Credits</span>
        <span class="sgc-result-value" id="sgc-total-credits">0</span>
      </div>
      <div class="sgc-result-item">
        <span class="sgc-result-label">Weighted Sum</span>
        <span class="sgc-result-value" id="sgc-weighted-sum">0.00</span>
      </div>
      <div class="sgc-result-item sgc-result-main">
        <span class="sgc-result-label">SGPA / CGPA</span>
        <span class="sgc-result-value" id="sgc-final-result">—</span>
      </div>
    </div>
    <div class="sgc-result-formula" id="sgc-formula-display">
      Formula: Σ(Grade Point × Credits) ÷ Σ(Credits)
    </div>
  </div>

  <div class="sgc-presets">
    <span class="sgc-preset-label">Quick Load:</span>
    <button type="button" class="sgc-preset-btn" data-preset="sem1">Semester 1 (4 subjects)</button>
    <button type="button" class="sgc-preset-btn" data-preset="sem2">Semester 2 (5 subjects)</button>
    <button type="button" class="sgc-preset-btn" data-preset="full">Full Year (8 subjects)</button>
  </div>
</div>

<style>
  .subject-grade-calc {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 24px;
    margin-top: 24px;
  }

  .sgc-header {
    margin-bottom: 20px;
  }

  .sgc-title {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text);
    margin: 0 0 6px;
  }

  .sgc-title svg {
    color: var(--primary);
  }

  .sgc-subtitle {
    font-size: 0.85rem;
    color: var(--muted);
    margin: 0;
  }

  .sgc-table-wrap {
    overflow-x: auto;
    margin-bottom: 16px;
    border-radius: 10px;
    border: 1px solid var(--border);
  }

  .sgc-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.85rem;
  }

  .sgc-table th {
    background: var(--bg);
    padding: 10px 12px;
    text-align: left;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--muted);
    border-bottom: 1px solid var(--border);
    font-family: 'JetBrains Mono', monospace;
    white-space: nowrap;
  }

  .sgc-table td {
    padding: 10px 12px;
    border-bottom: 1px solid var(--border);
    vertical-align: middle;
  }

  .sgc-table tbody tr:last-child td {
    border-bottom: none;
  }

  .sgc-table tbody tr:hover {
    background: var(--bg);
  }

  .sgc-row-num {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    color: var(--muted);
    font-weight: 600;
  }

  .sgc-input {
    width: 100%;
    background: var(--bg);
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: 8px;
    font-family: inherit;
    font-size: 0.9rem;
    font-weight: 500;
    padding: 8px 12px;
    transition: border-color 0.15s, box-shadow 0.15s;
    outline: none;
  }

  .sgc-input:focus {
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.15);
  }

  .sgc-input-name {
    font-size: 0.85rem;
  }

  .sgc-input-grade {
    text-align: center;
  }

  .sgc-input-credits {
    text-align: center;
  }

  .sgc-weighted-cell {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--primary);
    background: rgba(16, 185, 129, 0.08);
    padding: 8px 12px;
    border-radius: 8px;
    text-align: center;
  }

  .sgc-remove-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background: none;
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--muted);
    cursor: pointer;
    transition: all 0.15s;
    margin: 0 auto;
  }

  .sgc-remove-btn:hover {
    background: #fee2e2;
    border-color: #fca5a5;
    color: #dc2626;
  }

  .sgc-remove-btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .sgc-actions {
    display: flex;
    gap: 12px;
    margin-bottom: 20px;
    flex-wrap: wrap;
  }

  .sgc-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    border-radius: 10px;
    font-family: inherit;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s;
    border: none;
  }

  .sgc-btn-primary {
    background: var(--primary);
    color: white;
  }

  .sgc-btn-primary:hover {
    background: var(--primary-dark);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);
  }

  .sgc-btn-secondary {
    background: var(--bg);
    color: var(--text);
    border: 1px solid var(--border);
  }

  .sgc-btn-secondary:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .sgc-result {
    background: linear-gradient(135deg, var(--bg), var(--card));
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 20px;
    margin-bottom: 16px;
  }

  .sgc-result-row {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 12px;
  }

  .sgc-result-item {
    flex: 1;
    min-width: 140px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .sgc-result-item.sgc-result-main {
    flex: 2;
    min-width: 180px;
    border-left: 2px solid var(--primary);
    padding-left: 16px;
  }

  .sgc-result-label {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--muted);
  }

  .sgc-result-value {
    font-family: 'JetBrains Mono', monospace;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text);
  }

  .sgc-result-item.sgc-result-main .sgc-result-value {
    font-size: 2rem;
    color: var(--primary);
  }

  .sgc-result-formula {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    color: var(--muted);
    padding-top: 12px;
    border-top: 1px solid var(--border);
  }

  .sgc-presets {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    padding-top: 16px;
    border-top: 1px solid var(--border);
  }

  .sgc-preset-label {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--muted);
  }

  .sgc-preset-btn {
    padding: 6px 12px;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 999px;
    font-family: inherit;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--text);
    cursor: pointer;
    transition: all 0.15s;
  }

  .sgc-preset-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .sgc-empty-state {
    text-align: center;
    padding: 40px 20px;
    color: var(--muted);
  }

  .sgc-empty-state svg {
    width: 48px;
    height: 48px;
    margin-bottom: 12px;
    opacity: 0.5;
  }

  .sgc-empty-state p {
    font-size: 0.9rem;
    margin: 0 0 8px;
  }

  .sgc-empty-state small {
    font-size: 0.75rem;
  }

  @media (max-width: 640px) {
    .subject-grade-calc {
      padding: 16px;
    }
    .sgc-table th:nth-child(2),
    .sgc-table td:nth-child(2) {
      min-width: 120px;
    }
    .sgc-result-row {
      flex-direction: column;
      gap: 12px;
    }
    .sgc-result-item.sgc-result-main {
      border-left: none;
      border-top: 2px solid var(--primary);
      padding-left: 0;
      padding-top: 12px;
    }
  }
</style>

<script is:inline>
let subjectRowId = 0;
const PRESETS = {
  sem1: [
    { name: 'Mathematics I', grade: 9, credits: 4 },
    { name: 'Physics', grade: 8, credits: 4 },
    { name: 'Chemistry', grade: 8, credits: 3 },
    { name: 'Programming Fundamentals', grade: 9, credits: 4 }
  ],
  sem2: [
    { name: 'Mathematics II', grade: 8, credits: 4 },
    { name: 'Data Structures', grade: 9, credits: 4 },
    { name: 'Digital Logic', grade: 8, credits: 3 },
    { name: 'Discrete Mathematics', grade: 7, credits: 3 },
    { name: 'Environmental Science', grade: 8, credits: 2 }
  ],
  full: [
    { name: 'Mathematics I', grade: 9, credits: 4 },
    { name: 'Physics', grade: 8, credits: 4 },
    { name: 'Chemistry', grade: 8, credits: 3 },
    { name: 'Programming Fundamentals', grade: 9, credits: 4 },
    { name: 'Mathematics II', grade: 8, credits: 4 },
    { name: 'Data Structures', grade: 9, credits: 4 },
    { name: 'Digital Logic', grade: 8, credits: 3 },
    { name: 'Discrete Mathematics', grade: 7, credits: 3 }
  ]
};

function createRow(subject = null) {
  subjectRowId++;
  const tr = document.createElement('tr');
  tr.dataset.rowId = subjectRowId;

  const nameVal = subject?.name || `Subject ${subjectRowId}`;
  const gradeVal = subject?.grade || '';
  const creditsVal = subject?.credits || '';

  tr.innerHTML = `
    <td><span class="sgc-row-num">${subjectRowId}</span></td>
    <td><input type="text" class="sgc-input sgc-input-name" placeholder="Subject name" value="${escapeHtml(nameVal)}" aria-label="Subject name"></td>
    <td><input type="number" class="sgc-input sgc-input-grade" placeholder="0–10" min="0" max="10" step="0.1" value="${gradeVal}" aria-label="Grade point (0-10)"></td>
    <td><input type="number" class="sgc-input sgc-input-credits" placeholder="Credits" min="0.5" max="10" step="0.5" value="${creditsVal}" aria-label="Subject credits"></td>
    <td><span class="sgc-weighted-cell" data-weighted>0.00</span></td>
    <td><button type="button" class="sgc-remove-btn" aria-label="Remove subject" ${subjectRowId <= 1 ? 'disabled' : ''}><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg></button></td>
  `;

  return tr;
}

function escapeHtml(text) {
  const div = document.createElement('div');
  div.textContent = text;
  return div.innerHTML;
}

function recalc() {
  const tbody = document.getElementById('sgc-tbody');
  if (!tbody) return;

  let totalCredits = 0;
  let weightedSum = 0;
  let validRows = 0;

  tbody.querySelectorAll('tr').forEach((row) => {
    const gradeInput = row.querySelector('.sgc-input-grade');
    const creditsInput = row.querySelector('.sgc-input-credits');
    const weightedCell = row.querySelector('[data-weighted]');

    const grade = parseFloat(gradeInput?.value || '');
    const credits = parseFloat(creditsInput?.value || '');

    if (!isNaN(grade) && !isNaN(credits) && grade >= 0 && credits > 0) {
      const weighted = grade * credits;
      weightedCell.textContent = weighted.toFixed(2);
      weightedSum += weighted;
      totalCredits += credits;
      validRows++;
    } else {
      weightedCell.textContent = '0.00';
    }
  });

  const finalResult = document.getElementById('sgc-final-result');
  const totalCreditsEl = document.getElementById('sgc-total-credits');
  const weightedSumEl = document.getElementById('sgc-weighted-sum');

  totalCreditsEl.textContent = totalCredits.toFixed(1);
  weightedSumEl.textContent = weightedSum.toFixed(2);

  if (validRows > 0 && totalCredits > 0) {
    const result = weightedSum / totalCredits;
    finalResult.textContent = result.toFixed(2);
  } else {
    finalResult.textContent = '—';
  }

  // Update row numbers after potential removals
  updateRowNumbers();
}

function updateRowNumbers() {
  const tbody = document.getElementById('sgc-tbody');
  if (!tbody) return;
  tbody.querySelectorAll('tr').forEach((row, idx) => {
    const numEl = row.querySelector('.sgc-row-num');
    if (numEl) numEl.textContent = idx + 1;
    row.dataset.rowId = idx + 1;
  });
  subjectRowId = tbody.children.length;
}

function addRow(subject = null) {
  const tbody = document.getElementById('sgc-tbody');
  if (!tbody) return;

  const tr = createRow(subject);
  tbody.appendChild(tr);
  bindRowEvents(tr);
  recalc();
}

function bindRowEvents(tr) {
  const inputs = tr.querySelectorAll('.sgc-input');
  inputs.forEach(input => {
    input.addEventListener('input', recalc);
    input.addEventListener('change', recalc);
  });

  const removeBtn = tr.querySelector('.sgc-remove-btn');
  removeBtn?.addEventListener('click', () => {
    const tbody = document.getElementById('sgc-tbody');
    if (tbody && tbody.children.length > 1) {
      tr.remove();
      updateRowNumbers();
      recalc();
    }
  });
}

function clearAll() {
  const tbody = document.getElementById('sgc-tbody');
  if (!tbody) return;
  tbody.innerHTML = '';
  subjectRowId = 0;
  addRow(); // Add one empty row
  recalc();
}

function loadPreset(presetKey) {
  const preset = PRESETS[presetKey];
  if (!preset) return;

  const tbody = document.getElementById('sgc-tbody');
  if (!tbody) return;

  tbody.innerHTML = '';
  subjectRowId = 0;

  preset.forEach(subj => addRow(subj));
  recalc();
}

function initSubjectGradeCalc() {
  const tbody = document.getElementById('sgc-tbody');
  const addBtn = document.getElementById('sgc-add-row');
  const clearBtn = document.getElementById('sgc-clear-all');

  if (!tbody || !addBtn || !clearBtn) return;

  // Add initial row
  addRow();

  // Event listeners
  addBtn.addEventListener('click', () => addRow());
  clearBtn.addEventListener('click', clearAll);

  // Preset buttons
  document.querySelectorAll('.sgc-preset-btn').forEach(btn => {
    btn.addEventListener('click', () => loadPreset(btn.dataset.preset));
  });

  // Initial calculation
  recalc();
}

if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', initSubjectGradeCalc);
} else {
  initSubjectGradeCalc();
}
</script>