---
const year = new Date().getFullYear();
const calculators = [
  { label: 'CGPA to Percentage', href: '/' },
  { label: 'Percentage to CGPA', href: '/percentage-to-cgpa' },
  { label: 'CGPA to GPA (4.0)', href: '/cgpa-to-gpa' },
  { label: 'SGPA to CGPA', href: '/sgpa-to-cgpa' },
  { label: 'SGPA to Percentage', href: '/sgpa-to-percentage' },
  { label: 'Marks to CGPA', href: '/marks-to-cgpa' },
  { label: 'Conversion Chart', href: '/cgpa-to-percentage-chart' },
];
const universityLinks = [
  { label: 'SPPU Calculator', href: '/sppu-cgpa-to-percentage' },
  { label: 'VTU Calculator', href: '/vtu-cgpa-to-percentage' },
  { label: 'Mumbai University', href: '/mumbai-university-cgpa-to-percentage' },
  { label: 'Anna University', href: '/anna-university-cgpa-to-percentage' },
  { label: 'AKTU / UPTU', href: '/aktu-cgpa-to-percentage' },
  { label: 'GTU Calculator', href: '/gtu-cgpa-to-percentage' },
  { label: 'KTU Calculator', href: '/ktu-cgpa-to-percentage' },
  { label: 'DU (Delhi University)', href: '/du-cgpa-to-percentage' },
];
const popularLinks = [
  { label: '10 CGPA to Percentage', href: '/10-cgpa-to-percentage' },
  { label: '9.5 CGPA to Percentage', href: '/9.5-cgpa-to-percentage' },
  { label: '9 CGPA to Percentage', href: '/9-cgpa-to-percentage' },
  { label: '8.5 CGPA to Percentage', href: '/8.5-cgpa-to-percentage' },
  { label: '8 CGPA to Percentage', href: '/8-cgpa-to-percentage' },
  { label: '7.5 CGPA to Percentage', href: '/7.5-cgpa-to-percentage' },
  { label: 'Engineering Conversion', href: '/cgpa-to-percentage-for-engineering' },
  { label: 'हिंदी में कैलकुलेटर', href: '/cgpa-to-percentage-in-hindi' },
];
const learn = [
  { label: 'All Guides', href: '/guides' },
  { label: 'CGPA for Placements', href: '/guides/cgpa-good-for-placements' },
  { label: 'CGPA to GPA for MS Abroad', href: '/guides/cgpa-to-gpa-4-scale-ms-abroad' },
  { label: 'Conversion Certificate', href: '/guides/cgpa-to-percentage-certificate' },
];
const company = [
  { label: 'About Us', href: '/about' },
  { label: 'Contact Us', href: '/contact' },
  { label: 'Privacy Policy', href: '/privacy-policy' },
  { label: 'Terms & Conditions', href: '/terms' },
];
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <a href="/" class="footer-logo" aria-label="GlobalCGPA Home">
        <svg width="24" height="24" viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <rect width="64" height="64" rx="12" fill="#10B981"/>
          <text x="32" y="46" text-anchor="middle" font-family="system-ui,sans-serif" font-size="44" font-weight="700" fill="#ffffff">%</text>
        </svg>
        <span>GlobalCGPA</span>
      </a>
      <p class="footer-tagline">Free CGPA to percentage calculator for Indian university students. Supports SPPU, VTU, Mumbai University, Anna University, AKTU, GTU, KTU and more.</p>
      <p class="footer-domain">globalcgpa.in</p>
    </div>

    <div class="footer-col">
      <div class="footer-col-title">Calculators</div>
      <ul class="footer-links">
        {calculators.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </div>

    <div class="footer-col">
      <div class="footer-col-title">Universities</div>
      <ul class="footer-links">
        {universityLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </div>

    <div class="footer-col">
      <div class="footer-col-title">Popular Conversions</div>
      <ul class="footer-links">
        {popularLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </div>

    <div class="footer-col">
      <div class="footer-col-title">Learn</div>
      <ul class="footer-links">
        {learn.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </div>

    <div class="footer-col">
      <div class="footer-col-title">Company</div>
      <ul class="footer-links">
        {company.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </div>
  </div>

  <div class="footer-bottom">
    <span class="footer-copy">© {year} GlobalCGPA. All rights reserved. Results are approximate — verify with your university.</span>
    <div class="footer-bottom-links">
      <a href="/privacy-policy">Privacy</a>
      <a href="/terms">Terms</a>
      <a href="/contact">Contact</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--bg-card);
    border-top: 1px solid var(--border);
    padding: 56px 24px 0;
    margin-top: 24px;
  }

  .footer-inner {
    max-width: 1160px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.3fr 1fr 1fr 1fr 1fr 0.9fr;
    gap: 28px;
    padding-bottom: 44px;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    color: var(--text-ink);
    font-size: 15px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .footer-tagline {
    font-size: 13px;
    color: var(--text-mute);
    line-height: 1.65;
    max-width: 260px;
    margin: 0;
  }

  .footer-domain {
    font-size: 11px;
    color: var(--text-mute);
    margin: 0;
  }

  .footer-col-title {
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-mute);
    margin-bottom: 14px;
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 9px;
  }

  .footer-links a {
    font-size: 13px;
    color: var(--text-body);
    text-decoration: none;
    transition: color 0.15s;
  }

  .footer-links a:hover {
    color: var(--primary);
  }

  .footer-bottom {
    max-width: 1160px;
    margin: 0 auto;
    padding: 18px 0 22px;
    border-top: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
  }

  .footer-copy {
    font-size: 12px;
    color: var(--text-mute);
  }

  .footer-bottom-links {
    display: flex;
    gap: 18px;
  }

  .footer-bottom-links a {
    font-size: 12px;
    color: var(--text-mute);
    text-decoration: none;
  }

  .footer-bottom-links a:hover {
    color: var(--primary);
  }

  @media (max-width: 980px) {
    .footer-inner {
      grid-template-columns: 1fr 1fr 1fr;
    }
    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 560px) {
    .footer-inner {
      grid-template-columns: 1fr 1fr;
      gap: 28px;
    }
    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
