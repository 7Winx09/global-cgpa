---
import type { University } from '../data/universities';
const { uni } = Astro.props;
const rows = [10, 9.5, 9, 8.5, 8, 7.5, 7, 6.5, 6, 5.5, 5, 4.5, 4];

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  'itemListElement': rows.map((cgpa, index) => ({
    '@type': 'ListItem',
    'position': index + 1,
    'item': {
      '@type': 'StructuredValue',
      'name': `${cgpa.toFixed(1)} CGPA`,
      'value': `${Math.min(100, Math.max(0, uni.forward(cgpa))).toFixed(1)}%`
    }
  }))
};
---

<div class="table-scroll">
  <table class="conv-table">
    <thead>
      <tr>
        <th>CGPA</th>
        <th>Percentage ({uni.formulaLabel})</th>
      </tr>
    </thead>
    <tbody>
      {rows.map((c) => (
        <tr>
          <td>{c.toFixed(1)}</td>
          <td>{Math.min(100, Math.max(0, uni.forward(c))).toFixed(1)}%</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />

<style>
  .conv-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.88rem;
  }
  .conv-table thead th {
    background: var(--bg-soft);
    padding: 10px 14px;
    text-align: left;
    font-size: 0.74rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--text-mute);
  }
  .conv-table tbody td {
    padding: 9px 14px;
    color: var(--text-body);
    border-top: 1px solid var(--border);
  }
  .conv-table tbody td:first-child {
    font-weight: 700;
    color: var(--primary);
  }
</style>
