---
// LeadCapture.astro — Email capture for university shortlist lead magnet
---

<div class="lead-capture" id="lead-capture">
  <div class="lead-capture-inner">
    <div class="lead-content">
      <div class="lead-icon" aria-hidden="true">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="3" width="20" height="14" rx="2"></rect>
          <path d="M22 7H2"></path>
          <path d="M22 17H2"></path>
        </svg>
      </div>
      <h3>Get Your Personalised University Shortlist</h3>
      <p>Enter your CGPA and target country — we'll match you with universities you can actually get into. Free, no spam, delivered on WhatsApp within 24 hours.</p>
    </div>
    <form class="lead-form" id="lead-form" action="/api/lead" method="POST">
      <div class="lead-form-row">
        <input type="email" name="email" placeholder="your@email.com" required aria-label="Email address" autocomplete="email">
        <select name="country" required aria-label="Target country">
          <option value="">Select target country</option>
          <option value="usa">USA</option>
          <option value="uk">UK</option>
          <option value="germany">Germany</option>
          <option value="canada">Canada</option>
          <option value="australia">Australia</option>
          <option value="ireland">Ireland</option>
          <option value="new-zealand">New Zealand</option>
          <option value="other">Other</option>
        </select>
      </div>
      <div class="lead-form-row">
        <input type="number" name="cgpa" step="0.01" min="0" max="10" placeholder="Your CGPA (e.g. 7.5)" required aria-label="Your CGPA">
        <button type="submit" class="lead-submit">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
          </svg>
          Get Shortlist Free
        </button>
      </div>
      <p class="lead-disclaimer">Free · No spam · 50,000+ students helped · Reply within 24 hrs on WhatsApp</p>
    </form>
    <div class="lead-success" id="lead-success" style="display:none;">
      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#00c853" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
        <polyline points="22 4 12 14.01 9 11.01"></polyline>
      </svg>
      <h4>Check your WhatsApp!</h4>
      <p>We've sent your personalised university shortlist. A counsellor will follow up within 24 hours.</p>
    </div>
  </div>
</div>

<style>
  .lead-capture {
    background: linear-gradient(135deg, var(--card) 0%, var(--bg) 100%);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 32px;
    margin: 40px 20px 0;
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
    position: relative;
    overflow: hidden;
  }
  .lead-capture::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 4px;
    background: linear-gradient(90deg, var(--primary), #00c853, var(--primary));
  }
  .lead-capture-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    align-items: start;
  }
  .lead-content { padding-top: 8px; }
  .lead-icon {
    width: 48px; height: 48px;
    background: rgba(16, 185, 129, 0.12);
    border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    color: var(--primary);
    margin-bottom: 16px;
  }
  .lead-content h3 {
    font-size: 1.25rem; font-weight: 700; color: var(--text);
    margin: 0 0 8px; line-height: 1.3;
  }
  .lead-content p {
    font-size: 0.9rem; color: var(--muted); line-height: 1.6; margin: 0;
  }
  .lead-form { display: flex; flex-direction: column; gap: 12px; }
  .lead-form-row { display: flex; gap: 10px; flex-wrap: wrap; }
  .lead-form-row input,
  .lead-form-row select {
    flex: 1; min-width: 140px;
    padding: 12px 16px;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 10px;
    color: var(--text);
    font-family: inherit;
    font-size: 0.9rem;
    transition: border-color 0.15s;
  }
  .lead-form-row input:focus,
  .lead-form-row select:focus {
    outline: none; border-color: var(--primary);
  }
  .lead-submit {
    flex: 1; min-width: 140px;
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    padding: 12px 20px;
    background: var(--primary);
    color: #fff;
    border: none;
    border-radius: 10px;
    font-family: inherit;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s;
  }
  .lead-submit:hover { opacity: 0.9; transform: translateY(-1px); }
  .lead-disclaimer {
    font-size: 0.7rem; color: var(--muted); text-align: center; margin: 4px 0 0;
    font-family: 'JetBrains Mono', monospace;
  }
  .lead-success { text-align: center; padding: 20px; }
  .lead-success h4 { font-size: 1.1rem; font-weight: 700; color: var(--text); margin: 12px 0 6px; }
  .lead-success p { font-size: 0.9rem; color: var(--muted); margin: 0; }

  @media (max-width: 640px) {
    .lead-capture { padding: 24px 16px; margin: 24px 12px 0; }
    .lead-capture-inner { grid-template-columns: 1fr; gap: 20px; text-align: center; }
    .lead-icon { margin: 0 auto 12px; }
    .lead-form-row { flex-direction: column; }
    .lead-form-row input,
    .lead-form-row select,
    .lead-submit { width: 100%; }
  }
</style>

<script is:inline>
  document.getElementById('lead-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target;
    const data = new FormData(form);
    const btn = form.querySelector('button[type="submit"]');
    const original = btn.innerHTML;
    
    btn.disabled = true;
    btn.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="spin"><circle cx="12" cy="12" r="10" stroke-opacity="0.25"></circle><path d="M12 2a10 10 0 0 1 10 10" stroke-opacity="1"></path></svg> Sending...';
    btn.style.animation = 'spin 1s linear infinite';
    
    try {
      const res = await fetch('/api/lead', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(Object.fromEntries(data))
      });
      if (res.ok) {
        form.style.display = 'none';
        document.getElementById('lead-success').style.display = 'block';
      } else {
        throw new Error('Failed');
      }
    } catch {
      btn.innerHTML = original;
      btn.disabled = false;
      alert('Something went wrong. Please try again or contact us directly.');
    }
  });
  
  // Add spin animation
  const style = document.createElement('style');
  style.textContent = '@keyframes spin { to { transform: rotate(360deg); } } .spin { animation: spin 1s linear infinite; }';
  document.head.appendChild(style);
</script>