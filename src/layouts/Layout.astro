---
interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  schema?: Record<string, unknown>;
  lang?: string;
  alternates?: { hreflang: string; href: string }[];
  noIndex?: boolean;
  noFollow?: boolean;
}

const {
  title = 'CGPA to Percentage Calculator | Fast Reference Converter',
  description = 'Free CGPA to percentage calculator. Convert CGPA, SGPA & GPA instantly using university-specific formulas for SPPU, VTU, Mumbai University, Anna University & more. Calculate percentage from CGPA online quickly using verified institutional multipliers.',
  canonical = 'https://globalcgpa.in',
  ogImage = '/og-image.png',
  schema,
  lang = 'en',
  alternates,
  noIndex = false,
  noFollow = false,
} = Astro.props;

import '../styles/global.css';
import CookieConsent from '../components/CookieConsent.astro';

const defaultSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "GlobalCGPA — CGPA to Percentage Calculator",
  "url": "https://globalcgpa.in",
  "description": "Free online CGPA to percentage calculator supporting SPPU, VTU, Mumbai University, Anna University and more. Calculate percentage from CGPA online quickly using verified institutional multipliers.",
  "applicationCategory": "EducationalApplication",
  "operatingSystem": "Any",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "INR" },
  "inLanguage": "en-IN",
  "isAccessibleForFree": true
};

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "GlobalCGPA",
  "url": "https://globalcgpa.in",
  "logo": "https://globalcgpa.in/og-image.png",
  "description": "Free CGPA to percentage calculator for Indian university students. Supports SPPU, VTU, Mumbai University, Anna University, AKTU, GTU, KTU and more. Formulas cross-referenced and verified against published university academic ordinances.",
  "contactPoint": {
    "@type": "ContactPoint",
    "telephone": "",
    "contactType": "customer support",
    "availableLanguage": ["English", "Hindi"],
    "email": "support@globalcgpa.in"
  },
  "sameAs": []
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "GlobalCGPA",
  "url": "https://globalcgpa.in",
  "description": "Free CGPA to percentage calculator for Indian university students. Academic Reference Hub for grade conversion.",
  "publisher": {
    "@type": "Organization",
    "name": "GlobalCGPA"
  },
  "inLanguage": "en-IN"
};

const structuredData = JSON.stringify(schema ?? defaultSchema);
const structuredDataOrg = JSON.stringify(organizationSchema);
const structuredDataWebsite = JSON.stringify(websiteSchema);
const ogLocale = lang === 'hi' ? 'hi_IN' : 'en_IN';

const canonicalUrl = canonical.startsWith('http') ? canonical : `https://globalcgpa.in${canonical}`;
const fullOgImage = ogImage.startsWith('http') ? ogImage : `https://globalcgpa.in${ogImage}`;

// Auto-generate hreflang alternates for all supported locales
const supportedLocales = ['en', 'hi', 'ar', 'vn', 'de', 'es', 'fr', 'pt', 'tr', 'id', 'ko', 'ja'];
const basePath = canonicalUrl.replace('https://globalcgpa.in', '');
const allAlternates = [
  { hreflang: 'x-default', href: 'https://globalcgpa.in/' },
  ...supportedLocales.map(l => ({ hreflang: l, href: `https://globalcgpa.in/${l}${basePath === '/' ? '' : basePath}` })),
  ...(alternates || [])
];

const pageKeywords = 'cgpa to percentage, cgpa to percentage calculator, cgpa calculator, gpa calculator, sgpa to cgpa, percentage converter, sppu cgpa, vtu cgpa, anna university cgpa, mumbai university cgpa, aktu cgpa, gtu cgpa, ktu cgpa, du cgpa, cgpa to gpa 4.0, percentage to cgpa, marks to cgpa, sgpa to percentage, cgpa conversion chart, cbse cgpa to percentage, engineering cgpa calculator, university cgpa calculator, cgpa equivalence certificate, cgpa full form, cgpa meaning, how to convert cgpa to percentage, cgpa grade conversion, sgpa cgpa difference, first class cgpa, distinction cgpa, pass cgpa, gpa 計算方法, gpa 計算, gpa計算, gpa計算方法, gpa 計算方法 5段階, gpa計算サイト, gpa 計算 4段階, 日本 gpa 計算, 日本の大学 gpa 計算';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content={noIndex ? (noFollow ? 'noindex, nofollow' : 'noindex, follow') : 'index, follow'} />

    <!-- Theme Initialization (Anti-FOUC) -->
    <script is:inline>
      (function() {
        const saved = localStorage.getItem('gcgpa-theme') || localStorage.getItem('theme');
        const theme = saved || 'dark';
        if (theme === 'light') {
          document.documentElement.classList.add('light-theme');
          document.documentElement.classList.remove('dark');
          document.documentElement.setAttribute('data-theme', 'light');
        } else {
          document.documentElement.classList.remove('light-theme');
          document.documentElement.classList.add('dark');
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      })();
    </script>

    <!-- Primary Meta -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {allAlternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <meta name="keywords" content={pageKeywords} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullOgImage} />
    <meta property="og:site_name" content="GlobalCGPA" />
    <meta property="og:locale" content={ogLocale} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullOgImage} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />

    <!-- Sitemap -->
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={structuredData} />
    <script type="application/ld+json" set:html={structuredDataOrg} />
    <script type="application/ld+json" set:html={structuredDataWebsite} />
  </head>
  <body>
    <slot />
    <CookieConsent />
  </body>
</html>
