---
interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  schema?: Record<string, unknown>;
  lang?: string;
  alternates?: { hreflang: string; href: string }[];
}

const {
  title = 'CGPA to Percentage Calculator | GlobalCGPA',
  description = 'Free CGPA to percentage calculator. Convert CGPA, SGPA & GPA instantly using university-specific formulas for SPPU, VTU, Mumbai University, Anna University & more.',
  canonical = 'https://globalcgpa.in',
  ogImage = '/og-image.png',
  schema,
  lang = 'en',
  alternates,
} = Astro.props;

import '../styles/global.css';

const defaultSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "GlobalCGPA — CGPA to Percentage Calculator",
  "url": "https://globalcgpa.in",
  "description": "Free online CGPA to percentage calculator supporting SPPU, VTU, Mumbai University, Anna University and more.",
  "applicationCategory": "EducationalApplication",
  "operatingSystem": "Any",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "INR" },
  "inLanguage": "en-IN",
  "isAccessibleForFree": true
};

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "GlobalCGPA",
  "url": "https://globalcgpa.in",
  "logo": "https://globalcgpa.in/og-image.png",
  "description": "Free CGPA to percentage calculator for Indian university students. Supports SPPU, VTU, Mumbai University, Anna University, AKTU, GTU, KTU and more with official formulas.",
  "contactPoint": {
    "@type": "ContactPoint",
    "telephone": "",
    "contactType": "customer support",
    "availableLanguage": ["English", "Hindi"],
    "email": "support@globalcgpa.in"
  },
  "sameAs": []
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "GlobalCGPA",
  "url": "https://globalcgpa.in",
  "description": "Free CGPA to percentage calculator for Indian university students.",
  "publisher": {
    "@type": "Organization",
    "name": "GlobalCGPA"
  },
  "inLanguage": "en-IN"
};

const structuredData = JSON.stringify(schema ?? defaultSchema);
const structuredDataOrg = JSON.stringify(organizationSchema);
const structuredDataWebsite = JSON.stringify(websiteSchema);
const ogLocale = lang === 'hi' ? 'hi_IN' : 'en_IN';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="index, follow" />

    <!-- Theme Initialization (Anti-FOUC) -->
    <script is:inline>
      (function() {
        const saved = localStorage.getItem('gcgpa-theme') || localStorage.getItem('theme');
        const theme = saved || 'dark';
        if (theme === 'light') {
          document.documentElement.classList.add('light-theme');
          document.documentElement.classList.remove('dark');
          document.documentElement.setAttribute('data-theme', 'light');
        } else {
          document.documentElement.classList.remove('light-theme');
          document.documentElement.classList.add('dark');
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      })();
    </script>

    <!-- Primary Meta -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates?.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <meta name="keywords" content="cgpa to percentage, cgpa to percentage calculator, cgpa calculator, gpa calculator, sgpa to cgpa, percentage converter, sppu cgpa, vtu cgpa, anna university cgpa" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage.startsWith('http') ? ogImage : `https://globalcgpa.in${ogImage}`} />
    <meta property="og:site_name" content="GlobalCGPA" />
    <meta property="og:locale" content={ogLocale} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.startsWith('http') ? ogImage : `https://globalcgpa.in${ogImage}`} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />

    <!-- Sitemap -->
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={structuredData} />
    <script type="application/ld+json" set:html={structuredDataOrg} />
    <script type="application/ld+json" set:html={structuredDataWebsite} />

    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-5TB706E56P"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-5TB706E56P');
    </script>

    <!-- AdSense -->
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-1016421061571791" crossorigin="anonymous"></script>
    <style is:global>
      body {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }
      main {
        flex: 1;
        width: 100%;
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
