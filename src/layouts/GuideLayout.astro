---
import Layout from './Layout.astro';
import SiteHeader from '../components/Nav.astro';
import SiteFooter from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tag: string;
  slug: string;
}

const { title, description, pubDate, updatedDate, tag, slug } = Astro.props;

const fmt = (d: Date) => d.toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' });

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  'headline': title,
  'description': description,
  'url': `https://globalcgpa.in/guides/${slug}`,
  'datePublished': pubDate.toISOString(),
  ...(updatedDate ? { 'dateModified': updatedDate.toISOString() } : {}),
  'author': { '@type': 'Organization', 'name': 'GlobalCGPA', 'url': 'https://globalcgpa.in' },
  'publisher': { '@type': 'Organization', 'name': 'GlobalCGPA', 'url': 'https://globalcgpa.in' },
  'inLanguage': 'en-IN',
  'isAccessibleForFree': true,
};
---

<Layout title={`${title} | GlobalCGPA`} description={description} canonical={`https://globalcgpa.in/guides/${slug}`} schema={schema}>
  <SiteHeader />

  <main style="flex:1;">
    <article class="guide-page">
      <div class="prose" style="padding-top:36px;">
        <Breadcrumbs items={[{ label: 'Guides', href: '/guides' }, { label: title }]} />
        <div class="guide-meta-row">
          <span class="guide-tag">{tag}</span>
          <span class="guide-date">Published {fmt(pubDate)}{updatedDate ? ` · Updated ${fmt(updatedDate)}` : ''}</span>
        </div>
        <h1 class="guide-h1">{title}</h1>
      </div>

      <div class="prose guide-body">
        <slot />
      </div>

      <aside class="guide-cta">
        <div class="guide-cta-inner">
          <div>
            <div class="guide-cta-title">Need the number right now?</div>
            <p class="guide-cta-sub">Convert your CGPA, SGPA, marks or percentage with our free calculators — no signup, works offline.</p>
          </div>
          <a href="/" class="guide-cta-btn">Open Calculator</a>
        </div>
      </aside>
    </article>
  </main>

  <SiteFooter />
</Layout>

<style>
  .guide-page {
    min-height: 60vh;
    padding-bottom: 40px;
  }
  .guide-meta-row {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 4px 0 10px;
    flex-wrap: wrap;
  }
  .guide-tag {
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.2px;
    color: var(--primary);
    background: color-mix(in srgb, var(--primary) 12%, transparent);
    padding: 3px 10px;
    border-radius: 999px;
  }
  .guide-date {
    font-size: 0.76rem;
    color: var(--text-mute);
  }
  .guide-h1 {
    font-size: clamp(1.7rem, 4.5vw, 2.3rem);
    font-weight: 900;
    letter-spacing: -0.8px;
    line-height: 1.22;
    color: var(--text-ink);
    margin-bottom: 6px;
  }
  .guide-body {
    padding-top: 8px;
  }
  .guide-cta {
    max-width: 760px;
    margin: 24px auto 0;
    padding: 0 20px;
  }
  .guide-cta-inner {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 22px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    flex-wrap: wrap;
  }
  .guide-cta-title {
    font-weight: 800;
    font-size: 1rem;
    color: var(--text-ink);
    margin-bottom: 4px;
  }
  .guide-cta-sub {
    font-size: 0.84rem;
    color: var(--text-mute);
    margin: 0;
    max-width: 420px;
  }
  .guide-cta-btn {
    background: var(--primary);
    color: #fff;
    font-weight: 700;
    font-size: 0.88rem;
    padding: 11px 20px;
    border-radius: 12px;
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.2s;
  }
  .guide-cta-btn:hover { background: var(--primary-dark); }
</style>
