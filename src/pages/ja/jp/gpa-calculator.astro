---
import Layout from '@/layouts/Layout.astro';
import SiteHeader from '../../../components/Nav.astro';
import SiteFooter from '../../../components/Footer.astro';

const canonical = 'https://globalcgpa.in/ja/jp/gpa-calculator/';
---

<Layout
  title="GPA 計算 | 日本の大学対応 GPA 計算サイト | GlobalCGPA"
  description="日本の大学の GPA 計算に対応した無料計算ツール。4段階・5段階評価、累積 GPA、単位加重平均に対応。公式換算式の解説と FAQ も掲載。"
  canonical={canonical}
  alternates={[
    { hreflang: 'ja', href: 'https://globalcgpa.in/ja/jp/gpa-calculator/' },
    { hreflang: 'en', href: 'https://globalcgpa.in/cgpa-to-gpa/' },
    { hreflang: 'x-default', href: 'https://globalcgpa.in/cgpa-to-gpa/' },
  ]}
  noIndex={true}
  schema={{
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "GlobalCGPA 日本版 — GPA 計算機",
    "url": canonical,
    "description": "日本の大学の GPA 計算に対応。4段階（4.0/4.3/4.5）・5段階評価、累積 GPA、単位加重平均を計算。",
    "applicationCategory": "EducationalApplication",
    "operatingSystem": "Any",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "JPY" },
    "inLanguage": "ja-JP",
    "isAccessibleForFree": true
  }}
>
  <SiteHeader />

  <main class="hero-main">
    <div class="hero-tag">日本の大学対応</div>
    <h1>GPA 計算 — 日本の大学対応計算機</h1>
    <p class="subtitle">4段階評価（4.0 / 4.3 / 4.5）・5段階評価・累積 GPA・単位加重平均に対応。あなたの大学の評価方式を選んで正確な GPA を算出。公式換算式の解説とよくある質問も掲載。</p>

    <div class="main-calc-card">
      <label for="jp_calc_mode">計算モードを選択</label>
      <select id="jp_calc_mode" onchange="switchJpMode()">
        <option value="grades2gpa">成績・単位 → GPA（累積 GPA 計算）</option>
        <option value="percentage2gpa">パーセンテージ → GPA（海外出願用）</option>
        <option value="gpa2percentage">GPA → パーセンテージ（目安）</option>
      </select>

      <div id="jp_mode_grades" style="display:block;">
        <label for="jp_scale">評価スケール</label>
        <select id="jp_scale" onchange="updateJpGradeOptions()">
          <option value="4.0">4.0 段階（A=4, B=3, C=2, D=1, F=0）</option>
          <option value="4.3">4.3 段階（A+=4.3, A=4.0, A-=3.7...）</option>
          <option value="4.5">4.5 段階（A=4.5, B=3.5, C=2.5, D=1.5, F=0）</option>
          <option value="5.0">5 段階（S/A/B/C/D または 5/4/3/2/1）</option>
        </select>

        <div id="jp_subjects_container">
          <div class="jp-subject-row">
            <select class="jp-grade-select" onchange="calcJpGpa()"></select>
            <input type="number" class="jp-credit-input" min="0" step="0.5" placeholder="単位" onchange="calcJpGpa()">
            <button type="button" class="jp-remove-btn" onclick="removeJpRow(this)">削除</button>
          </div>
        </div>
        <button type="button" class="jp-add-btn" onclick="addJpSubjectRow()">科目を追加</button>

        <div class="output-display">
          <button class="copy-btn" onclick="copyJpGpa()" title="コピー">⎘</button>
          <div class="out-val" id="jp_gpa_result">—</div>
          <div class="out-lbl">累積 GPA</div>
        </div>
      </div>

      <div id="jp_mode_pct" style="display:none;">
        <label for="jp_pct_input">パーセンテージ（0-100）</label>
        <input type="number" id="jp_pct_input" min="0" max="100" step="0.1" placeholder="例: 85.5" oninput="calcJpPctToGpa()">
        <label for="jp_pct_scale">換算先スケール</label>
        <select id="jp_pct_scale" onchange="calcJpPctToGpa()">
          <option value="4.0">4.0 段階</option>
          <option value="4.3">4.3 段階</option>
          <option value="4.5">4.5 段階</option>
        </select>
        <div class="output-display">
          <button class="copy-btn" onclick="copyJpPctGpa()" title="コピー">⎘</button>
          <div class="out-val" id="jp_pct_gpa_result">—</div>
          <div class="out-lbl">換算 GPA</div>
        </div>
      </div>

      <div id="jp_mode_gpa2pct" style="display:none;">
        <label for="jp_gpa_input">GPA 値</label>
        <input type="number" id="jp_gpa_input" min="0" step="0.01" placeholder="例: 3.52" oninput="calcJpGpaToPct()">
        <label for="jp_gpa_scale">元のスケール</label>
        <select id="jp_gpa_scale" onchange="calcJpGpaToPct()">
          <option value="4.0">4.0 段階</option>
          <option value="4.3">4.3 段階</option>
          <option value="4.5">4.5 段階</option>
        </select>
        <div class="output-display">
          <button class="copy-btn" onclick="copyJpGpaPct()" title="コピー">⎘</button>
          <div class="out-val" id="jp_gpa_pct_result">—</div>
          <div class="out-lbl">パーセンテージ（目安）</div>
        </div>
      </div>
    </div>
  </main>

  <section class="bottom-belt-section">
    <div class="belt-title">関連計算機</div>
    <div class="belt-grid">
      <a class="belt-card" href="/ja/jp/percentage-to-gpa/">🔁 パーセンテージ → GPA</a>
      <a class="belt-card" href="/ja/jp/cumulative-gpa/">📈 累積 GPA 計算</a>
      <a class="belt-card" href="/ja/jp/university-gpa/">🏫 大学別 GPA 計算</a>
      <a class="belt-card" href="/ja/jp/guides/">📚 解説ガイド</a>
    </div>
  </section>

  <article class="seo-article" itemscope itemtype="https://schema.org/Article">
    <hr class="seo-divider">

    <h2 itemprop="headline">日本の大学における GPA 計算の基本</h2>

    <h2>GPA とは</h2>
    <p>GPA（Grade Point Average）は、履修科目の成績を単位数で加重平均した指標です。日本の大学では主に <strong>4 段階評価（4.0 / 4.3 / 4.5）</strong> または <strong>5 段階評価</strong> が採用されています。海外大学院出願（留学）では 4.0 スケールへの換算が求められることが多いため、自身の大学の評価方式を理解し、正しく換算することが重要です。</p>

    <h2>主な評価スケールの違い</h2>
    <div class="seo-table-wrap">
      <table class="seo-table">
        <thead>
          <tr><th>スケール</th><th>最高点</th><th>主な採用大学例</th><th>備考</th></tr>
        </thead>
        <tbody>
          <tr><td>4.0 段階</td><td>4.0</td><td>多くの国公立・私立大</td><td>最も一般的。A=4, B=3, C=2, D=1, F=0</td></tr>
          <tr><td>4.3 段階</td><td>4.3</td><td>早稲田大、慶應義塾大 等</td><td>A+=4.3, A=4.0, A-=3.7 等の細分化</td></tr>
          <tr><td>4.5 段階</td><td>4.5</td><td>東京工業大、一橋大 等</td><td>A=4.5, B=3.5, C=2.5, D=1.5, F=0</td></tr>
          <tr><td>5 段階</td><td>5.0 / 100点</td><td>一部の大学・高校</td><td>S/A/B/C/D または 5/4/3/2/1</td></tr>
        </tbody>
      </table>
    </div>

    <h3>累積 GPA の計算式（単位加重平均）</h3>
    <div class="seo-formula-block">
      <div class="formula-label">標準式</div>
      <div class="formula-text">累積 GPA = Σ（科目グレードポイント × 単位数） ÷ Σ（単位数）</div>
      <div class="formula-example">例：3単位 A(4.0) + 2単位 B(3.0) = (12+6)÷5 = 3.6</div>
    </div>

    <h2>GPA 計算方法 — ステップバイステップ</h2>
    <ol>
      <li>履修した全科目の「成績（グレード）」と「単位数」を用意する</li>
      <li>自分の大学の評価スケール（4.0 / 4.3 / 4.5 / 5段階）を確認する</li>
      <li>各成績を対応するグレードポイントに変換する</li>
      <li>「グレードポイント × 単位数」を科目ごとに計算し合計する</li>
      <li>総単位数で割って累積 GPA を出す</li>
      <li>海外出願用に 4.0 スケールへ換算が必要な場合は換算式を適用する</li>
    </ol>

    <h2>4.0 スケールへの換算（留学・海外大学院出願用）</h2>
    <p>多くの海外大学は 4.0 スケールを基準に評価します。日本の大学が 4.3 または 4.5 スケールの場合、以下の線形換算が一般的な目安として用いられますが、<strong>出願先大学の指定方式を最優先</strong>してください。</p>
    <div class="seo-formula-block">
      <div class="formula-label">線形換算の目安</div>
      <div class="formula-text">4.0スケール GPA = （元の GPA ÷ 元の最高点）× 4.0</div>
      <div class="formula-example">例：4.3スケールで 3.80 → (3.80 ÷ 4.3) × 4.0 ≒ 3.53</div>
    </div>

    <h2>よくある質問（FAQ）</h2>

    <div class="faq-section" itemscope itemtype="https://schema.org/FAQPage">
      <div class="faq-group-label">計算方法</div>

      <div class="faq-item" itemscope itemprop="mainEntity" itemtype="https://schema.org/Question">
        <button class="faq-q" onclick="toggleFaq(this)" itemprop="name">GPA の計算方法を教えてください<span class="faq-icon">+</span></button>
        <div class="faq-a" itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer"><div itemprop="text">各科目のグレードポイント（A=4.0 等）に単位数を掛け、全科目の合計を総単位数で割ります。このページの計算機に成績と単位を入力すると自動計算されます。</div></div>
      </div>

      <div class="faq-item" itemscope itemprop="mainEntity" itemtype="https://schema.org/Question">
        <button class="faq-q" onclick="toggleFaq(this)" itemprop="name">4段階と5段階の違いは何ですか<span class="faq-icon">+</span></button>
        <div class="faq-a" itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer"><div itemprop="text">4段階は最高点が 4.0（または 4.3/4.5）で、主に大学で使われます。5段階は最高点が 5.0 または 100 点満点で、一部の大学や高校で採用されています。計算機でスケールを切り替えてご利用ください。</div></div>
      </div>

      <div class="faq-item" itemscope itemprop="mainEntity" itemtype="https://schema.org/Question">
        <button class="faq-q" onclick="toggleFaq(this)" itemprop="name">累積 GPA と学期 GPA の違いは<span class="faq-icon">+</span></button>
        <div class="faq-a" itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer"><div itemprop="text">学期 GPA（学期成績平均）はその学期のみの平均、累積 GPA（通算 GPA）は入学から現在までの全履修科目を対象とした加重平均です。卒業要件や留学出願では累積 GPA が見られます。</div></div>
      </div>

      <div class="faq-group-label">換算・留学</div>

      <div class="faq-item" itemscope itemprop="mainEntity" itemtype="https://schema.org/Question">
        <button class="faq-q" onclick="toggleFaq(this)" itemprop="name">4.3 / 4.5 スケールを 4.0 に換算する方法は<span class="faq-icon">+</span></button>
        <div class="faq-a" itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer"><div itemprop="text">一般的な目安は「元の GPA ÷ 元の最高点 × 4.0」ですが、出願先大学が独自の換算表を持つ場合があります。必ず募集要項を確認し、指定方式に従ってください。WES 等の資格評価機関を通す場合はその機関のルールが適用されます。</div></div>
      </div>

      <div class="faq-item" itemscope itemprop="mainEntity" itemtype="https://schema.org/Question">
        <button class="faq-q" onclick="toggleFaq(this)" itemprop="name">パーセンテージから GPA を出せますか<span class="faq-icon">+</span></button>
        <div class="faq-a" itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer"><div itemprop="text">はい。「パーセンテージ → GPA」モードで概算できます。ただし大学によって成績区分（A/B/C 等）の境界点が異なるため、正確な GPA には成績表のグレードが必要です。</div></div>
      </div>

      <div class="faq-group-label">大学別</div>

      <div class="faq-item" itemscope itemprop="mainEntity" itemtype="https://schema.org/Question">
        <button class="faq-q" onclick="toggleFaq(this)" itemprop="name">東京大学の GPA 計算方法は<span class="faq-icon">+</span></button>
        <div class="faq-a" itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer"><div itemprop="text">東京大学は 4.0 段階評価（A+=4.0, A=3.5, B=3.0, C=2.0, D=1.0, F=0）を採用しています。詳細な換算式や履修取消の扱いは学部・学科により異なる場合があるため、所属学部の履修要項をご確認ください。</div></div>
      </div>

      <div class="faq-item" itemscope itemprop="mainEntity" itemtype="https://schema.org/Question">
        <button class="faq-q" onclick="toggleFaq(this)" itemprop="name">早稲田・慶應の GPA は 4.3 ですか<span class="faq-icon">+</span></button>
        <div class="faq-a" itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer"><div itemprop="text">早稲田大学と慶應義塾大学は 4.3 段階評価を採用しています（A+=4.3, A=4.0, A-=3.7...）。学部によって運用が異なる場合があるため、所属学部の規定を確認してください。</div></div>
      </div>
    </div>
  </article>

  <SiteFooter />

  <script is:inline>
  // 日本版 GPA 計算機ロジック
  const jpGradeMaps = {
    '4.0': { 'A+': 4.0, 'A': 4.0, 'A-': 3.7, 'B+': 3.3, 'B': 3.0, 'B-': 2.7, 'C+': 2.3, 'C': 2.0, 'C-': 1.7, 'D': 1.0, 'F': 0 },
    '4.3': { 'A+': 4.3, 'A': 4.0, 'A-': 3.7, 'B+': 3.3, 'B': 3.0, 'B-': 2.7, 'C+': 2.3, 'C': 2.0, 'C-': 1.7, 'D': 1.0, 'F': 0 },
    '4.5': { 'A+': 4.5, 'A': 4.5, 'A-': 4.0, 'B+': 3.5, 'B': 3.5, 'B-': 3.0, 'C+': 2.5, 'C': 2.5, 'C-': 2.0, 'D': 1.5, 'F': 0 },
    '5.0': { 'S': 5.0, 'A': 4.0, 'B': 3.0, 'C': 2.0, 'D': 1.0, 'F': 0, '5': 5.0, '4': 4.0, '3': 3.0, '2': 2.0, '1': 1.0 }
  };

  function updateJpGradeOptions() {
    const scale = document.getElementById('jp_scale').value;
    const map = jpGradeMaps[scale];
    const selects = document.querySelectorAll('.jp-grade-select');
    selects.forEach(sel => {
      const current = sel.value;
      sel.innerHTML = '<option value="">成績を選択</option>' +
        Object.entries(map).map(([k,v]) => `<option value="${v}">${k} (${v})</option>`).join('');
      if (map[current]) sel.value = current;
    });
  }

  function addJpSubjectRow() {
    const container = document.getElementById('jp_subjects_container');
    const scale = document.getElementById('jp_scale').value;
    const map = jpGradeMaps[scale];
    const div = document.createElement('div');
    div.className = 'jp-subject-row';
    div.innerHTML = '<select class="jp-grade-select" onchange="calcJpGpa()"><option value="">成績を選択</option>' +
      Object.entries(map).map(([k,v]) => `<option value="${v}">${k} (${v})</option>`).join('') +
      '</select><input type="number" class="jp-credit-input" min="0" step="0.5" placeholder="単位" onchange="calcJpGpa()"><button type="button" class="jp-remove-btn" onclick="removeJpRow(this)">削除</button>';
    container.appendChild(div);
  }

  function removeJpRow(btn) {
    const rows = document.querySelectorAll('.jp-subject-row');
    if (rows.length > 1) btn.parentElement.remove();
    calcJpGpa();
  }

  function calcJpGpa() {
    const rows = document.querySelectorAll('.jp-subject-row');
    let totalPoints = 0, totalCredits = 0;
    rows.forEach(row => {
      const grade = parseFloat(row.querySelector('.jp-grade-select').value);
      const credit = parseFloat(row.querySelector('.jp-credit-input').value);
      if (!isNaN(grade) && !isNaN(credit) && credit > 0) {
        totalPoints += grade * credit;
        totalCredits += credit;
      }
    });
    const result = totalCredits > 0 ? (totalPoints / totalCredits).toFixed(2) : '—';
    document.getElementById('jp_gpa_result').textContent = result;
  }

  function calcJpPctToGpa() {
    const pct = parseFloat(document.getElementById('jp_pct_input').value);
    const scale = parseFloat(document.getElementById('jp_pct_scale').value);
    if (isNaN(pct)) { document.getElementById('jp_pct_gpa_result').textContent = '—'; return; }
    const gpa = Math.min(scale, Math.max(0, (pct / 100) * scale)).toFixed(2);
    document.getElementById('jp_pct_gpa_result').textContent = gpa;
  }

  function calcJpGpaToPct() {
    const gpa = parseFloat(document.getElementById('jp_gpa_input').value);
    const scale = parseFloat(document.getElementById('jp_gpa_scale').value);
    if (isNaN(gpa)) { document.getElementById('jp_gpa_pct_result').textContent = '—'; return; }
    const pct = Math.min(100, Math.max(0, (gpa / scale) * 100)).toFixed(1);
    document.getElementById('jp_gpa_pct_result').textContent = pct + '%';
  }

  function switchJpMode() {
    const mode = document.getElementById('jp_calc_mode').value;
    document.getElementById('jp_mode_grades').style.display = mode === 'grades2gpa' ? 'block' : 'none';
    document.getElementById('jp_mode_pct').style.display = mode === 'percentage2gpa' ? 'block' : 'none';
    document.getElementById('jp_mode_gpa2pct').style.display = mode === 'gpa2percentage' ? 'block' : 'none';
  }

  function copyJpGpa() { copyEl('jp_gpa_result'); }
  function copyJpPctGpa() { copyEl('jp_pct_gpa_result'); }
  function copyJpGpaPct() { copyEl('jp_gpa_pct_result'); }
  function copyEl(id) {
    const txt = document.getElementById(id).textContent;
    if (txt === '—') return;
    navigator.clipboard.writeText(txt).catch(() => {
      const ta = document.createElement('textarea');
      ta.value = txt; document.body.appendChild(ta);
      ta.select(); document.execCommand('copy');
      document.body.removeChild(ta);
    });
    const btn = event.currentTarget;
    const orig = btn.textContent;
    btn.textContent = '✓'; btn.style.color = 'var(--primary)';
    setTimeout(() => { btn.textContent = orig; btn.style.color = ''; }, 1500);
  }

  function toggleFaq(btn) {
    const item = btn.closest('.faq-item');
    const isOpen = item.classList.contains('open');
    document.querySelectorAll('.faq-item.open').forEach(i => i.classList.remove('open'));
    if (!isOpen) item.classList.add('open');
  }

  // 初期化
  updateJpGradeOptions();
  addJpSubjectRow();
  addJpSubjectRow();
  </script>

  <style>
  .jp-subject-row { display: flex; gap: 8px; margin-bottom: 10px; align-items: center; }
  .jp-grade-select { flex: 2; padding: 12px; border: 1px solid var(--border); background: var(--result-bg); color: var(--text); border-radius: 10px; font-family: inherit; }
  .jp-credit-input { flex: 1; padding: 12px; border: 1px solid var(--border); background: var(--result-bg); color: var(--text); border-radius: 10px; font-family: inherit; }
  .jp-remove-btn { padding: 8px 12px; background: var(--result-bg); border: 1px solid var(--border); border-radius: 8px; color: var(--muted); cursor: pointer; font-size: 0.8rem; }
  .jp-remove-btn:hover { border-color: var(--primary); color: var(--primary); }
  .jp-add-btn { margin-top: 12px; padding: 10px 20px; background: var(--primary); border: none; border-radius: 10px; color: #fff; font-weight: 600; cursor: pointer; }
  .jp-add-btn:hover { opacity: 0.9; }
  #jp_mode_grades, #jp_mode_pct, #jp_mode_gpa2pct { animation: fadeIn 0.2s ease; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: translateY(0); } }
  </style>
</Layout>
