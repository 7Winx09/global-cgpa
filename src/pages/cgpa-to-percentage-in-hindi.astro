---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/Nav.astro';
import SiteFooter from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import { universities } from '../data/universities';
import { getUniversitiesByCountry } from '../data/universities-global';

const hiUniversities = getUniversitiesByCountry('IN');

const cgpaValues = [10, 9.5, 9, 8.5, 8, 7.5, 7, 6.5, 6];

// Pre-compute examples at build time
const getExample = (u: typeof universities[0]) => {
  const c = 8;
  if (u.key === 'sppu') {
    if (c >= 9.5) return Math.max(0, 20 * c - 100);
    if (c >= 8.25) return Math.max(0, 12 * c - 25);
    if (c >= 6.75) return Math.max(0, 10 * c - 7.5);
    if (c >= 5.75) return Math.max(0, 5 * c + 26.25);
    if (c >= 5.25) return Math.max(0, 10 * c - 2.5);
    if (c >= 4.75) return Math.max(0, 10 * c - 2.5);
    if (c >= 4.0) return Math.max(0, 6.6 * c + 13.6);
    return 0;
  }
  if (u.key === 'mumbai') return Math.min(100, Math.max(0, 7.1 * c + 11));
  if (u.key === 'aktu') return Math.max(0, (c - 0.75) * 10);
  if (u.key === 'gtu') return Math.max(0, (c - 0.5) * 10);
  if (['vtu', 'anna', 'ktu', 'calcutta', 'rtu', 'rgpv', 'jntuk', 'ikgptu', 'bharathiar', 'periyar', 'bamu', 'csjmu'].includes(u.key)) return Math.min(100, c * 10);
  if (['makaut', 'bangalore'].includes(u.key)) return Math.max(0, (c - 0.75) * 10);
  if (['jntuh', 'bput'].includes(u.key)) return Math.max(0, (c - 0.5) * 10);
  if (u.key === 'osmania') return Math.min(100, c * 9.5);
  if (u.key === 'du') return Math.min(100, c * 9.5);
  if (['andhra', 'kerala', 'mdu', 'kurukshetra', 'shivaji'].includes(u.key)) return Math.min(100, c * 9.5);
  if (['rtmnu'].includes(u.key)) return Math.min(100, c * 10);
  return Math.min(100, c * 9.5);
};

const uniRows = [
  { name: 'CBSE / Generic', href: '/', formula: 'CGPA × 9.5', example: '76%' },
  ...universities.map((u) => ({
    name: u.name + (u.key === 'mumbai' ? ' (2026 से पहले)' : ''),
    href: `/${u.slug}`,
    formula: u.formulaLabel,
    example: getExample(u).toFixed(1) + '%',
  })),
];

const faqs = [
  { q: 'CGPA को प्रतिशत में कैसे बदलें?', a: 'सबसे आसान तरीका है अपने CGPA को 9.5 से गुणा करना। जैसे — 8 CGPA × 9.5 = 76%। यह CBSE/UGC का मानक फॉर्मूला है। लेकिन अगर आपकी यूनिवर्सिटी (जैसे SPPU, Mumbai University, AKTU, GTU, VTU, JNTU, BPUT) का अपना आधिकारिक फॉर्मूला है, तो उसी का इस्तेमाल करें।' },
  { q: '8 CGPA कितने प्रतिशत के बराबर है?', a: 'मानक फॉर्मूले से 8 CGPA = 8 × 9.5 = <strong>76%</strong>। VTU, Anna University, KTU, RTU, RGPV, Calcutta University के नियमों में यह 80% होता है, जबकि SPPU में (8 × 10) − 7.5 = 72.5%, Mumbai University में (7.1 × 8) + 11 = 67.8%, JNTUH/BPUT में (8 − 0.5) × 10 = 75%, MAKAUT/Bangalore/AKTU में (8 − 0.75) × 10 = 72.5%।' },
  { q: 'SGPA और CGPA में क्या अंतर है?', a: 'SGPA किसी एक सेमेस्टर का स्कोर है, जबकि CGPA पूरे कोर्स के सभी सेमेस्टर का क्रेडिट-वेटेड औसत है। दोनों को प्रतिशत में बदलने का फॉर्मूला एक ही है। सेमेस्टर के अंकों के लिए <a href="/sgpa-to-percentage">SGPA to percentage calculator</a> इस्तेमाल करें।' },
  { q: 'क्या रिज़्यूमे में प्रतिशत लिखना ज़रूरी है?', a: 'ज़्यादातर भर्ती फॉर्म और कंपनियां percentage मांगती हैं। हमेशा अपनी यूनिवर्सिटी के आधिकारिक फॉर्मूले से ही प्रतिशत निकालें, क्योंकि वेरिफिकेशन के समय वही फॉर्मूला लागू होता है।' },
  { q: '70% के लिए कितना CGPA चाहिए?', a: 'मानक ×9.5 फॉर्मूले से 70% के लिए लगभग 7.37 CGPA चाहिए। VTU/Anna/KTU/RTU/RGPV/Calcutta/RTMNU/Periyar/CSJMU नियमों में 7.0 CGPA = 70%, जबकि AKTU/MAKAUT/Bangalore/JNTUK में 7.75 CGPA, JNTUH/BPUT में 7.5 CGPA, SPPU में 7.75 CGPA, और Mumbai University में लगभग 8.31 CGPA चाहिए।' },
  { q: '7.5 CGPA अच्छा है या बुरा?', a: '7.5 CGPA अच्छा है — मानक फॉर्मूले से 71.25%। यह First Class है और अधिकांश IT कंपनियों (TCS, Infosys, Wipro) के कट-ऑफ को पूरा करता है। Product companies के लिए 8.0+ बेहतर है।' },
  { q: 'क्या सभी यूनिवर्सिटी का फॉर्मूला एक जैसा है?', a: 'नहीं। हर यूनिवर्सिटी का अपना फॉर्मूला है। CBSE/DU/Andhra/Kerala/MDU/KUK/Shivaji/Bharathiar ×9.5 उपयोग करते हैं। VTU/Anna/KTU/Calcutta/RTU/RGPV/RTMNU/Periyar/IKGPTU/CSJMU/BAMU ×10 उपयोग करते हैं। SPPU piecewise grade-band फॉर्मूला उपयोग करता है। AKTU/MAKAUT/Bangalore/JNTUK (CGPA − 0.75) × 10 उपयोग करते हैं। JNTUH/BPUT (CGPA − 0.5) × 10 उपयोग करते हैं। GTU (CGPA − 0.5) × 10 उपयोग करता है। Mumbai University (pre-2026) (7.1×CGPA)+11 उपयोग करता था।' },
  { q: 'क्या मैं अपनी यूनिवर्सिटी से आधिकारिक conversion certificate ले सकता हूँ?', a: 'हाँ। अपनी यूनिवर्सिटी के Controller of Examinations या college exam cell से contact करें। वे official letterhead पर CGPA-to-percentage conversion certificate जारी करते हैं। कुछ यूनिवर्सिटी (जैसे Mumbai University post-2026) अब request पर ही certificate देती हैं।' },
  { q: 'Distinction के लिए कितना CGPA चाहिए?', a: 'यह यूनिवर्सिटी पर निर्भर करता है: VTU/Anna/KTU/RTU/RGPV/RTMNU/Periyar/IKGPTU/CSJMU/BAMU में 7.5 CGPA (75%+), JNTUH/BPUT/GTU में 7.5 CGPA, SPPU में 8.25+ CGPA, DU/Andhra/Kerala/MDU/KUK/Shivaji/Bharathiar में 7.9 CGPA (×9.5 फॉर्मूले से 75%+), AKTU/MAKAUT/Bangalore/JNTUK में 8.25 CGPA (75%+), Mumbai University (pre-2026) में 7.5 CGPA।' },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  'name': 'CGPA to Percentage Calculator in Hindi (CGPA से प्रतिशत)',
  'url': 'https://globalcgpa.in/cgpa-to-percentage-in-hindi',
  'description': 'Hindi CGPA se percentage calculator using the standard CBSE ×9.5 formula or official university formulas.',
  'applicationCategory': 'EducationalApplication',
  'operatingSystem': 'Any',
  'offers': { '@type': 'Offer', 'price': '0', 'priceCurrency': 'INR' },
  'inLanguage': 'hi-IN',
  'isAccessibleForFree': true,
};
---

<Layout
  lang="hi"
  title="CGPA से प्रतिशत कैलकुलेटर – CGPA to Percentage in Hindi | GlobalCGPA"
  description="CGPA ko percentage mein kaise badlein? Free Hindi CGPA to percentage calculator — CBSE ×9.5 formula aur SPPU, VTU, Mumbai University, AKTU, GTU ke official formulas ke saath."
  canonical="https://globalcgpa.in/cgpa-to-percentage-in-hindi"
  schema={schema}
  alternates={[
    { hreflang: 'hi', href: 'https://globalcgpa.in/cgpa-to-percentage-in-hindi' },
    { hreflang: 'en', href: 'https://globalcgpa.in/' },
    { hreflang: 'x-default', href: 'https://globalcgpa.in/' },
  ]}
>
  <SiteHeader />

  <main style="flex:1;">
    <section class="tool-hero">
      <div class="tool-hero-inner">
        <Breadcrumbs items={[{ label: 'CGPA से प्रतिशत (हिंदी)' }]} />
        <div class="tool-tag">हिंदी में</div>
        <h1 class="tool-h1">CGPA से प्रतिशत कैलकुलेटर</h1>
        <p class="tool-sub">अपना CGPA डालें और तुरंत प्रतिशत (percentage) पाएँ — CBSE के मानक ×9.5 फॉर्मूले या अपनी यूनिवर्सिटी के आधिकारिक फॉर्मूले से।</p>

        <div class="calc-shell">
          <label class="sp-label" for="hi-cgpa">अपना CGPA लिखें</label>
          <input type="number" id="hi-cgpa" min="0" max="10" step="0.01" placeholder="जैसे 8.25" inputmode="decimal" />

          <label class="sp-label" for="hi-formula">फॉर्मूला चुनें</label>
          <select id="hi-formula">
            <option value="cbse" selected>मानक / CBSE — CGPA × 9.5</option>
            {universities.map((u) => (
              <option value={u.key}>{u.short} — {u.formulaLabel}</option>
            ))}
            {hiUniversities.map((u) => (
              <option value={u.key}>{u.name} — {u.formulaLabel}</option>
            ))}
          </select>

          <div class="calc-output">
            <button type="button" class="calc-copy" id="hi-copy" title="Copy result" aria-label="Copy result">⎘</button>
            <div>
              <div class="calc-out-val" id="hi-out">—</div>
              <div class="calc-out-lbl">प्रतिशत (Percentage)</div>
            </div>
            <div class="sp-formula-note" id="hi-note"></div>
          </div>
        </div>
      </div>
    </section>

    <section class="prose tool-article">
      <h2>CGPA को प्रतिशत में बदलने का तरीका</h2>
      <p>भारत की ज़्यादातर यूनिवर्सिटी अब marksheet पर CGPA दिखाती हैं, लेकिन नौकरी के फॉर्म, GATE counselling और admissions ज़्यादातर percentage मांगते हैं। सबसे आम तरीका:</p>
      <div class="formula-block">
        <div class="f-label">मानक फॉर्मूला (CBSE / UGC)</div>
        <div class="f-text">Percentage = CGPA × 9.5</div>
        <div class="f-example">उदाहरण: 8.4 × 9.5 = <strong>79.8%</strong></div>
      </div>
      <p>9.5 गुणक CBSE के विश्लेषण से आया है — grade point 10 पाने वालों के औसत अंक लगभग 95 थे। जब तक आपकी यूनिवर्सिटी का अपना फॉर्मूला न हो, यही मानक तरीका है।</p>

      <h2>यूनिवर्सिटी के आधिकारिक फॉर्मूले</h2>
      <div class="table-scroll">
        <table>
          <thead><tr><th>यूनिवर्सिटी</th><th>फॉर्मूला</th><th>उदाहरण (8.0)</th></tr></thead>
          <tbody>
            {uniRows.map((u) => (
              <tr><td><a href={u.href}>{u.name}</a></td><td>{u.formula}</td><td>{u.example}</td></tr>
            ))}
            <tr><td>कोई rule नहीं (autonomous colleges)</td><td>CGPA × 9.5</td><td>76%</td></tr>
          </tbody>
        </table>
      </div>
        <h2>CGPA से प्रतिशत टेबल (×9.5)</h2>
      <div class="table-scroll">
        <table>
          <thead><tr><th>CGPA</th><th>प्रतिशत</th><th>CGPA</th><th>प्रतिशत</th></tr></thead>
          <tbody>
            {[0, 1, 2, 3].map((i) => (
              <tr>
                <td>{cgpaValues[i]?.toFixed(1)}</td><td>{cgpaValues[i] !== undefined ? (cgpaValues[i] * 9.5).toFixed(1) + '%' : ''}</td>
                <td>{cgpaValues[i + 4]?.toFixed(1)}</td><td>{cgpaValues[i + 4] !== undefined ? (cgpaValues[i + 4] * 9.5).toFixed(1) + '%' : ''}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <h2>कितना CGPA अच्छा माना जाता है?</h2>
      <ul>
        <li><strong>7.0+ CGPA (66.5%+)</strong> — First Class, placements के लिए काफ़ी</li>
        <li><strong>7.5–8.0+ CGPA (71–76%+)</strong> — Distinction, product companies के लिए competitive</li>
        <li><strong>9.0+ CGPA (85.5%+)</strong> — PSU shortlists और scholarships के लिए मज़बूत</li>
      </ul>
      <p>अंग्रेज़ी में पूरी guide — <a href="/">CGPA to Percentage Calculator</a>, <a href="/sgpa-to-cgpa">SGPA to CGPA</a>, <a href="/guides/how-to-improve-cgpa">CGPA सुधारने के तरीके</a>।</p>

      <h2>हिंदी क्षेत्र के प्रमुख विश्वविद्यालय — अपने फॉर्मूले के साथ</h2>
      <p>ये 5 विश्वविद्यालय/समूह अपने आधिकारिक हिंदी/अंग्रेजी अध्यादेशों में अलग CGPA-से-प्रतिशत फॉर्मूला प्रकाशित करते हैं:</p>
      <div class="table-scroll">
        <table>
          <thead><tr><th>विश्वविद्यालय</th><th>फॉर्मूला</th><th>उदाहरण (8.0 CGPA)</th><th>स्रोत</th></tr></thead>
          <tbody>
            {hiUniversities.map((u) => (
              <tr>
                <td><a href={`/${u.slug}`} class="underline hover:text-emerald-500">{u.name}</a></td>
                <td>{u.formulaLabel}</td>
                <td>{u.formulaLabel.includes('×9.5') ? '76%' : '80%'}</td>
                <td><a href={u.sourceUrl} target="_blank" rel="noopener" class="text-xs underline">आधिकारिक</a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-sm text-slate-500 dark:text-zinc-400 mt-2">
        प्रत्येक विश्वविद्यालय का अपना आधिकारिक अध्यादेश (हिंदी/अंग्रेजी में) है। हमेशा अपने कॉलेज के परीक्षा प्रकोष्ठ या Controller of Examinations से आधिकारिक conversion certificate लें।
      </p>
    </section>

    <section class="prose tool-faq">
      <h2>अक्सर पूछे जाने वाले सवाल</h2>
      <FaqAccordion faqs={faqs} />
    </section>
  </main>

  <SiteFooter />
  <style>
    .tool-hero { padding: 20px 20px 8px; }
    .tool-hero-inner { max-width: 640px; margin: 0 auto; }
    .tool-tag {
      font-size: 0.72rem; font-weight: 700; text-transform: uppercase;
      letter-spacing: 1.2px; color: var(--primary); margin-bottom: 8px;
    }
    .tool-h1 {
      font-size: clamp(1.8rem, 5vw, 2.5rem); font-weight: 900;
      letter-spacing: -0.8px; line-height: 1.18; color: var(--text-ink); margin-bottom: 10px;
    }
    .tool-sub {
      font-size: 0.95rem; color: var(--text-body); line-height: 1.7;
      margin-bottom: 26px; max-width: 560px;
    }
    .tool-article, .tool-faq { padding: 0 20px; margin-top: 44px; }
    .tool-article { max-width: 720px; }
    .sp-label {
      display: block; font-size: 0.72rem; font-weight: 700; text-transform: uppercase;
      letter-spacing: 0.6px; color: var(--text-mute); margin-bottom: 6px;
    }
    .calc-shell input[type="number"], .calc-shell select {
      width: 100%; height: 46px; padding: 0 14px; margin-bottom: 16px;
      border: 1px solid var(--border); background: var(--bg-soft); color: var(--text-ink);
      font-size: 0.95rem; font-weight: 500; border-radius: 10px; font-family: inherit;
      transition: border-color 0.2s;
    }
    .calc-shell input:focus, .calc-shell select:focus { outline: none; border-color: var(--primary); }
    .sp-formula-note { margin-top: 10px; font-size: 0.75rem; color: var(--text-mute); text-align: center; }
    .calc-output { position: relative; text-align: center; }
  </style>

  <script>
    const cgpaInput = document.getElementById('hi-cgpa') as HTMLInputElement;
    const formulaSelect = document.getElementById('hi-formula') as HTMLSelectElement;
    const out = document.getElementById('hi-out')!;
    const note = document.getElementById('hi-note')!;

    // Build formulas from universities.ts data
    const formulas: Record<string, { fn: (x: number) => number; label: string }> = {
      cbse: { fn: (x) => x * 9.5, label: 'CBSE/UGC formula' },
      'in-du': { fn: (x) => Math.min(100, x * 9.5), label: 'DU (दिल्ली विश्वविद्यालय) ×9.5' },
      'in-dtu': { fn: (x) => Math.min(100, x * 10), label: 'DTU (दिल्ली प्रौद्योगिकी विश्वविद्यालय) ×10' },
      'in-jnu': { fn: (x) => Math.min(100, x * 10), label: 'JNU (जवाहरलाल नेहरू विश्वविद्यालय) ×10' },
      'in-bhu': { fn: (x) => Math.min(100, x * 10), label: 'BHU (काशी हिंदू विश्वविद्यालय) ×10' },
      'in-iit-civilian': { fn: (x) => Math.min(100, x * 10), label: 'IIT-संबद्ध कॉलेज ×10 (मानक)' },
    };
    
    {universities.map((u) => `
      ${u.key}: { fn: (x) => {
        if (u.key === 'sppu') {
          if (x >= 9.5) return Math.max(0, 20 * x - 100);
          if (x >= 8.25) return Math.max(0, 12 * x - 25);
          if (x >= 6.75) return Math.max(0, 10 * x - 7.5);
          if (x >= 5.75) return Math.max(0, 5 * x + 26.25);
          if (x >= 5.25) return Math.max(0, 10 * x - 2.5);
          if (x >= 4.75) return Math.max(0, 10 * x - 2.5);
          if (x >= 4.0) return Math.max(0, 6.6 * x + 13.6);
          return 0;
        }
        if (u.key === 'mumbai') return Math.min(100, Math.max(0, 7.1 * x + 11));
        if (u.key === 'aktu') return Math.max(0, (x - 0.75) * 10);
        if (u.key === 'gtu') return Math.max(0, (x - 0.5) * 10);
        if (['vtu', 'anna', 'ktu', 'calcutta', 'rtu', 'rgpv', 'jntuk', 'ikgptu', 'bharathiar', 'periyar', 'bamu', 'csjmu'].includes(u.key)) return Math.min(100, x * 10);
        if (['makaut', 'bangalore'].includes(u.key)) return Math.max(0, (x - 0.75) * 10);
        if (['jntuh', 'bput'].includes(u.key)) return Math.max(0, (x - 0.5) * 10);
        if (u.key === 'osmania') return Math.min(100, x * 9.5);
        if (u.key === 'du') return Math.min(100, x * 9.5);
        if (['andhra', 'kerala', 'mdu', 'kurukshetra', 'shivaji'].includes(u.key)) return Math.min(100, x * 9.5);
        if (['rtmnu'].includes(u.key)) return Math.min(100, x * 10);
        return x * 9.5;
      }, label: u.short + ' formula' },
    `).join(',')}

    function calc() {
      const v = parseFloat(cgpaInput.value);
      if (isNaN(v) || v < 0 || v > 10) {
        out.textContent = '—';
        note.textContent = isNaN(v) ? '' : 'CGPA 0 se 10 ke beech hona chahiye';
        return;
      }
      const f = formulas[formulaSelect.value] ?? formulas.cbse;
      out.textContent = Math.min(100, Math.max(0, f.fn(v))).toFixed(1) + '%';
      note.textContent = f.label;
    }

    cgpaInput.addEventListener('input', calc);
    formulaSelect.addEventListener('change', calc);

    document.getElementById('hi-copy')?.addEventListener('click', function (this: HTMLElement) {
      const txt = out.textContent || '';
      if (!txt || txt === '—') return;
      navigator.clipboard.writeText(txt).catch(() => {});
      this.textContent = '✓';
      setTimeout(() => { this.textContent = '⎘'; }, 1400);
    });
  </script>
</Layout>
