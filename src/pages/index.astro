---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/Nav.astro';
import SiteFooter from '../components/Footer.astro';
import { universities } from '../data/universities';

const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  'name': 'How to Convert CGPA to Percentage',
  'description': 'Step-by-step guide to convert CGPA to percentage using the standard CBSE formula and university-specific formulas.',
  'step': [
    {
      '@type': 'HowToStep',
      'position': 1,
      'name': 'Find your CGPA',
      'text': 'Locate your CGPA on your grade card or marksheet. It is usually printed as a decimal number between 0.00 and 10.00.'
    },
    {
      '@type': 'HowToStep',
      'position': 2,
      'name': 'Identify your university formula',
      'text': 'Check which formula your university uses. CBSE/UGC: ×9.5. SPPU: piecewise by grade band. VTU: ×10 (2022 scheme) or (CGPA−0.75)×10 (older schemes). Anna University: ×10. Mumbai University pre-2026: 7.1×CGPA+11. AKTU: (CGPA−0.75)×10. GTU: (CGPA−0.5)×10. KTU: ×10.'
    },
    {
      '@type': 'HowToStep',
      'position': 3,
      'name': 'Apply the formula',
      'text': 'Multiply your CGPA by the appropriate factor or apply the university-specific formula. For example, 8.0 CGPA × 9.5 = 76% (CBSE).'
    },
    {
      '@type': 'HowToStep',
      'position': 4,
      'name': 'Verify for official use',
      'text': 'For official documents, always obtain a percentage equivalence certificate from your university registrar. The calculator gives the same figure the certificate will show.'
    }
  ]
};
---

<Layout
  title="CGPA to Percentage Calculator – Convert CGPA to % | GlobalCGPA"
  description="Free CGPA to percentage calculator. Convert CGPA to % instantly, plus SGPA, GPA and reverse conversions — using accurate formulas for SPPU, VTU, Mumbai University, Anna University & more."
  canonical="https://globalcgpa.in"
  alternates={[
    { hreflang: 'en', href: 'https://globalcgpa.in/' },
    { hreflang: 'hi', href: 'https://globalcgpa.in/cgpa-to-percentage-in-hindi' },
    { hreflang: 'x-default', href: 'https://globalcgpa.in/' },
  ]}
>
<style>
/* ── CSS Variables ────────────────────────────────────────── */
:root {
  --bg: #111827;
  --card: #1F2937;
  --text: #F3F4F6;
  --muted: #9CA3AF;
  --primary: #10B981;
  --primary-dark: #059669;
  --border: #374151;
  --shadow: rgba(0,0,0,0.4);
  --result-bg: #111827;
}

html.light-theme, [data-theme="light"] {
  --bg: #F8FAFC;
  --card: #FFFFFF;
  --text: #0F172A;
  --muted: #64748B;
  --primary: #059669;
  --primary-dark: #047857;
  --border: #E2E8F0;
  --shadow: rgba(15, 23, 42, 0.08);
  --result-bg: #F1F5F9;
}

* { box-sizing: border-box; margin: 0; padding: 0; }
body {
  font-family: 'Inter', system-ui, -apple-system, sans-serif;
  background: var(--bg); color: var(--text); line-height: 1.5;
  min-height: 100vh; display: flex; flex-direction: column;
  transition: background 0.25s ease, color 0.25s ease;
}
/* Header */
header {
  padding: 16px 40px; display: flex; justify-content: space-between;
  align-items: center; border-bottom: 1px solid var(--border);
  background: var(--card); position: sticky; top: 0; z-index: 50;
  transition: background 0.25s ease, border-color 0.25s ease;
}
.logo { font-weight: 700; font-size: 1.1rem; letter-spacing: -0.5px; display: flex; align-items: center; gap: 8px; text-decoration: none; color: var(--text); }
.logo-accent { color: var(--primary); }
.theme-toggle-btn {
  background: var(--result-bg);
  border: 1px solid var(--border);
  color: var(--text);
  padding: 6px 14px;
  border-radius: 999px;
  cursor: pointer;
  font-size: 0.85rem;
  font-weight: 600;
  font-family: inherit;
  display: flex;
  align-items: center;
  gap: 8px;
  transition: all 0.2s ease;
  user-select: none;
}
.theme-toggle-btn:hover {
  border-color: var(--primary);
  color: var(--primary);
  transform: translateY(-1px);
}

/* Hero */
.hero-main {
  display: flex; flex-direction: column; justify-content: center;
  align-items: center; padding: 48px 20px; text-align: center;
  max-width: 800px; margin: 0 auto; width: 100%;
}
.hero-tag {
  text-transform: uppercase; font-size: 0.72rem; font-weight: 700;
  letter-spacing: 1.5px; color: var(--primary); background: rgba(0,210,133,0.1);
  padding: 4px 12px; border-radius: 999px; margin-bottom: 14px; display: inline-block;
}
h1 {
  font-size: clamp(2rem, 5vw, 2.8rem); font-weight: 900;
  letter-spacing: -1px; line-height: 1.2; margin-bottom: 10px;
}
.subtitle { color: var(--muted); font-size: 1rem; max-width: 500px; margin-bottom: 36px; }
/* Calculator card */
.main-calc-card {
  background: var(--card); border: 1px solid var(--border);
  box-shadow: 0 20px 40px var(--shadow), 0 1px 3px rgba(0,0,0,0.02);
  border-radius: 24px; padding: 32px; width: 100%; max-width: 480px; text-align: left;
}
label {
  display: block; font-size: 0.78rem; font-weight: 700;
  text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 6px; color: var(--muted);
}
select, input[type="number"] {
  width: 100%; padding: 14px 16px; border: 1px solid var(--border);
  background: var(--result-bg); color: var(--text); font-size: 1rem;
  font-weight: 500; border-radius: 14px; margin-bottom: 20px;
  transition: border-color 0.2s; appearance: none; font-family: inherit;
}
select:focus, input[type="number"]:focus { outline: none; border-color: var(--primary); }
.dynamic-row { display: flex; gap: 12px; }
.dynamic-row > div { flex: 1; }
.output-display {
  background: var(--result-bg); border-radius: 16px; padding: 20px 20px 16px;
  text-align: center; margin-top: 8px; border: 1px solid var(--border); position: relative;
}
.out-val { font-size: 2.5rem; font-weight: 800; color: var(--primary); line-height: 1.1; margin-bottom: 4px; }
.out-lbl { font-size: 0.75rem; color: var(--muted); text-transform: uppercase; font-weight: 700; letter-spacing: 1px; }
.copy-btn {
  position: absolute; top: 10px; right: 12px; background: none; border: none;
  cursor: pointer; font-size: 0.85rem; color: var(--muted); padding: 4px;
  border-radius: 6px; transition: color 0.2s; line-height: 1;
}
.copy-btn:hover { color: var(--primary); }
/* Belt */
.bottom-belt-section {
  width: 100%; border-top: 1px solid var(--border); padding: 30px 20px;
  background: var(--card);
}
.belt-title { text-align: center; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: var(--muted); margin-bottom: 20px; }
.belt-grid { max-width: 1000px; margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 16px; }
.belt-card {
  background: var(--bg); border: 1px solid var(--border); padding: 16px;
  border-radius: 14px; text-align: center; cursor: pointer; font-size: 0.85rem;
  font-weight: 600; transition: all 0.2s; user-select: none; text-decoration: none; color: var(--text);
  display: flex; align-items: center; justify-content: center; gap: 6px;
}
.belt-card:hover { border-color: var(--primary); transform: translateY(-2px); }
.uni-belt { grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); }
.uni-card { flex-direction: column; gap: 4px; padding: 14px 10px; }
.uni-card-name { font-weight: 800; color: var(--primary); font-size: 0.9rem; }
.uni-card-formula { font-size: 0.68rem; color: var(--muted); font-family: 'Courier New', monospace; }
@media (max-width: 540px) {
  .calc-grid-header { display: none; }
  .sgpa-calc-row, .marks-calc-row {
    grid-template-columns: 1fr 1fr auto; gap: 8px; margin-bottom: 14px;
  }
  .sem-badge, .sub-badge { grid-column: 1 / -1; text-align: left; }
  .result-values-group { gap: 16px; }
}

/* SEO Article */
.seo-article { max-width: 780px; margin: 0 auto; padding: 60px 24px 80px; color: var(--text); }
.seo-article h2 { font-size: 1.55rem; font-weight: 800; letter-spacing: -0.5px; margin: 2.5rem 0 0.75rem; color: var(--text); line-height: 1.25; }
.seo-article h3 { font-size: 1.1rem; font-weight: 700; margin: 1.8rem 0 0.5rem; color: var(--text); }
.seo-article p { font-size: 0.97rem; line-height: 1.8; color: var(--muted); margin-bottom: 1rem; }
.seo-article ul { list-style: none; padding: 0; margin: 0.5rem 0 1.2rem; }
.seo-article ul li { font-size: 0.95rem; color: var(--muted); line-height: 1.75; padding: 0.3rem 0 0.3rem 1.4rem; position: relative; border-bottom: 1px solid var(--border); }
.seo-article ul li:last-child { border-bottom: none; }
.seo-article ul li::before { content: "→"; position: absolute; left: 0; color: var(--primary); font-weight: 700; }
.seo-formula-block { background: var(--result-bg); border: 1px solid var(--border); border-left: 3px solid var(--primary); border-radius: 12px; padding: 18px 22px; margin: 1.2rem 0; }
.seo-formula-block .formula-label { font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: var(--primary); margin-bottom: 6px; }
.seo-formula-block .formula-text { font-family: 'Courier New', monospace; font-size: 1.05rem; font-weight: 700; color: var(--text); }
.seo-formula-block .formula-example { font-size: 0.82rem; color: var(--muted); margin-top: 6px; }
.seo-divider { border: none; border-top: 1px solid var(--border); margin: 2.5rem 0 0; }
.seo-table-wrap { overflow-x: auto; margin: 1rem 0 1.5rem; border-radius: 12px; border: 1px solid var(--border); }
.seo-table { width: 100%; border-collapse: collapse; font-size: 0.88rem; }
.seo-table thead th { background: var(--result-bg); padding: 10px 14px; text-align: left; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: var(--muted); border-bottom: 1px solid var(--border); }
.seo-table tbody td { padding: 10px 14px; border-bottom: 1px solid var(--border); color: var(--muted); }
.seo-table tbody tr:last-child td { border-bottom: none; }
.seo-table tbody td:first-child { font-weight: 700; color: var(--primary); }
/* FAQ */
.faq-section { max-width: 780px; margin: 0 auto; padding: 0 24px 80px; }
.faq-section-title { font-size: 1.55rem; font-weight: 800; letter-spacing: -0.5px; color: var(--text); margin-bottom: 6px; }
.faq-section-sub { font-size: 0.9rem; color: var(--muted); margin-bottom: 2rem; }
.faq-group-label { font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1.2px; color: var(--primary); margin: 2rem 0 0.6rem; padding-left: 2px; }
.faq-item { border-bottom: 1px solid var(--border); }
.faq-item:first-of-type { border-top: 1px solid var(--border); }
.faq-q { width: 100%; background: none; border: none; text-align: left; padding: 16px 4px; font-size: 0.95rem; font-weight: 600; color: var(--text); cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 12px; line-height: 1.4; font-family: inherit; }
.faq-q:hover { color: var(--primary); }
.faq-icon { flex-shrink: 0; width: 22px; height: 22px; border-radius: 50%; border: 1.5px solid var(--border); display: flex; align-items: center; justify-content: center; font-size: 0.9rem; color: var(--muted); transition: all 0.2s; }
.faq-item.open .faq-icon { background: var(--primary); border-color: var(--primary); color: #fff; transform: rotate(45deg); }
.faq-a { display: none; padding: 0 4px 16px; font-size: 0.88rem; line-height: 1.75; color: var(--muted); }
.faq-item.open .faq-a { display: block; }
.faq-a strong { color: var(--text); }
/* Footer */
.site-footer { border-top: 1px solid var(--border); background: var(--card); padding: 48px 24px 28px; margin-top: 20px; }
.footer-inner { max-width: 900px; margin: 0 auto; display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 32px; }
.footer-logo { display: flex; align-items: center; gap: 8px; font-weight: 700; font-size: 1rem; color: var(--primary); margin-bottom: 10px; text-decoration: none; }
.footer-tagline { font-size: 0.82rem; color: var(--muted); line-height: 1.65; max-width: 240px; }
.footer-col-title { font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: var(--muted); margin-bottom: 12px; }
.footer-links { list-style: none; }
.footer-links li { margin-bottom: 8px; }
.footer-links a { font-size: 0.85rem; color: var(--muted); text-decoration: none; transition: color 0.15s; }
.footer-links a:hover { color: var(--primary); }
.footer-bottom { max-width: 900px; margin: 32px auto 0; padding-top: 20px; border-top: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px; }
.footer-copy { font-size: 0.78rem; color: var(--muted); }
.footer-bottom-links { display: flex; gap: 16px; }
.footer-bottom-links a { font-size: 0.78rem; color: var(--muted); text-decoration: none; }
.footer-bottom-links a:hover { color: var(--primary); }
@media (max-width: 680px) {
  .footer-inner { grid-template-columns: 1fr 1fr; gap: 24px; }
  .footer-brand-col { grid-column: 1 / -1; }
  header { padding: 15px 20px; }
  h1 { font-size: 1.85rem; }
  .main-calc-card { padding: 20px; }
}
@media (max-width: 380px) { .footer-inner { grid-template-columns: 1fr; } }
</style>

