<script>
  import { getUniversityFormulas } from '../data/university-formulas';

  const formulas = getUniversityFormulas();

  const select = document.getElementById('uni-select');
  const input = document.getElementById('cgpa-input');
  const emptyEl = document.getElementById('result-empty');
  const valueWrap = document.getElementById('result-value-wrap');
  const valueEl = document.getElementById('result-value');
  const formulaEl = document.getElementById('result-formula');
  const hintEl = document.getElementById('result-hint');

  function update() {
    if (!select || !input || !emptyEl || !valueWrap || !valueEl || !formulaEl || !hintEl) return;

    const key = select.value;
    const cgpa = parseFloat(input.value);
    const formula = formulas[key] || formulas.cbse;

    if (key === '' || Number.isNaN(cgpa) || cgpa < 0 || cgpa > 10) {
      emptyEl.hidden = false;
      valueWrap.hidden = true;
      return;
    }

    const percentage = Math.min(100, Math.max(0, formula.forward(cgpa)));
    valueEl.textContent = percentage.toFixed(2) + '%';
    formulaEl.textContent = 'Formula: Percentage = ' + formula.formula(cgpa);
    hintEl.hidden = key !== 'other';

    emptyEl.hidden = true;
    valueWrap.hidden = false;
  }

  select?.addEventListener('change', update);
  input?.addEventListener('input', update);
</script>

<script is:inline>
  function toggleFaq(btn) {
    const item = btn.closest('.faq-item');
    const isOpen = item.classList.contains('open');
    document.querySelectorAll('.faq-item.open').forEach((i) => i.classList.remove('open'));
    if (!isOpen) item.classList.add('open');
  }
</script>
