<SiteFooter />

<script is:inline>
// ── Core Calculator ────────────────────────────────────
const opConfig = {
  cgpa2pct: { label: 'Enter CGPA',          outLabel: 'Percentage',        scale: true,  max: null },
  pct2cgpa: { label: 'Enter Percentage (%)', outLabel: 'CGPA',              scale: true,  max: 100  },
  cgpa2gpa: { label: 'Enter CGPA',          outLabel: 'GPA (4.0 Scale)',    scale: true,  max: null },
  gpa2cgpa: { label: 'Enter GPA (max 4.0)', outLabel: 'CGPA (10.0 Scale)', scale: false, max: 4    },
};

function switchOperation() {
  const type = document.getElementById('calc_type').value;
  const cfg = opConfig[type];
  document.getElementById('input_label').textContent = cfg.label;
  document.getElementById('scale_wrapper').style.display = cfg.scale ? 'block' : 'none';
  document.getElementById('output_label').textContent = cfg.outLabel;
  const inp = document.getElementById('main_input');
  inp.value = '';
  inp.max = cfg.max || '';
  inp.placeholder = type === 'gpa2cgpa' ? 'e.g. 3.50' : 'e.g. 8.50';
  document.getElementById('output_val').textContent = '—';
}

function runCoreCalculation() {
  const type = document.getElementById('calc_type').value;
  const val  = parseFloat(document.getElementById('main_input').value);
  const scale = parseFloat(document.getElementById('main_scale').value);
  const outVal = document.getElementById('output_val');
  if (isNaN(val) || val < 0) { outVal.textContent = '—'; return; }
  let result;
  if (type === 'cgpa2pct') {
    const pct = scale === 10 ? val * 9.5 : (val / scale) * 100;
    result = Math.min(pct, 100).toFixed(2) + '%';
  } else if (type === 'pct2cgpa') {
    const cgpa = scale === 10 ? val / 9.5 : (val / 100) * scale;
    result = Math.min(cgpa, scale).toFixed(2);
  } else if (type === 'cgpa2gpa') {
    result = Math.min((val / scale) * 4, 4).toFixed(2);
  } else if (type === 'gpa2cgpa') {
    result = Math.min((val / 4) * 10, 10).toFixed(2);
  }
  outVal.textContent = result;
}

// ── Copy ───────────────────────────────────────────────
function copyOutput() { copyEl('output_val'); }
function copyEl(id) {
  const txt = document.getElementById(id).textContent;
  if (txt === '—') return;
  navigator.clipboard.writeText(txt).catch(() => {
    const ta = document.createElement('textarea');
    ta.value = txt; document.body.appendChild(ta);
    ta.select(); document.execCommand('copy');
    document.body.removeChild(ta);
  });
  const btn = event.currentTarget;
  const orig = btn.textContent;
  btn.textContent = '✓'; btn.style.color = 'var(--primary)';
  setTimeout(() => { btn.textContent = orig; btn.style.color = ''; }, 1500);
}

// ── Modals & Sub-calculators ─────────────────────────────
function toggleFaq(btn) {
  const item = btn.closest('.faq-item');
  const isOpen = item.classList.contains('open');
  document.querySelectorAll('.faq-item.open').forEach(i => i.classList.remove('open'));
  if (!isOpen) item.classList.add('open');
}

// ── Theme Toggle ──────────────────────────────────────
</script>
