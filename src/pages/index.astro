    <select id="calc_type" onchange="switchOperation()">
      <option value="cgpa2pct">CGPA to Percentage</option>
      <option value="pct2cgpa">Percentage to CGPA</option>
      <option value="cgpa2gpa">CGPA to GPA (4.0 Scale)</option>
      <option value="gpa2cgpa">GPA to CGPA</option>
    </select>

    <div class="dynamic-row">
      <div>
        <label id="input_label" for="main_input">Enter CGPA</label>
        <input type="number" id="main_input" step="0.01" min="0" placeholder="e.g. 8.50" oninput="runCoreCalculation()">
      </div>
      <div id="scale_wrapper">
        <label for="main_scale">Base Scale</label>
        <select id="main_scale" onchange="runCoreCalculation()">
          <option value="10">10-point scale</option>
          <option value="5">5-point scale</option>
          <option value="4">4-point scale</option>
        </select>
      </div>
