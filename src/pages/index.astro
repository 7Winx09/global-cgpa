---
import Layout from '@/layouts/Layout.astro';
import SiteHeader from '../components/Nav.astro';
import SiteFooter from '../components/Footer.astro';
import { universities } from '../data/universities';

const HOME_UNIVERSITY_KEYS = ['sppu', 'vtu', 'mumbai', 'anna', 'aktu', 'gtu', 'ktu', 'du'];
const homeUniversities = HOME_UNIVERSITY_KEYS
  .map((key) => universities.find((u) => u.key === key))
  .filter((u) => u !== undefined);

const universityOptions = [
  ...homeUniversities.map((u) => ({ value: u.key, label: u.short })),
  { value: 'cbse', label: 'CBSE / UGC' },
  { value: 'other', label: 'Other' },
];

  const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  'name': 'How to Convert CGPA to Percentage',
  'description': 'Convert your CGPA to a percentage in three steps using your university\'s official formula.',
  'step': [
    {
      '@type': 'HowToStep',
      'position': 1,
      'name': 'Pick your university',
      'text': 'Select your university so the calculator uses the formula your university publishes.'
    },
    {
      '@type': 'HowToStep',
      'position': 2,
      'name': 'Type your CGPA',
      'text': 'Enter the CGPA printed on your marksheet, out of 10.'
    },
    {
      '@type': 'HowToStep',
      'position': 3,
      'name': 'Read your percentage',
      'text': 'Your percentage appears instantly, with the exact formula shown below it for verification.'
    }
  ]
};
---

<Layout
  title="CGPA to Percentage Calculator – Convert CGPA to % | Fast Reference Converter"
  description="Free CGPA to percentage calculator. Pick your university — SPPU, VTU, Mumbai University, Anna University, AKTU, GTU, KTU, DU or CBSE/UGC — type your CGPA and see your percentage instantly using official university formulas."
  canonical="https://globalcgpa.in"
  alternates={[
    { hreflang: 'en', href: 'https://globalcgpa.in/' },
    { hreflang: 'hi', href: 'https://globalcgpa.in/cgpa-to-percentage-in-hindi' },
    { hreflang: 'x-default', href: 'https://globalcgpa.in/' },
  ]}
  schema={{
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "GlobalCGPA",
    "url": "https://globalcgpa.in",
    "logo": "https://globalcgpa.in/og-image.png",
    "description": "Free CGPA to percentage calculator for Indian university students. Supports SPPU, VTU, Mumbai University, Anna University, AKTU, GTU, KTU and more. Formulas cross-referenced and verified against published university academic ordinances.",
    "contactPoint": {
      "@type": "ContactPoint",
      "telephone": "",
      "contactType": "customer support",
      "availableLanguage": ["English", "Hindi"],
      "email": "support@globalcgpa.in"
    },
    "sameAs": []
  }}
>
<style>
/* Aliases for legacy markup — map to global.css tokens */
:root {
  --card: var(--bg-card);
  --text: var(--text-ink);
  --muted: var(--text-body);
  --result-bg: var(--bg-soft);
}

body { display: flex; flex-direction: column; min-height: 100vh; }

a:focus-visible, button:focus-visible {
  outline: 2px solid var(--primary);
  outline-offset: 2px;
}

/* ── Hero ── */
.home-main {
  flex: 1; width: 100%;
  display: flex; flex-direction: column; align-items: center;
  padding: 32px 20px 64px; text-align: center;
}
h1 {
  font-size: clamp(1.9rem, 5vw, 2.5rem); font-weight: 800;
  letter-spacing: -1px; line-height: 1.2; color: var(--text-ink);
}
.subtitle {
  color: var(--text-body); font-size: 16px; line-height: 1.5;
  margin-top: 8px; max-width: 520px;
}

/* ── Calculator card ── */
.calc-card {
  width: 100%; max-width: 520px; margin-top: 32px;
  background: var(--bg-card); border: 1px solid var(--border);
  border-radius: 20px; padding: 32px;
  box-shadow: 0 18px 40px rgba(0,0,0,0.14);
  text-align: left;
}
.field { margin-bottom: 24px; }
.field-label {
  display: block; font-size: 14px; font-weight: 700;
  color: var(--text-ink); margin-bottom: 8px;
}
.field-help { font-size: 14px; color: var(--text-body); margin-top: 8px; }
.calc-select, .calc-input {
  width: 100%; height: 48px; padding: 0 16px;
  background: var(--bg-soft); color: var(--text-ink);
  border: 1px solid var(--border); border-radius: 12px;
  font-family: inherit; font-size: 16px; font-weight: 500;
}
.calc-select:focus-visible, .calc-input:focus-visible {
  outline: 2px solid var(--primary); outline-offset: 2px;
  border-color: var(--primary);
}

/* ── Result panel ── */
.result-panel {
  min-height: 176px; margin-top: 8px; padding: 24px 16px;
  background: var(--bg-soft); border: 1px solid var(--border);
  border-radius: 16px;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  text-align: center;
}
.result-empty { font-size: 16px; line-height: 1.5; color: var(--text-body); margin: 0; }
.result-value-wrap { display: flex; flex-direction: column; align-items: center; }
.result-value-wrap[hidden] { display: none; }
.result-label { font-size: 14px; font-weight: 600; color: var(--text-body); margin-bottom: 4px; }
.result-value {
  font-size: 56px; font-weight: 800; line-height: 1.05;
  letter-spacing: -1px; color: var(--primary);
}
.result-formula { font-size: 14px; line-height: 1.5; color: var(--text-body); margin-top: 8px; }
.result-hint { font-size: 14px; line-height: 1.5; color: var(--text-body); margin-top: 4px; }
.result-hint[hidden] { display: none; }
.result-hint a { color: var(--text-ink); }

/* ── Under the card ── */
.trust-line { font-size: 14px; line-height: 1.5; color: var(--text-body); margin-top: 16px; }
.tools-link {
  display: inline-flex; align-items: center; min-height: 44px;
  margin-top: 16px; padding: 0 8px;
  font-size: 16px; font-weight: 600; color: var(--text-ink);
  text-decoration: underline; text-underline-offset: 3px;
  transition: opacity 0.15s;
}
.tools-link:hover { opacity: 0.75; }

/* ── How it works ── */
.how-it-works { width: 100%; max-width: 520px; margin-top: 48px; text-align: left; }
.how-it-works h2 {
  font-size: 1.25rem; font-weight: 800; letter-spacing: -0.4px;
  color: var(--text-ink); margin-bottom: 16px;
}
.how-steps { list-style: none; display: flex; flex-direction: column; gap: 16px; }
.how-step {
  display: flex; align-items: flex-start; gap: 12px;
  font-size: 16px; line-height: 1.5; color: var(--text-body);
}
.how-step-num {
  flex-shrink: 0; width: 28px; height: 28px; border-radius: 50%;
  border: 1px solid var(--border); background: var(--bg-card);
  display: inline-flex; align-items: center; justify-content: center;
  font-size: 14px; font-weight: 700; color: var(--text-ink);
}
.formulas-link {
  display: inline-flex; align-items: center; min-height: 44px;
  margin-top: 24px; padding: 0 8px;
  font-size: 16px; font-weight: 600; color: var(--text-ink);
  text-decoration: underline; text-underline-offset: 3px;
  transition: opacity 0.15s;
}
.formulas-link:hover { opacity: 0.75; }

@media (max-width: 540px) {
  .home-main { padding: 24px 16px 48px; }
  .calc-card { padding: 24px 20px; }
}

/* SEO Article */
.seo-article { max-width: 780px; margin: 0 auto; padding: 60px 24px 80px; color: var(--text); }
.seo-article h2 { font-size: 1.55rem; font-weight: 800; letter-spacing: -0.5px; margin: 2.5rem 0 0.75rem; color: var(--text); line-height: 1.25; }
.seo-article h3 { font-size: 1.1rem; font-weight: 700; margin: 1.8rem 0 0.5rem; color: var(--text); }
.seo-article p { font-size: 0.97rem; line-height: 1.8; color: var(--muted); margin-bottom: 1rem; }
.seo-article ul { list-style: none; padding: 0; margin: 0.5rem 0 1.2rem; }
.seo-article ul li { font-size: 0.95rem; color: var(--muted); line-height: 1.75; padding: 0.3rem 0 0.3rem 1.4rem; position: relative; border-bottom: 1px solid var(--border); }
.seo-article ul li:last-child { border-bottom: none; }
.seo-article ul li::before { content: "→"; position: absolute; left: 0; color: var(--primary); font-weight: 700; }
.seo-formula-block { background: var(--result-bg); border: 1px solid var(--border); border-left: 3px solid var(--primary); border-radius: 12px; padding: 18px 22px; margin: 1.2rem 0; }
.seo-formula-block .formula-label { font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: var(--primary); margin-bottom: 6px; }
.seo-formula-block .formula-text { font-family: 'Courier New', monospace; font-size: 1.05rem; font-weight: 700; color: var(--text); }
.seo-formula-block .formula-example { font-size: 0.82rem; color: var(--muted); margin-top: 6px; }
.seo-divider { border: none; border-top: 1px solid var(--border); margin: 2.5rem 0 0; }
.seo-table-wrap { overflow-x: auto; margin: 1rem 0 1.5rem; border-radius: 12px; border: 1px solid var(--border); }
.seo-table { width: 100%; border-collapse: collapse; font-size: 0.88rem; }
.seo-table thead th { background: var(--result-bg); padding: 10px 14px; text-align: left; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: var(--muted); border-bottom: 1px solid var(--border); }
.seo-table tbody td { padding: 10px 14px; border-bottom: 1px solid var(--border); color: var(--muted); }
.seo-table tbody tr:last-child td { border-bottom: none; }
.seo-table tbody td:first-child { font-weight: 700; color: var(--primary); }
/* FAQ */
.faq-section { max-width: 780px; margin: 0 auto; padding: 0 24px 80px; }
.faq-section-title { font-size: 1.55rem; font-weight: 800; letter-spacing: -0.5px; color: var(--text); margin-bottom: 6px; }
.faq-section-sub { font-size: 0.9rem; color: var(--muted); margin-bottom: 2rem; }
.faq-group-label { font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1.2px; color: var(--primary); margin: 2rem 0 0.6rem; padding-left: 2px; }
.faq-item { border-bottom: 1px solid var(--border); }
.faq-item:first-of-type { border-top: 1px solid var(--border); }
.faq-q { width: 100%; background: none; border: none; text-align: left; padding: 16px 4px; font-size: 0.95rem; font-weight: 600; color: var(--text); cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 12px; line-height: 1.4; font-family: inherit; }
.faq-q:hover { color: var(--primary); }
.faq-icon { flex-shrink: 0; width: 22px; height: 22px; border-radius: 50%; border: 1.5px solid var(--border); display: flex; align-items: center; justify-content: center; font-size: 0.9rem; color: var(--muted); transition: all 0.2s; }
.faq-item.open .faq-icon { background: var(--primary); border-color: var(--primary); color: #fff; transform: rotate(45deg); }
.faq-a { display: none; padding: 0 4px 16px; font-size: 0.88rem; line-height: 1.75; color: var(--muted); }
.faq-item.open .faq-a { display: block; }
.faq-a strong { color: var(--text); }
</style>

<!-- Header -->
<SiteHeader />

<main class="home-main">
  <h1>CGPA to Percentage Calculator</h1>
  <p class="subtitle">Pick your university, type your CGPA, see your percentage.</p>

  <div class="calc-card">
    <div class="field">
      <label class="field-label" for="uni-select">1. Your university</label>
      <select id="uni-select" class="calc-select">
        <option value="">Select your university</option>
        {universityOptions.map((option) => <option value={option.value}>{option.label}</option>)}
      </select>
    </div>

    <div class="field">
      <label class="field-label" for="cgpa-input">2. Your CGPA</label>
      <input
        id="cgpa-input"
        class="calc-input"
        type="number"
        inputmode="decimal"
        step="0.01"
        min="0"
        max="10"
        placeholder="e.g. 8.25"
      />
      <p class="field-help">Find this on your marksheet. Out of 10.</p>
