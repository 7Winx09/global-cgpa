---
import Layout from '../layouts/Layout.astro';
---

<Layout title="500 Internal Server Error | CGPA Calculator" description="An unexpected error occurred. Please try again later.">
  <main class="min-h-[70vh] flex items-center justify-center text-center px-4">
    <div class="max-w-md">
      <h1 class="text-6xl font-extrabold tracking-tight mb-4 text-rose-500">500</h1>
      <h2 class="text-2xl font-bold mb-2">Something Went Wrong</h2>
      <p class="text-slate-500 dark:text-zinc-400 mb-6">
        An unexpected server error occurred. Please refresh or try again later.
      </p>
      <a href="/" class="inline-block bg-emerald-500 hover:bg-emerald-600 text-white font-medium px-6 py-2.5 rounded-lg transition-colors">
        Back to Calculator
      </a>
    </div>
  </main>
</Layout>
