---
import Layout from '@/layouts/Layout.astro';
import { getUniversitiesByCountry } from '@/data/universities-global';

const universities = getUniversitiesByCountry('BR');

const pageTitle = 'Calculadora de Média | Universidades Brasileiras';
const description = 'Calculadora de média para universidades brasileiras. Escala 0–10. USP, UNICAMP, UFRJ, UFMG, UFBA. Média ponderada por créditos, conceitos A–F, aprovação mínima 5.0 ou 6.0.';
const canonical = 'https://globalcgpa.in/pt/';
const ogImage = '/og-image-pt.png';
const lang = 'pt';
const alternates = [
  { hreflang: 'en', href: 'https://globalcgpa.in/' },
  { hreflang: 'pt', href: 'https://globalcgpa.in/pt/' },
];
---

<Layout title={pageTitle} description={description} canonical={canonical} ogImage={ogImage} lang={lang} alternates={alternates}>
  <main class="max-w-[780px] mx-auto px-6 py-14" style="flex:1;">
    <div class="text-xs font-bold uppercase tracking-wider text-emerald-500 mb-2">Calculadora de Média Brasil</div>
    <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight mb-3">Calculadora de Média Ponderada</h1>
    <p class="text-slate-500 dark:text-zinc-400 text-base mb-8">
      Calcula a média ponderada por créditos (Média = Σ(Créditos × Nota) ÷ ΣCréditos) na escala 0–10 usada nas principais universidades brasileiras.
      Suporta conceitos A–F e notas numéricas. Aprovação mínima: 5.0 (maioria) ou 6.0 (UFRJ).
    </p>

    <div class="calc-shell space-y-6" id="media-calculator">
      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <label class="calc-label" for="course-count">Número de disciplinas</label>
          <input type="number" id="course-count" class="calc-input" min="1" max="30" value="6" aria-label="Número de disciplinas" />
        </div>
        <div>
          <label class="calc-label" for="approval-threshold">Nota mínima de aprovação</label>
          <select id="approval-threshold" class="calc-select" aria-label="Nota mínima de aprovação">
            <option value="5.0" selected>5.0 (USP, UNICAMP, UFMG, UFBA)</option>
            <option value="6.0">6.0 (UFRJ)</option>
            <option value="custom">Personalizada</option>
          </select>
        </div>
      </div>

      <div id="courses" class="space-y-3" role="list" aria-label="Lista de disciplinas"></div>

      <button type="button" class="w-full sm:w-auto px-6 py-3 bg-emerald-500 hover:bg-emerald-600 text-slate-900 font-bold text-sm rounded-xl transition-colors" id="calculate-btn">
        Calcular Média
      </button>

      <div class="calc-output" aria-live="polite" aria-label="Resultado da média">
        <div class="calc-out-val" id="result">0.00</div>
        <div class="calc-out-lbl">Média Ponderada</div>
        <div class="calc-out-lbl" style="margin-top:8px; font-size:0.68rem;" id="detail">Total créditos: 0 | Soma ponderada: 0.00</div>
        <div class="calc-out-lbl" style="margin-top:8px; font-size:0.68rem;" id="status"></div>
      </div>

      <div class="formula-block">
        <div class="f-label">Fórmula</div>
        <div class="f-text">Média = Σ(Créditos × Nota) ÷ ΣCréditos</div>
        <div class="f-example" id="formula-example">Ex: 4 créditos × 8.5 + 2 créditos × 7.0 = (34+14)÷6 = 8.00</div>
      </div>
    </div>

    <section class="mt-16" aria-labelledby="univ-list-heading">
      <h2 id="univ-list-heading" class="text-2xl font-extrabold tracking-tight mb-6">Principais Universidades</h2>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {universities.map(u => (
          <a href={`/pt/${u.slug}`} class="calc-shell p-5 hover:border-emerald-500 hover:shadow-lg transition-all text-center">
            <div class="text-3xl font-extrabold text-emerald-500 mb-1">{u.system}</div>
            <div class="font-bold text-lg text-slate-900 dark:text-white">{u.name}</div>
            <div class="text-sm text-slate-500 dark:text-zinc-400 mt-1">{u.nameEn}</div>
          </a>
        ))}
      </div>
    </section>

    <section class="mt-16" aria-labelledby="guides-heading">
      <h2 id="guides-heading" class="text-2xl font-extrabold tracking-tight mb-6">Guias Acadêmicos</h2>
      <div class="grid gap-4 sm:grid-cols-2">
        <a href="/pt/guides/conceitos-a-f" class="calc-shell p-5 hover:border-emerald-500 transition-all">
          <h3 class="font-bold text-lg text-slate-900 dark:text-white mb-2">Conceitos A–F e Notas</h3>
          <p class="text-sm text-slate-500 dark:text-zinc-400">Tabela de conversão conceitos ↔ notas numéricas e percentuais</p>
        </a>
        <a href="/pt/guides/coeficiente-rendimento" class="calc-shell p-5 hover:border-emerald-500 transition-all">
          <h3 class="font-bold text-lg text-slate-900 dark:text-white mb-2">Coeficiente de Rendimento</h3>
          <p class="text-sm text-slate-500 dark:text-zinc-400">Cálculo do CR/IRG, aprovação, formatura e menções honrosas</p>
        </a>
        <a href="/pt/guides/reprovacao-frequencia" class="calc-shell p-5 hover:border-emerald-500 transition-all">
          <h3 class="font-bold text-lg text-slate-900 dark:text-white mb-2">Reprovação por Frequência</h3>
          <p class="text-sm text-slate-500 dark:text-zinc-400">Regras de 75% de frequência mínima, conceito F, impacto na média</p>
        </a>
        <a href="/pt/guides/transferencia-creditos" class="calc-shell p-5 hover:border-emerald-500 transition-all">
          <h3 class="font-bold text-lg text-slate-900 dark:text-white mb-2">Transferência e Aproveitamento</h3>
          <p class="text-sm text-slate-500 dark:text-zinc-400">Regras de transferência entre universidades, aproveitamento de disciplinas</p>
        </a>
        <a href="/pt/guides/mencoes-honrosas" class="calc-shell p-5 hover:border-emerald-500 transition-all">
          <h3 class="font-bold text-lg text-slate-900 dark:text-white mb-2">Menções Honrosas e Formatura</h3>
          <p class="text-sm text-slate-500 dark:text-zinc-400">Critérios de mérito acadêmico, diploma com louvor, menção no histórico</p>
        </a>
        <a href="/pt/guides/sisu-prouni" class="calc-shell p-5 hover:border-emerald-500 transition-all">
          <h3 class="font-bold text-lg text-slate-900 dark:text-white mb-2">SISU, ProUni e Notas de Corte</h3>
          <p class="text-sm text-slate-500 dark:text-zinc-400">Como a média do ENEM/SISU se relaciona com a média universitária</p>
        </a>
      </div>
    </section>
  </main>
</Layout>

<script is:inline>
  const CONCEITOS = ['A', 'B', 'C', 'D', 'F'];
  const NOTAS_CONCEITO = { 'A': 9.0, 'B': 7.5, 'C': 6.0, 'D': 4.0, 'F': 0.0 };
  const PERCENTUAIS = { 'A': [90, 100], 'B': [70, 89], 'C': [60, 69], 'D': [50, 59], 'F': [0, 49] };

  function createCourseRow(index) {
    const row = document.createElement('div');
    row.className = 'grid gap-3 sm:grid-cols-[1fr_80px_100px] items-end';
    row.setAttribute('role', 'listitem');
    row.innerHTML = `
      <div>
        <label class="calc-label" for="grade-${index}">Disciplina ${index + 1} — Conceito/Nota</label>
        <select id="grade-${index}" class="calc-select grade-select" aria-label="Disciplina ${index + 1} conceito ou nota">
          ${CONCEITOS.map(c => `<option value="${c}">${c} (${NOTAS_CONCEITO[c]}) ↔ ${PERCENTUAIS[c][0]}~${PERCENTUAIS[c][1]}%</option>`).join('')}
          <option value="custom">Nota numérica (0–10)</option>
        </select>
      </div>
      <div>
        <label class="calc-label" for="credit-${index}">Créditos</label>
        <input type="number" id="credit-${index}" class="calc-input credit-input" value="4" min="1" max="8" step="1" aria-label="Disciplina ${index + 1} créditos" />
      </div>
      <div>
        <label class="calc-label" for="course-name-${index}">Nome (opcional)</label>
        <input type="text" id="course-name-${index}" class="calc-input" placeholder="Ex: Cálculo I" aria-label="Disciplina ${index + 1} nome" />
      </div>
    `;
    return row;
  }

  function renderCourses(count) {
    const container = document.getElementById('courses');
    container.innerHTML = '';
    for (let i = 0; i < count; i++) {
      container.appendChild(createCourseRow(i));
    }
  }

  function calculateMedia() {
    const gradeSelects = document.querySelectorAll('#courses .grade-select');
    const creditInputs = document.querySelectorAll('#courses .credit-input');
    const thresholdSelect = document.getElementById('approval-threshold');
    const threshold = parseFloat(thresholdSelect.value) || 5.0;

    let totalCredits = 0;
    let totalPoints = 0;

    gradeSelects.forEach((select, i) => {
      const value = select.value;
      const credit = parseFloat(creditInputs[i].value) || 0;
      let point = 0;

      if (value === 'custom') {
        const customInput = select.parentElement.querySelector('.custom-note-input');
        point = customInput ? parseFloat(customInput.value) || 0 : 0;
      } else {
        point = NOTAS_CONCEITO[value] || 0;
      }

      totalCredits += credit;
      totalPoints += credit * point;
    });

    const media = totalCredits > 0 ? totalPoints / totalCredits : 0;
    document.getElementById('result').textContent = media.toFixed(2);
    document.getElementById('detail').textContent = `Total créditos: ${totalCredits} | Soma ponderada: ${totalPoints.toFixed(2)}`;

    const statusEl = document.getElementById('status');
    if (media >= threshold) {
      statusEl.textContent = `✓ Aprovado (média ≥ ${threshold})`;
      statusEl.style.color = '#059669';
    } else {
      statusEl.textContent = `✗ Abaixo da aprovação (média < ${threshold})`;
      statusEl.style.color = '#dc2626';
    }
  }

  const countInput = document.getElementById('course-count');
  const calculateBtn = document.getElementById('calculate-btn');
  let currentCount = parseInt(countInput.value) || 6;

  renderCourses(currentCount);
  calculateMedia();

  countInput.addEventListener('input', () => {
    let newCount = parseInt(countInput.value) || 1;
    newCount = Math.max(1, Math.min(30, newCount));
    currentCount = newCount;
    renderCourses(newCount);
    calculateMedia();
  });

  calculateBtn.addEventListener('click', calculateMedia);

  document.getElementById('courses').addEventListener('change', e => {
    if (e.target.matches('.grade-select, .credit-input')) {
      calculateMedia();
    }
    if (e.target.matches('.grade-select') && e.target.value === 'custom') {
      const select = e.target;
      if (!select.parentElement.querySelector('.custom-note-input')) {
        const input = document.createElement('input');
        input.type = 'number';
        input.className = 'calc-input custom-note-input';
        input.min = '0';
        input.max = '10';
        input.step = '0.1';
        input.placeholder = '0.0–10.0';
        input.style.marginTop = '4px';
        select.parentElement.appendChild(input);
        input.addEventListener('input', calculateMedia);
      }
    } else if (e.target.matches('.grade-select')) {
      const parent = e.target.parentElement;
      const customInput = parent.querySelector('.custom-note-input');
      if (customInput) customInput.remove();
    }
  });
</script>
