---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/Nav.astro';
import SiteFooter from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import FaqAccordion from '../components/FaqAccordion.astro';

const faqs = [
  { q: 'How do I convert percentage to CGPA?', a: 'On the standard 10-point scale, divide your percentage by 9.5 (the CBSE/UGC convention). So 76% ÷ 9.5 = <strong>8.0 CGPA</strong>. Universities with their own formulas — SPPU, Mumbai, AKTU, GTU — use different reverse calculations, which the formula selector above handles.' },
  { q: 'What is 60% in CGPA?', a: 'Under the CBSE formula, 60 ÷ 9.5 = <strong>6.32 CGPA</strong>. Under VTU/KTU/Anna-style direct conversion (÷10) it is exactly 6.0, under SPPU it is 6.75, under Mumbai University about 6.90, and under AKTU 6.75. The selector above shows all of them.' },
  { q: 'What CGPA is 80%?', a: '80% equals 8.42 CGPA under CBSE (80 ÷ 9.5), 8.0 under direct ÷10 universities, 8.75 under SPPU, and 9.68 under Mumbai University\'s reverse formula. Always convert with your own university\'s rule.' },
  { q: 'Why do different universities give different CGPAs for the same percentage?', a: 'Because each university anchors its grade points to different raw-mark bands. The reverse conversion simply undoes whatever forward formula the university uses, so the same percentage maps to different CGPA values across universities.' },
  { q: 'Is the reverse conversion exact?', a: 'Yes for linear formulas — every formula here is a straight-line equation, so reversing it is mathematically exact. Your university\'s rounding (CGPA to two decimals) is the only source of tiny differences.' },
];
---

<Layout
  title="Percentage to CGPA Calculator (All University Formulas) | GlobalCGPA"
  description="Convert percentage to CGPA instantly. Free calculator supporting CBSE ×9.5, VTU, SPPU, Mumbai University, AKTU and GTU reverse formulas on the 10-point scale — plus 4.0 GPA scale."
  canonical="https://globalcgpa.in/percentage-to-cgpa"
  schema={{
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    'name': 'Percentage to CGPA Calculator',
    'url': 'https://globalcgpa.in/percentage-to-cgpa',
    'description': 'Convert percentage to CGPA using all major Indian university formulas.',
    'applicationCategory': 'EducationalApplication',
    'operatingSystem': 'Any',
    'offers': { '@type': 'Offer', 'price': '0', 'priceCurrency': 'INR' },
    'isAccessibleForFree': true,
  }}
>
  <SiteHeader />

  <main style="flex:1;">
    <section class="tool-hero">
      <div class="tool-hero-inner">
        <Breadcrumbs items={[{ label: 'Percentage to CGPA' }]} />
        <div class="tool-tag">Reverse Converter</div>
        <h1 class="tool-h1">Percentage to CGPA Calculator</h1>
        <p class="tool-sub">Enter a percentage, pick your university's conversion rule, and get the exact CGPA it corresponds to.</p>

        <div class="calc-shell">
          <label class="calc-label" for="pct-in">Enter percentage (0 – 100)</label>
          <input class="calc-input" type="number" id="pct-in" min="0" max="100" step="0.1" placeholder="e.g. 76" inputmode="decimal" />

          <label class="calc-label" for="pct-formula" style="margin-top:16px;">Conversion formula</label>
          <select class="calc-select" id="pct-formula">
            <option value="cbse">CBSE / UGC standard — CGPA = % ÷ 9.5</option>
            <option value="direct">Direct ÷10 (VTU, KTU, Anna University)</option>
            <option value="sppu">SPPU — CGPA = (% + 7.5) ÷ 10</option>
            <option value="mumbai">Mumbai University — CGPA = (% − 11) ÷ 7.1</option>
            <option value="aktu">AKTU — CGPA = (% ÷ 10) + 0.75</option>
            <option value="gtu">GTU — CGPA = (% ÷ 10) + 0.5</option>
            <option value="gpa4">4.0 GPA scale — GPA = (% ÷ 100) × 4</option>
          </select>

          <div class="calc-output" style="margin-top:16px;">
            <button type="button" class="calc-copy" id="copy-pct" title="Copy result" aria-label="Copy result">⎘</button>
            <div class="calc-out-val" id="pct-out">—</div>
            <div class="calc-out-lbl" id="pct-out-label">Equivalent CGPA</div>
          </div>
        </div>
      </div>
    </section>

    <section class="prose tool-article">
      <h2>How Percentage Converts Back to CGPA</h2>
      <p>Every university's CGPA-to-percentage rule is a linear equation, so each one reverses cleanly. The standard CBSE/UGC convention divides by 9.5:</p>
      <div class="formula-block">
        <div class="f-label">Standard reverse formula</div>
        <div class="f-text">CGPA = Percentage ÷ 9.5</div>
        <div class="f-example">Example: 85% ÷ 9.5 = <strong>8.95 CGPA</strong></div>
      </div>
      <p>But if your university publishes its own conversion — as SPPU, Mumbai University, AKTU and GTU do — using the generic formula gives you a CGPA that will not match your marksheet. The selector in the calculator above applies the exact reverse of each university's official formula:</p>
      <div class="table-scroll">
        <table>
          <thead><tr><th>University</th><th>Forward formula</th><th>Reverse (used here)</th><th>85% equals</th></tr></thead>
          <tbody>
            <tr><td>CBSE / UGC</td><td>CGPA × 9.5</td><td>% ÷ 9.5</td><td>8.95</td></tr>
            <tr><td>VTU / KTU / Anna</td><td>CGPA × 10</td><td>% ÷ 10</td><td>8.50</td></tr>
            <tr><td>SPPU</td><td>(CGPA × 10) − 7.5</td><td>(% + 7.5) ÷ 10</td><td>9.25</td></tr>
            <tr><td>Mumbai University</td><td>(7.1 × CGPA) + 11</td><td>(% − 11) ÷ 7.1</td><td>10.42*</td></tr>
            <tr><td>AKTU</td><td>(CGPA − 0.75) × 10</td><td>(% ÷ 10) + 0.75</td><td>9.25</td></tr>
            <tr><td>GTU</td><td>(CGPA − 0.5) × 10</td><td>(% ÷ 10) + 0.5</td><td>9.00</td></tr>
          </tbody>
        </table>
      </div>
      <p>*Mumbai University's scale caps a 10.0 CGPA at 82%, so percentages above 82% have no valid CGPA on the MU scale — the calculator clamps results to the 0–10 range and flags the impossibility by capping.</p>

      <h2>When Do You Actually Need This?</h2>
      <ul>
        <li><strong>Eligibility checks before applying.</strong> If a company or university requires "70% or equivalent CGPA", this tells you whether your transcript already qualifies.</li>
        <li><strong>Target setting.</strong> Reverse-converting a target percentage tells you the exact CGPA to aim for this semester — see our guide on <a href="/guides/how-to-improve-cgpa">improving your CGPA</a> for the plan.</li>
        <li><strong>Verifying certificates.</strong> If a conversion certificate looks off, the reverse formula is the fastest way to sanity-check it.</li>
        <li><strong>Scholarship and loan forms.</strong> Many ask for percentage thresholds; knowing your CGPA equivalent avoids over- or under-stating your record.</li>
      </ul>
      <p>Going the other way? Use the <a href="/">CGPA to percentage calculator</a>, or convert to a 4.0 scale with the <a href="/cgpa-to-gpa">CGPA to GPA calculator</a> for foreign applications.</p>
    </section>

    <section class="prose tool-faq">
      <h2>Frequently Asked Questions</h2>
      <FaqAccordion faqs={faqs} />
    </section>
  </main>

  <SiteFooter />

  <style>
    .tool-hero { padding: 20px 20px 8px; }
    .tool-hero-inner { max-width: 560px; margin: 0 auto; }
    .tool-tag {
      font-size: 0.72rem; font-weight: 700; text-transform: uppercase;
      letter-spacing: 1.2px; color: var(--primary); margin-bottom: 8px;
    }
    .tool-h1 {
      font-size: clamp(1.8rem, 5vw, 2.5rem); font-weight: 900;
      letter-spacing: -0.8px; line-height: 1.18; color: var(--text-ink); margin-bottom: 10px;
    }
    .tool-sub {
      font-size: 0.95rem; color: var(--text-body); line-height: 1.7;
      margin-bottom: 26px; max-width: 560px;
    }
    .tool-article, .tool-faq { padding: 0 20px; margin-top: 44px; }
  </style>

  <script>
    const inp = document.getElementById('pct-in') as HTMLInputElement;
    const sel = document.getElementById('pct-formula') as HTMLSelectElement;
    const out = document.getElementById('pct-out')!;
    const outLabel = document.getElementById('pct-out-label')!;

    const reverse: Record<string, { fn: (p: number) => number; max: number; label: string }> = {
      cbse: { fn: (p) => p / 9.5, max: 95, label: 'Equivalent CGPA' },
      direct: { fn: (p) => p / 10, max: 100, label: 'Equivalent CGPA' },
      sppu: { fn: (p) => (p + 7.5) / 10, max: 92.5, label: 'Equivalent CGPA' },
      mumbai: { fn: (p) => (p - 11) / 7.1, max: 82, label: 'Equivalent CGPA' },
      aktu: { fn: (p) => p / 10 + 0.75, max: 92.5, label: 'Equivalent CGPA' },
      gtu: { fn: (p) => p / 10 + 0.5, max: 95, label: 'Equivalent CGPA' },
      gpa4: { fn: (p) => (p / 100) * 4, max: 100, label: 'Equivalent GPA (4.0 scale)' },
    };

    function calc() {
      const p = parseFloat(inp.value);
      const cfg = reverse[sel.value];
      outLabel.textContent = cfg.label;
      if (isNaN(p) || p < 0 || p > 100) { out.textContent = '—'; return; }
      const v = cfg.fn(p);
      const capped = Math.min(10, Math.max(0, v));
      out.textContent = sel.value === 'gpa4' ? capped.toFixed(2) : capped.toFixed(2);
      if (p > cfg.max && sel.value !== 'gpa4') {
        out.textContent = capped.toFixed(2) + ' *';
      }
    }

    inp.addEventListener('input', calc);
    sel.addEventListener('change', calc);
    calc();

    document.getElementById('copy-pct')?.addEventListener('click', function (this: HTMLElement) {
      const txt = out.textContent || '';
      if (!txt || txt.startsWith('—')) return;
      navigator.clipboard.writeText(txt).catch(() => {});
      const orig = this.textContent;
      this.textContent = '✓';
      setTimeout(() => { this.textContent = orig; }, 1400);
    });
  </script>
</Layout>
