---
import Layout from '@/layouts/Layout.astro';
import { getUniversityByKey } from '@/data/universities-global';

const univ = getUniversityByKey('kr-konkuk')!;
const pageTitle = `${univ.name} 학점계산기 | ${univ.formulaLabel} 평점 평균 계산`;
const description = `건국대학교 전용 학점계산기. 4.5 만점 및 4.3 만점 환산표 공식 제공. 과목별 등급과 학점 입력으로 정확한 GPA 산출. 공식 규정: ${univ.source}`;
const canonical = `https://globalcgpa.in/ko/konkuk`;
const ogImage = '/og-image-ko.png';
const lang = 'ko';
const alternates = [
  { hreflang: 'en', href: 'https://globalcgpa.in/university/konkuk' },
  { hreflang: 'ko', href: 'https://globalcgpa.in/ko/konkuk' },
];
---

<Layout title={pageTitle} description={description} canonical={canonical} ogImage={ogImage} lang={lang} alternates={alternates}>
  <main class="max-w-[780px] mx-auto px-6 py-14" style="flex:1;">
    <nav class="crumbs mb-6" aria-label="브레드크럼">
      <a href="/ko/">학점계산기</a>
      <span class="sep">/</span>
      <a href="/ko/대학-학점계산기">대학별</a>
      <span class="sep">/</span>
      <span class="current">{univ.name}</span>
    </nav>

    <div class="text-xs font-bold uppercase tracking-wider text-emerald-500 mb-2">{univ.name} ({univ.nameEn})</div>
    <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight mb-3">{univ.name} 학점계산기</h1>
    <p class="text-slate-500 dark:text-zinc-400 text-base mb-8">
      {univ.name}은 4.5 만점 체계를 기본으로 하며, 공식 4.3 만점 환산표를 제공합니다.
      아래 탭에서 계산할 체계를 선택하세요.
    </p>

    <div class="flex gap-2 mb-6" role="tablist" aria-label="만점 체계 선택">
      <button role="tab" aria-selected="true" aria-controls="panel-konkuk-45" id="tab-konkuk-45" class="calc-tab active" data-system="4.5">4.5 만점 (기본)</button>
      <button role="tab" aria-selected="false" aria-controls="panel-konkuk-43" id="tab-konkuk-43" class="calc-tab" data-system="4.3">4.3 만점 (환산)</button>
    </div>

    <div role="tabpanel" id="panel-konkuk-45" aria-labelledby="tab-konkuk-45" class="space-y-6" data-system="4.5">
      <div class="calc-shell space-y-6" id="univ-gpa-calculator-45">
        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label class="calc-label" for="course-count-45">과목 수</label>
            <input type="number" id="course-count-45" class="calc-input" min="1" max="30" value="6" aria-label="과목 수 입력" />
          </div>
          <div>
            <label class="calc-label" for="semester-45">학기 구분 (선택)</label>
            <select id="semester-45" class="calc-select" aria-label="학기 구분 선택">
              <option value="">전체 학기 합산</option>
              <option value="1">1학기</option>
              <option value="2">2학기</option>
              <option value="summer">하계학기</option>
              <option value="winter">동계학기</option>
            </select>
          </div>
        </div>

        <div id="courses-45" class="space-y-3" role="list" aria-label="과목 목록"></div>

        <button type="button" class="w-full sm:w-auto px-6 py-3 bg-emerald-500 hover:bg-emerald-600 text-slate-900 font-bold text-sm rounded-xl transition-colors" id="calculate-btn-45">
          평점 평균 계산
        </button>

        <div class="calc-output" aria-live="polite" aria-label="4.5 만점 계산 결과">
          <div class="calc-out-val" id="result-45">0.00</div>
          <div class="calc-out-lbl">평점 평균 (GPA, 4.5 만점)</div>
          <div class="calc-out-lbl" style="margin-top:8px; font-size:0.68rem;" id="detail-45">총 학점: 0 | 총 평점: 0.00</div>
        </div>

        <div class="formula-block">
          <div class="f-label">계산 공식</div>
          <div class="f-text">GPA = Σ(학점 × 평점) ÷ Σ학점</div>
          <div class="f-example" id="formula-example-45">예: 3학점 A+(4.5) + 3학점 B+(3.5) = (13.5+10.5)÷6 = 4.00</div>
        </div>
      </div>
    </div>

    <div role="tabpanel" id="panel-konkuk-43" aria-labelledby="tab-konkuk-43" class="space-y-6 hidden" data-system="4.3">
      <div class="calc-shell space-y-6" id="univ-gpa-calculator-43">
        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label class="calc-label" for="course-count-43">과목 수</label>
            <input type="number" id="course-count-43" class="calc-input" min="1" max="30" value="6" aria-label="과목 수 입력" />
          </div>
          <div>
            <label class="calc-label" for="semester-43">학기 구분 (선택)</label>
            <select id="semester-43" class="calc-select" aria-label="학기 구분 선택">
              <option value="">전체 학기 합산</option>
              <option value="1">1학기</option>
              <option value="2">2학기</option>
              <option value="summer">하계학기</option>
              <option value="winter">동계학기</option>
            </select>
          </div>
        </div>

        <div id="courses-43" class="space-y-3" role="list" aria-label="과목 목록"></div>

        <button type="button" class="w-full sm:w-auto px-6 py-3 bg-emerald-500 hover:bg-emerald-600 text-slate-900 font-bold text-sm rounded-xl transition-colors" id="calculate-btn-43">
          평점 평균 계산
        </button>

        <div class="calc-output" aria-live="polite" aria-label="4.3 만점 계산 결과">
          <div class="calc-out-val" id="result-43">0.00</div>
          <div class="calc-out-lbl">평점 평균 (GPA, 4.3 만점)</div>
          <div class="calc-out-lbl" style="margin-top:8px; font-size:0.68rem;" id="detail-43">총 학점: 0 | 총 평점: 0.00</div>
        </div>

        <div class="formula-block">
          <div class="f-label">계산 공식</div>
          <div class="f-text">GPA = Σ(학점 × 평점) ÷ Σ학점</div>
          <div class="f-example" id="formula-example-43">예: 3학점 A+(4.3) + 3학점 B+(3.3) = (12.9+9.9)÷6 = 3.80</div>
        </div>
      </div>
    </div>

    <section class="mt-12" aria-labelledby="regulation-heading">
      <h2 id="regulation-heading" class="text-2xl font-extrabold tracking-tight mb-6">공식 성적 규정 및 환산표</h2>
      <div class="prose">
        <h3>4.5 만점 평점 체계 (기본)</h3>
        <div class="table-scroll">
          <table>
            <thead>
              <tr>
                <th>등급</th>
                <th class="text-center">평점</th>
                <th class="text-center">백분율(%)</th>
              </tr>
            </thead>
            <tbody>
              {Object.entries(univ.gradeMapping).map(([grade, point]) => (
                <tr>
                  <td><strong>{grade}</strong></td>
                  <td class="text-center font-mono">{point.toFixed(2)}</td>
                  <td class="text-center">
                    {univ.percentageMapping && univ.percentageMapping[grade]
                      ? `${univ.percentageMapping[grade][0]}~${univ.percentageMapping[grade][1]}%`
                      : '—'}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <h3 class="mt-6">4.5 ↔ 4.3 만점 공식 환산표 (건국대 제공)</h3>
        <div class="table-scroll">
          <table>
            <thead>
              <tr>
                <th>4.5 만점 평점</th>
                <th>4.3 만점 환산</th>
                <th>백분율(%)</th>
                <th>등급(4.5)</th>
                <th>등급(4.3)</th>
              </tr>
            </thead>
            <tbody>
              <tr><td class="font-mono">4.50</td><td class="font-mono">4.30</td><td>95~100</td><td>A+</td><td>A+</td></tr>
              <tr><td class="font-mono">4.45</td><td class="font-mono">4.25</td><td>94</td><td>A+</td><td>A+</td></tr>
              <tr><td class="font-mono">4.40</td><td class="font-mono">4.20</td><td>93</td><td>A+</td><td>A+</td></tr>
              <tr><td class="font-mono">4.30</td><td class="font-mono">4.10</td><td>92</td><td>A+</td><td>A+</td></tr>
              <tr><td class="font-mono">4.20</td><td class="font-mono">4.00</td><td>91</td><td>A+</td><td>A0</td></tr>
              <tr><td class="font-mono">4.10</td><td class="font-mono">3.90</td><td>90</td><td>A+</td><td>A0</td></tr>
              <tr><td class="font-mono">4.00</td><td class="font-mono">3.80</td><td>89</td><td>A</td><td>A0</td></tr>
              <tr><td class="font-mono">3.90</td><td class="font-mono">3.70</td><td>88</td><td>A</td><td>A-</td></tr>
              <tr><td class="font-mono">3.80</td><td class="font-mono">3.60</td><td>87</td><td>A</td><td>A-</td></tr>
              <tr><td class="font-mono">3.70</td><td class="font-mono">3.50</td><td>86</td><td>A</td><td>A-</td></tr>
              <tr><td class="font-mono">3.60</td><td class="font-mono">3.40</td><td>85</td><td>A</td><td>A-</td></tr>
              <tr><td class="font-mono">3.50</td><td class="font-mono">3.30</td><td>84</td><td>B+</td><td>B+</td></tr>
              <tr><td class="font-mono">3.00</td><td class="font-mono">3.00</td><td>80</td><td>B</td><td>B0</td></tr>
              <tr><td class="font-mono">2.50</td><td class="font-mono">2.30</td><td>75</td><td>C+</td><td>C+</td></tr>
              <tr><td class="font-mono">2.00</td><td class="font-mono">2.00</td><td>70</td><td>C</td><td>C0</td></tr>
              <tr><td class="font-mono">1.50</td><td class="font-mono">1.30</td><td>65</td><td>D+</td><td>D+</td></tr>
              <tr><td class="font-mono">1.00</td><td class="font-mono">1.00</td><td>60</td><td>D</td><td>D0</td></tr>
              <tr><td class="font-mono">0.00</td><td class="font-mono">0.00</td><td>0~59</td><td>F</td><td>F</td></tr>
            </tbody>
          </table>
        </div>

        <h3 class="mt-6">주요 학사 규정</h3>
        <ul>
          <li><strong>평점 평균 산출:</strong> Σ(과목별 학점 × 등급 평점) ÷ 총 이수 학점 (P, N 제외)</li>
          <li><strong>이중 체계:</strong> 4.5 만점(기본) 및 4.3 만점(환산) 동시 운영, 성적증명서 발급 시 선택 가능</li>
          <li><strong>등급 체계:</strong> A+/A, B+/B, C+/C, D+/D, F (세부 등급 없음)</li>
          <li><strong>학사경고:</strong> 직전 학기 평점평균 2.0 미만 시 경고, 연속 3회 시 제적</li>
          <li><strong>재수강:</strong> C+ 이하 과목 재수강 가능, 재수강 시 상위 성적만 GPA 반영</li>
        </ul>

        <h3 class="mt-6">출처</h3>
        <p><strong>{univ.source}</strong></p>
        <p><a href={univ.sourceUrl} target="_blank" rel="noopener" class="underline hover:text-emerald-500">{univ.sourceUrl}</a></p>
        {univ.note && <p class="text-sm text-slate-500 dark:text-zinc-400"><strong>비고:</strong> {univ.note}</p>}
      </div>
    </section>

    <section class="mt-12" aria-labelledby="related-heading">
      <h2 id="related-heading" class="text-2xl font-extrabold tracking-tight mb-6">다른 대학 계산기</h2>
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        <a href="/ko/snu" class="calc-shell p-4 hover:border-emerald-500 transition-all text-center">서울대학교 — 4.3 만점</a>
        <a href="/ko/kaist" class="calc-shell p-4 hover:border-emerald-500 transition-all text-center">카이스트 — 4.3 만점</a>
        <a href="/ko/yonsei" class="calc-shell p-4 hover:border-emerald-500 transition-all text-center">연세대학교 — 4.3 만점</a>
        <a href="/ko/korea" class="calc-shell p-4 hover:border-emerald-500 transition-all text-center">고려대학교 — 4.5 만점</a>
        <a href="/ko/ewha" class="calc-shell p-4 hover:border-emerald-500 transition-all text-center">이화여자대학교 — 4.3 만점</a>
        <a href="/ko/skk" class="calc-shell p-4 hover:border-emerald-500 transition-all text-center">성균관대학교 — 4.5 만점</a>
      </div>
    </section>
  </main>
</Layout>

<script is:inline>
  const GRADES_45 = ['A+', 'A', 'B+', 'B', 'C+', 'C', 'D+', 'D', 'F'];
  const POINTS_45 = { 'A+': 4.5, 'A': 4.0, 'B+': 3.5, 'B': 3.0, 'C+': 2.5, 'C': 2.0, 'D+': 1.5, 'D': 1.0, 'F': 0.0 };
  const PERCENTAGES_45 = { 'A+': [95, 100], 'A': [90, 94], 'B+': [85, 89], 'B': [80, 84], 'C+': [75, 79], 'C': [70, 74], 'D+': [65, 69], 'D': [60, 64], 'F': [0, 59] };

  const GRADES_43 = ['A+', 'A0', 'A-', 'B+', 'B0', 'B-', 'C+', 'C0', 'C-', 'D+', 'D0', 'D-', 'F'];
  const POINTS_43 = { 'A+': 4.3, 'A0': 4.0, 'A-': 3.7, 'B+': 3.3, 'B0': 3.0, 'B-': 2.7, 'C+': 2.3, 'C0': 2.0, 'C-': 1.7, 'D+': 1.3, 'D0': 1.0, 'D-': 0.7, 'F': 0.0 };
  const PERCENTAGES_43 = { 'A+': [95, 100], 'A0': [90, 94], 'A-': [85, 89], 'B+': [80, 84], 'B0': [75, 79], 'B-': [70, 74], 'C+': [65, 69], 'C0': [60, 64], 'C-': [55, 59], 'D+': [50, 54], 'D0': [45, 49], 'D-': [40, 44], 'F': [0, 39] };

  function createCourseRow(system, index) {
    const grades = system === '4.5' ? GRADES_45 : GRADES_43;
    const points = system === '4.5' ? POINTS_45 : POINTS_43;
    const percentages = system === '4.5' ? PERCENTAGES_45 : PERCENTAGES_43;

    const row = document.createElement('div');
    row.className = 'grid gap-3 sm:grid-cols-[1fr_80px_100px] items-end';
    row.setAttribute('role', 'listitem');
    row.innerHTML = `
      <div>
        <label class="calc-label" for="grade-${system}-${index}">과목 ${index + 1} 등급</label>
        <select id="grade-${system}-${index}" class="calc-select grade-select" aria-label="과목 ${index + 1} 등급">
          ${grades.map(g => `<option value="${g}">${g} (${points[g]}) ↔ ${percentages[g][0]}~${percentages[g][1]}%</option>`).join('')}
        </select>
      </div>
      <div>
        <label class="calc-label" for="credit-${system}-${index}">학점</label>
        <input type="number" id="credit-${system}-${index}" class="calc-input credit-input" value="3" min="1" max="6" step="1" aria-label="과목 ${index + 1} 학점" />
      </div>
      <div>
        <label class="calc-label" for="course-name-${system}-${index}">과목명 (선택)</label>
        <input type="text" id="course-name-${system}-${index}" class="calc-input" placeholder="예: 미분적분학" aria-label="과목 ${index + 1} 이름" />
      </div>
    `;
    return row;
  }

  function renderCourses(system, count) {
    const container = document.getElementById(`courses-${system === '4.5' ? '45' : '43'}`);
    container.innerHTML = '';
    for (let i = 0; i < count; i++) {
      container.appendChild(createCourseRow(system, i));
    }
  }

  function calculateGPA(system) {
    const points = system === '4.5' ? POINTS_45 : POINTS_43;
    const suffix = system === '4.5' ? '45' : '43';
    const gradeSelects = document.querySelectorAll(`#courses-${suffix} .grade-select`);
    const creditInputs = document.querySelectorAll(`#courses-${suffix} .credit-input`);

    let totalCredits = 0;
    let totalPoints = 0;

    gradeSelects.forEach((select, i) => {
      const grade = select.value;
      const credit = parseFloat(creditInputs[i].value) || 0;
      const point = points[grade] || 0;

      totalCredits += credit;
      totalPoints += credit * point;
    });

    const gpa = totalCredits > 0 ? totalPoints / totalCredits : 0;
    document.getElementById(`result-${suffix}`).textContent = gpa.toFixed(2);
    document.getElementById(`detail-${suffix}`).textContent = `총 학점: ${totalCredits} | 총 평점: ${totalPoints.toFixed(2)}`;
  }

  ['4.5', '4.3'].forEach(sys => {
    const suffix = sys === '4.5' ? '45' : '43';
    const countInput = document.getElementById(`course-count-${suffix}`);
    const calculateBtn = document.getElementById(`calculate-btn-${suffix}`);
    let currentCount = parseInt(countInput.value) || 6;

    renderCourses(sys, currentCount);
    calculateGPA(sys);

    countInput.addEventListener('input', () => {
      let newCount = parseInt(countInput.value) || 1;
      newCount = Math.max(1, Math.min(30, newCount));
      currentCount = newCount;
      renderCourses(sys, newCount);
      calculateGPA(sys);
    });

    calculateBtn.addEventListener('click', () => calculateGPA(sys));

    document.getElementById(`courses-${suffix}`).addEventListener('change', e => {
      if (e.target.matches('.grade-select, .credit-input')) {
        calculateGPA(sys);
      }
    });
  });

  document.querySelectorAll('[role="tab"][data-system]').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('[role="tab"][data-system]').forEach(b => {
        b.classList.remove('active');
        b.setAttribute('aria-selected', 'false');
      });
      document.querySelectorAll('[role="tabpanel"][data-system]').forEach(p => p.classList.add('hidden'));

      btn.classList.add('active');
      btn.setAttribute('aria-selected', 'true');
      document.querySelector(`[role="tabpanel"][data-system="${btn.dataset.system}"]`).classList.remove('hidden');
    });
  });
</script>
