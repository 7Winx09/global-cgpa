---
import Layout from '@/layouts/Layout.astro';
import { getUniversitiesByCountry } from '@/data/universities-global';

const universities = getUniversitiesByCountry('KR');
const systems = [...new Set(universities.map(u => u.system))].sort((a, b) => parseFloat(b) - parseFloat(a));

const pageTitle = '학점계산기 | 한국 대학 평점 평균 계산';
const description = '한국 대학 학점계산기. 4.3 만점, 4.5 만점 지원. 서울대, 카이스트, 연세대, 고려대, 이화여대, 성균관대, 건국대 등 주요 대학 평점 체계 반영. 과목별 학점과 성적 입력으로 정확한 GPA 산출.';
const canonical = 'https://globalcgpa.in/ko/';
const ogImage = '/og-image-ko.png';
const lang = 'ko';
const alternates = [
  { hreflang: 'en', href: 'https://globalcgpa.in/' },
  { hreflang: 'ko', href: 'https://globalcgpa.in/ko/' },
];
---

<Layout title={pageTitle} description={description} canonical={canonical} ogImage={ogImage} lang={lang} alternates={alternates}>
  <main class="max-w-[780px] mx-auto px-6 py-14" style="flex:1;">
    <div class="text-xs font-bold uppercase tracking-wider text-emerald-500 mb-2">한국 대학 학점계산기</div>
    <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight mb-3">평점 평균(GPA) 계산기</h1>
    <p class="text-slate-500 dark:text-zinc-400 text-base mb-8">
      한국 대학의 4.3 만점(SNU, KAIST, 연세대, 이화여대 등) 및 4.5 만점(고려대, 성균관대, 건국대 등) 체계를 모두 지원합니다.
      과목별 학점과 등급을 입력하면 정확한 평점 평균을 산출합니다.
    </p>

    <div class="calc-shell space-y-6" id="gpa-calculator">
      <div class="flex gap-2" role="tablist" aria-label="만점 기준 선택">
        {systems.map((sys, idx) => (
          <button
            role="tab"
            aria-selected={idx === 0}
            aria-controls={`panel-${sys}`}
            id={`tab-${sys}`}
            class={`calc-tab flex-1 ${idx === 0 ? 'active' : ''}`}
            data-system={sys}
          >
            {sys} 만점
          </button>
        ))}
      </div>

      {systems.map((sys, idx) => (
        <div
          role="tabpanel"
          id={`panel-${sys}`}
          aria-labelledby={`tab-${sys}`}
          class={`space-y-4 ${idx === 0 ? '' : 'hidden'}`}
          data-system={sys}
        >
          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label class="calc-label" for={`system-select-${sys}`}>성적 체계</label>
              <select
                id={`system-select-${sys}`}
                class="calc-select"
                data-system={sys}
                aria-label={`${sys} 만점 성적 체계 선택`}
              >
                {universities.filter(u => u.system === sys).map(u => (
                  <option value={u.key}>{u.name} ({u.system} 만점)</option>
                ))}
                <option value="custom" selected>직접 입력 (표준 {sys} 만점)</option>
              </select>
            </div>
            <div>
              <label class="calc-label" for={`course-count-${sys}`}>과목 수</label>
              <input
                type="number"
                id={`course-count-${sys}`}
                class="calc-input"
                min="1"
                max="30"
                value="6"
                aria-label="과목 수 입력"
              />
            </div>
          </div>

          <div id={`courses-${sys}`} class="space-y-3" role="list" aria-label={`${sys} 만점 과목 목록`}></div>

          <button
            type="button"
            class="w-full sm:w-auto px-6 py-3 bg-emerald-500 hover:bg-emerald-600 text-slate-900 font-bold text-sm rounded-xl transition-colors"
            id={`calculate-${sys}`}
            data-system={sys}
          >
            평점 평균 계산
          </button>

          <div class="calc-output" aria-live="polite" aria-label={`${sys} 만점 계산 결과`}>
            <div class="calc-out-val" id={`result-${sys}`}>0.00</div>
            <div class="calc-out-lbl">평점 평균 (GPA)</div>
            <div class="calc-out-lbl" style="margin-top:8px; font-size:0.68rem;" id={`detail-${sys}`}>
              총 학점: 0 | 총 평점: 0.00
            </div>
          </div>

          <div class="formula-block" id={`formula-${sys}`}>
            <div class="f-label">계산 공식</div>
            <div class="f-text" id={`formula-text-${sys}`}>GPA = Σ(학점 × 평점) ÷ Σ학점</div>
            <div class="f-example" id={`formula-example-${sys}`}>예: 3학점 A+(4.3) + 3학점 B+(3.3) = (12.9+9.9)÷6 = 3.80</div>
          </div>
        </div>
      ))}

      <div class="border-t border-slate-200 dark:border-zinc-800 pt-6 space-y-3 text-sm text-slate-600 dark:text-zinc-400">
        <h3 class="font-bold text-slate-900 dark:text-white">사용 안내</h3>
        <ul class="list-disc list-inside space-y-1">
          <li>대학별 성적 체계(4.3/4.5)는 탭에서 선택하세요.</li>
          <li>「직접 입력」 선택 시 표준 등급 체계가 적용됩니다.</li>
          <li>대학별 세부 환산표는 <a href="/ko/대학-학점계산기" class="underline hover:text-emerald-500">대학별 학점계산기</a>에서 확인하세요.</li>
          <li>P/F, S/U 과목은 평점 평균 산출에서 제외됩니다.</li>
          <li>재수강 과목은 대학 규정에 따라 상위 성적만 반영되거나 제한이 있을 수 있습니다.</li>
        </ul>
      </div>
    </div>

    <section class="mt-16" aria-labelledby="univ-list-heading">
      <h2 id="univ-list-heading" class="text-2xl font-extrabold tracking-tight mb-6">주요 대학 바로가기</h2>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {universities.map(u => (
          <a
            href={`/ko/${u.slug}`}
            class="calc-shell p-5 hover:border-emerald-500 hover:shadow-lg transition-all text-center"
          >
            <div class="text-3xl font-extrabold text-emerald-500 mb-1">{u.system} 만점</div>
            <div class="font-bold text-lg text-slate-900 dark:text-white">{u.name}</div>
            <div class="text-sm text-slate-500 dark:text-zinc-400 mt-1">{u.nameEn}</div>
          </a>
        ))}
      </div>
    </section>

    <section class="mt-16" aria-labelledby="guides-heading">
      <h2 id="guides-heading" class="text-2xl font-extrabold tracking-tight mb-6">학점·성적 가이드</h2>
      <div class="grid gap-4 sm:grid-cols-2">
        <a href="/ko/guides/4-3-vs-4-5" class="calc-shell p-5 hover:border-emerald-500 transition-all">
          <h3 class="font-bold text-lg text-slate-900 dark:text-white mb-2">4.3 만점 vs 4.5 만점 차이</h3>
          <p class="text-sm text-slate-500 dark:text-zinc-400">두 체계의 등급 차이와 환산 방법, 성적증명서 발급 시 선택 기준</p>
        </a>
        <a href="/ko/guides/absolute-relative" class="calc-shell p-5 hover:border-emerald-500 transition-all">
          <h3 class="font-bold text-lg text-slate-900 dark:text-white mb-2">절대평가 vs 상대평가</h3>
          <p class="text-sm text-slate-500 dark:text-zinc-400">한국 대학의 평가 방식 차이와 성적 분포, 학점 인플레이션 대응</p>
        </a>
        <a href="/ko/guides/retake-policy" class="calc-shell p-5 hover:border-emerald-500 transition-all">
          <h3 class="font-bold text-lg text-slate-900 dark:text-white mb-2">재수강 성적 반영 규정</h3>
          <p class="text-sm text-slate-500 dark:text-zinc-400">대학별 재수강 시 상한선(A0, B+ 등)과 성적표 표기(R 표시) 규칙</p>
        </a>
        <a href="/ko/guides/transfer-credit" class="calc-shell p-5 hover:border-emerald-500 transition-all">
          <h3 class="font-bold text-lg text-slate-900 dark:text-white mb-2">편입·교환학점 인정 기준</h3>
          <p class="text-sm text-slate-500 dark:text-zinc-400">타 대학/해외 대학 학점 인정 시 평점 환산과 최소 이수 학점 규정</p>
        </a>
        <a href="/ko/guides/graduation-honors" class="calc-shell p-5 hover:border-emerald-500 transition-all">
          <h3 class="font-bold text-lg text-slate-900 dark:text-white mb-2">졸업 우등 기준 (Summa/Magna Cum Laude)</h3>
          <p class="text-sm text-slate-500 dark:text-zinc-400">대학별 최우등(4.0+), 우등(3.75+) 졸업 요건과 표기 방식</p>
        </a>
        <a href="/ko/guides/academic-warning" class="calc-shell p-5 hover:border-emerald-500 transition-all">
          <h3 class="font-bold text-lg text-slate-900 dark:text-white mb-2">학사경고·제적 기준</h3>
          <p class="text-sm text-slate-500 dark:text-zinc-400">평점평균 미달 시 경고 횟수, 제적 기준, 복학 후 재경고 규정</p>
        </a>
      </div>
    </section>
  </main>
</Layout>

<script is:inline>
  const GRADE_SYSTEMS = {
    '4.3': {
      grades: ['A+', 'A0', 'A-', 'B+', 'B0', 'B-', 'C+', 'C0', 'C-', 'D+', 'D0', 'D-', 'F'],
      points: { 'A+': 4.3, 'A0': 4.0, 'A-': 3.7, 'B+': 3.3, 'B0': 3.0, 'B-': 2.7, 'C+': 2.3, 'C0': 2.0, 'C-': 1.7, 'D+': 1.3, 'D0': 1.0, 'D-': 0.7, 'F': 0.0 },
      percentages: { 'A+': [95, 100], 'A0': [90, 94], 'A-': [85, 89], 'B+': [80, 84], 'B0': [75, 79], 'B-': [70, 74], 'C+': [65, 69], 'C0': [60, 64], 'C-': [55, 59], 'D+': [50, 54], 'D0': [45, 49], 'D-': [40, 44], 'F': [0, 39] }
    },
    '4.5': {
      grades: ['A+', 'A', 'B+', 'B', 'C+', 'C', 'D+', 'D', 'F'],
      points: { 'A+': 4.5, 'A': 4.0, 'B+': 3.5, 'B': 3.0, 'C+': 2.5, 'C': 2.0, 'D+': 1.5, 'D': 1.0, 'F': 0.0 },
      percentages: { 'A+': [95, 100], 'A': [90, 94], 'B+': [85, 89], 'B': [80, 84], 'C+': [75, 79], 'C': [70, 74], 'D+': [65, 69], 'D': [60, 64], 'F': [0, 59] }
    }
  };

  function createCourseRow(system, index) {
    const sys = GRADE_SYSTEMS[system];
    const grades = sys.grades;
    const points = sys.points;
    const percentages = sys.percentages;

    const row = document.createElement('div');
    row.className = 'grid gap-3 sm:grid-cols-[1fr_80px_100px] items-end';
    row.setAttribute('role', 'listitem');
    row.innerHTML = `
      <div>
        <label class="calc-label" for="grade-${system}-${index}">과목 ${index + 1} 등급</label>
        <select id="grade-${system}-${index}" class="calc-select grade-select" aria-label="과목 ${index + 1} 등급">
          ${grades.map(g => `<option value="${g}">${g} (${points[g]}) ${percentages[g] ? `↔ ${percentages[g][0]}~${percentages[g][1]}%` : ''}</option>`).join('')}
        </select>
      </div>
      <div>
        <label class="calc-label" for="credit-${system}-${index}">학점</label>
        <input type="number" id="credit-${system}-${index}" class="calc-input credit-input" value="3" min="1" max="6" step="1" aria-label="과목 ${index + 1} 학점" />
      </div>
      <div>
        <label class="calc-label" for="course-name-${system}-${index}">과목명 (선택)</label>
        <input type="text" id="course-name-${system}-${index}" class="calc-input" placeholder="예: 미분적분학" aria-label="과목 ${index + 1} 이름" />
      </div>
    `;
    return row;
  }

  function renderCourses(system, count) {
    const container = document.getElementById(`courses-${system}`);
    container.innerHTML = '';
    for (let i = 0; i < count; i++) {
      container.appendChild(createCourseRow(system, i));
    }
  }

  function calculateGPA(system) {
    const sys = GRADE_SYSTEMS[system];
    const points = sys.points;
    const gradeSelects = document.querySelectorAll(`#courses-${system} .grade-select`);
    const creditInputs = document.querySelectorAll(`#courses-${system} .credit-input`);

    let totalCredits = 0;
    let totalPoints = 0;

    gradeSelects.forEach((select, i) => {
      const grade = select.value;
      const credit = parseFloat(creditInputs[i].value) || 0;
      const point = points[grade] || 0;

      totalCredits += credit;
      totalPoints += credit * point;
    });

    const gpa = totalCredits > 0 ? totalPoints / totalCredits : 0;
    document.getElementById(`result-${system}`).textContent = gpa.toFixed(2);
    document.getElementById(`detail-${system}`).textContent = `총 학점: ${totalCredits} | 총 평점: ${totalPoints.toFixed(2)}`;
  }

  function initSystem(system) {
    const countInput = document.getElementById(`course-count-${system}`);
    const calculateBtn = document.getElementById(`calculate-${system}`);
    const systemSelect = document.getElementById(`system-select-${system}`);

    let currentCount = parseInt(countInput.value) || 6;
    renderCourses(system, currentCount);
    calculateGPA(system);

    countInput.addEventListener('input', () => {
      let newCount = parseInt(countInput.value) || 1;
      newCount = Math.max(1, Math.min(30, newCount));
      currentCount = newCount;
      renderCourses(system, newCount);
      calculateGPA(system);
    });

    calculateBtn.addEventListener('click', () => calculateGPA(system));

    container = document.getElementById(`courses-${system}`);
    container.addEventListener('change', e => {
      if (e.target.matches('.grade-select, .credit-input')) {
        calculateGPA(system);
      }
    });

    systemSelect.addEventListener('change', () => {
      if (systemSelect.value === 'custom') return;
      // 대학별 프리셋 로드 로직은 추후 확장
    });
  }

  function switchTab(system) {
    document.querySelectorAll('[role="tab"]').forEach(btn => {
      btn.classList.remove('active');
      btn.setAttribute('aria-selected', 'false');
    });
    document.querySelectorAll('[role="tabpanel"]').forEach(panel => panel.classList.add('hidden'));

    const activeTab = document.getElementById(`tab-${system}`);
    const activePanel = document.querySelector(`[role="tabpanel"][data-system="${system}"]`);
    activeTab.classList.add('active');
    activeTab.setAttribute('aria-selected', 'true');
    activePanel.classList.remove('hidden');
  }

  document.querySelectorAll('[role="tab"]').forEach(btn => {
    btn.addEventListener('click', () => switchTab(btn.dataset.system));
  });

  systems.forEach(sys => initSystem(sys));
</script>
