---
import Layout from '../../../../layouts/Layout.astro';

const pageTitle = '절대평가 vs 상대평가 | 한국 대학 성적 평가 제도';
const description = '한국 대학의 절대평가와 상대평가 차이, 운영 방식, 성적 분포, 학점 인플레이션 대응 등 종합 가이드.';
const canonical = 'https://globalcgpa.in/ko/guides/absolute-relative';
const ogImage = '/og-image-ko.png';
const lang = 'ko';
const alternates = [
  { hreflang: 'en', href: 'https://globalcgpa.in/guides/absolute-relative' },
  { hreflang: 'ko', href: 'https://globalcgpa.in/ko/guides/absolute-relative' },
];
---

<Layout title={pageTitle} description={description} canonical={canonical} ogImage={ogImage} lang={lang} alternates={alternates}>
  <main class="max-w-[780px] mx-auto px-6 py-14" style="flex:1;">
    <nav class="crumbs mb-6" aria-label="브레드크럼">
      <a href="/ko/">학점계산기</a>
      <span class="sep">/</span>
      <a href="/ko/guides">가이드</a>
      <span class="sep">/</span>
      <span class="current">절대평가 vs 상대평가</span>
    </nav>

    <div class="text-xs font-bold uppercase tracking-wider text-emerald-500 mb-2">가이드</div>
    <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight mb-3">절대평가 vs 상대평가 — 한국 대학 성적 평가 제도 완벽 이해</h1>
    <p class="text-slate-500 dark:text-zinc-400 text-base mb-10">
      한국 대학은 절대평가(기준참조)와 상대평가(규준참조)를 혼용하거나 병행합니다.
      각 평가 방식의 차이와 내 성적에 미치는 영향을 이해하는 것이 중요합니다.
    </p>

    <section class="prose mb-12">
      <h2>핵심 차이 비교</h2>
      <div class="table-scroll">
        <table>
          <thead>
            <tr>
              <th>구분</th>
              <th>절대평가 (기준참조)</th>
              <th>상대평가 (규준참조)</th>
            </tr>
          </thead>
          <tbody>
            <tr><td><strong>기준</strong></td><td>미리 정해진 점수/성취 기준</td><td>동일 집단 내 상대적 순위</td></tr>
            <tr><td><strong>A+ 비율</strong></td><td>기준 충족 시 누구나 가능</td><td>상위 10~30% 제한 (대학별 상이)</td></tr>
            <tr><td><strong>경쟁 유도</strong></td><td>낮음 (협력 학습 유리)</td><td>높음 (경쟁 심화)</td></tr>
            <tr><td><strong>성적 인플레이션</strong></td><td>발생 가능성 높음</td><td>비율 제한으로 억제</td></tr>
            <tr><td><strong>주 적용 과목</strong></td><td>전공 필수, 실습, 어학, 소규모 강의</td><td>대형 교양, 전공 핵심, 필수 과목</td></tr>
            <tr><td><strong>교수 재량</strong></td><td>높음 (기준 설정 권한)</td><td>제한적 (분포 준수 의무)</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="prose mb-12">
      <h2>대학별 운영 현황</h2>
      <ul>
        <li><strong>서울대(SNU):</strong> 2018년부터 교양 글쓰기 등 절대평가 전환 확대. 2023년 현재 교양/전공 혼용 운영.</li>
        <li><strong>연세대:</strong> UIC 등 영어강의 절대평가. 일반 전공은 상대평가(상위 30% A, 40% B, 30% C 이하) 원칙.</li>
        <li><strong>고려대:</strong> ISC(국제하계학기) 절대평가. 정규 학기 상대평가 원칙.</li>
        <li><strong>이화여대:</strong> A학점 0~35%, B학점 20~40% 비율 가이드라인 제시 (교수 재량으로 조정 가능).</li>
        <li><strong>KAIST:</strong> 연구과목 S/U, 일반 과목 상대평가 기반.</li>
      </ul>
    </section>

    <section class="prose mb-12">
      <h2>내 성적에 미치는 영향</h2>
      <h3>상대평가 과목에서 주의할 점</h3>
      <ul>
        <li>실력이 좋아도 동기들이 더 잘하면 낮은 등급 받을 수 있음</li>
        <li>과목 선택 시 "절대평가 과목" 여부 확인 전략 필요</li>
        <li>팀플/발표 비중 높은 과목은 절대평가일 확률 높음</li>
      </ul>
      <h3>절대평가 과목에서 주의할 점</h3>
      <ul>
        <li>기준 점수(보통 95점=A+)를 넘지 못하면 실력 대비 낮은 등급</li>
        <li>교수별 기준 차이가 클 수 있음 (강의계획서 필독)</li>
        <li>전원 A+ 가능하지만, 실제로는 소수만 달성하는 경우가 많음</li>
      </ul>
    </section>

    <section class="prose mb-12">
      <h2>학점 인플레이션과 대학 대응</h2>
      <p>1997년 외환위기 이후 취업난 심화로 성적 인플레이션이 사회적 문제화되었습니다. 정부(교육부)는 상대평가 의무화를 통해 대응했으나, 최근 다시 절대평가 확대 추세입니다.</p>
      <div class="bg-slate-50 dark:bg-zinc-900 border border-slate-200 dark:border-zinc-800 rounded-xl p-6">
        <h3 class="font-bold mb-3">주요 연혁</h3>
        <ul class="list-disc list-inside space-y-1">
          <li>1990년대 후반: 대부분 절대평가 → 성적 인플레이션 심화</li>
          <li>2000년대 초반: 교육부 상대평가 권고/강제 (A 30%, B 40%, C 30% 등)</li>
          <li>2010년대: 대학별 완화 (절대평가 과목 확대)</li>
          <li>2018년~: 서울대 등 주요 대학 교양/소규모 강의 절대평가 전환</li>
          <li>현재: 대학·학과·과목별 혼용 운영이 일반적</li>
        </ul>
      </div>
    </section>

    <section class="prose mb-12">
      <h2>자주 묻는 질문 (FAQ)</h2>
      <details class="faq-row">
        <summary>내 과목이 절대평가인지 상대평가인지 어떻게 아나요?</summary>
        <div class="faq-body">
          <p>강의계획서(실러버스) 첫 페이지에 '평가 방식: 절대평가/상대평가'가 명시되어 있습니다. 없으면 담당 교수님께 직접 문의하세요. 수강신청 전 학교 수업정보시스템에서도 확인 가능합니다.</p>
        </div>
      </details>
      <details class="faq-row">
        <summary>상대평가에서 A+를 받으려면 몇 등이어야 하나요?</summary>
        <div class="faq-body">
          <p>대학·학과·과목마다 다릅니다. 일반적인 가이드라인은 상위 10~20%입니다. 50명 수업이면 5~10등 안에 들어야 합니다. 정확한 비율은 강의계획서나 학과 사무실로 문의하세요.</p>
        </div>
      </details>
      <details class="faq-row">
        <summary>절대평가인데 교수님이 A+를 거의 안 주세요. 이의신청 가능한가요?</summary>
        <div class="faq-body">
          <p>절대평가는 교수 재량권이 큽니다. 단, 강의계획서에 공지된 기준(예: 95점 이상 A+)과 실제 채점 기준이 다르다면 이의신청 사유가 됩니다. 성적 정정 기간(보통 종강 후 1주일 내)에 정식 절차로 이의제기하세요.</p>
        </div>
      </details>
      <details class="faq-row">
        <summary>P/F(Pass/Fail) 과목은 절대평가인가요?</summary>
        <div class="faq-body">
          <p>네. P/F 과목은 정해진 기준(보통 60점 또는 70점 이상)만 넘으면 Pass로 처리됩니다. 평점 평균(GPA) 산출에는 포함되지 않으나, 졸업 이수 학점에는 포함됩니다.</p>
        </div>
      </details>
    </section>

    <section class="prose">
      <h2>실전 팁: 수강신청 전략</h2>
      <ol>
        <li><strong>강의계획서 필독:</strong> 평가 방식, 출석 기준, 과제 비중 확인</li>
        <li><strong>선배 후기 활용:</strong> 에브리타임, 학과 커뮤니티에서 '이 과목 절대평가야? 상대평가야?' 검색</li>
        <li><strong>분산 전략:</strong> 한 학기 모든 과목이 상대평가면 부담 큼. 절대평가 과목 1~2개 섞기</li>
        <li><strong>팀플 회피/선호:</strong> 팀플 비중 높으면 절대평가일 확률 높음. 팀플 선호도에 따라 선택</li>
      </ol>
    </section>
  </main>
</Layout>