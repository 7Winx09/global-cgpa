---
import Layout from '@/layouts/Layout.astro';
import { getUniversitiesByCountry } from '@/data/universities-global';

const universities = getUniversitiesByCountry('EG').concat(
  getUniversitiesByCountry('JO'),
  getUniversitiesByCountry('SA'),
  getUniversitiesByCountry('AE'),
  getUniversitiesByCountry('LB')
);

const systems = [...new Set(universities.map(u => u.system))].sort((a, b) => parseFloat(b) - parseFloat(a));

const pageTitle = 'حاسبة المعدل التراكمي GPA | الجامعات العربية (مصر، الأردن، السعودية، الإمارات، لبنان)';
const description = 'احسب المعدل التراكمي (GPA) للجامعات العربية: الجامعة الأمريكية بالقاهرة، جامعة القاهرة، الجامعة الأردنية، جامعة الملك سعود، KAUST، KFUPM، جامعة الإمارات، جامعة خليفة، AUB، LAU، USJ. أنظمة 4.0 و 5.0 و 20.0.';
const canonical = 'https://globalcgpa.in/ar/';
const ogImage = '/og-image-ar.png';
const lang = 'ar';
const alternates = [
  { hreflang: 'en', href: 'https://globalcgpa.in/' },
  { hreflang: 'ar', href: 'https://globalcgpa.in/ar/' },
];
---

<Layout title={pageTitle} description={description} canonical={canonical} ogImage={ogImage} lang={lang} alternates={alternates}>
  <main class="max-w-[780px] mx-auto px-6 py-14" style="flex:1;">
    <div class="text-xs font-bold uppercase tracking-wider text-emerald-500 mb-2">حاسبة المعدل التراكمي GPA — المنطقة العربية</div>
    <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight mb-3">حاسبة المعدل التراكمي (GPA) للجامعات العربية</h1>
    <p class="text-slate-500 dark:text-zinc-400 text-base mb-8">
      تدعم أنظمة التقدير المختلفة في المنطقة العربية: مقياس 4.0 (النظام الأمريكي — مصر، الأردن، الإمارات، لبنان)، مقياس 5.0 (السعودية — جامعة الملك سعود)، مقياس 20.0 (النظام الفرنسي — USJ). أدخل الدرجات الحرفية والساعات المعتمدة لحساب المعدل بدقة.
    </p>

    <div class="calc-shell space-y-6" id="gpa-calculator">
      <div class="flex gap-2" role="tablist" aria-label="اختر نظام التقدير">
        {systems.map((sys, idx) => (
          <button
            role="tab"
            aria-selected={idx === 0}
            aria-controls={`panel-${sys}`}
            id={`tab-${sys}`}
            class={`calc-tab flex-1 ${idx === 0 ? 'active' : ''}`}
            data-system={sys}
          >
            مقياس {sys}
          </button>
        ))}
      </div>

      {systems.map((sys, idx) => (
        <div
          role="tabpanel"
          id={`panel-${sys}`}
          aria-labelledby={`tab-${sys}`}
          class={`space-y-4 ${idx === 0 ? '' : 'hidden'}`}
          data-system={sys}
        >
          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label class="calc-label" for={`system-select-${sys}`}>نظام التقدير</label>
              <select
                id={`system-select-${sys}`}
                class="calc-select"
                data-system={sys}
                aria-label={`اختر نظام التقدير ${sys}`}
              >
                {universities.filter(u => u.system === sys).map(u => (
                  <option value={u.key}>{u.name} ({u.system})</option>
                ))}
                <option value="custom" selected>إدخال يدوي (مقياس {sys} قياسي)</option>
              </select>
            </div>
            <div>
              <label class="calc-label" for={`course-count-${sys}`}>عدد المواد</label>
              <input
                type="number"
                id={`course-count-${sys}`}
                class="calc-input"
                min="1"
                max="30"
                value="6"
                aria-label="عدد المواد"
              />
            </div>
          </div>

          <div id={`courses-${sys}`} class="space-y-3" role="list" aria-label={`قائمة المواد ${sys}`}></div>

          <button
            type="button"
            class="w-full sm:w-auto px-6 py-3 bg-emerald-500 hover:bg-emerald-600 text-slate-900 font-bold text-sm rounded-xl transition-colors"
            id={`calculate-${sys}`}
            data-system={sys}
          >
            احسب المعدل
          </button>

          <div class="calc-output" aria-live="polite" aria-label={`نتيجة الحساب ${sys}`}>
            <div class="calc-out-val" id={`result-${sys}`}>0.00</div>
            <div class="calc-out-lbl">المعدل التراكمي (GPA)</div>
            <div class="calc-out-lbl" style="margin-top:8px; font-size:0.68rem;" id={`detail-${sys}`}>
              إجمالي الساعات: 0 | إجمالي النقاط: 0.00
            </div>
          </div>

          <div class="formula-block" id={`formula-${sys}`}>
            <div class="f-label">صيغة الحساب</div>
            <div class="f-text" id={`formula-text-${sys}`}>GPA = Σ(ساعات × نقاط) ÷ Σساعات</div>
            <div class="f-example" id={`formula-example-${sys}`}>مثال: 3 ساعات أ(4.0) + 3 ساعات ب+(3.3) = (12+9.9)÷6 = 3.65</div>
          </div>
        </div>
      ))}
    </div>

    <section class="mt-16" aria-labelledby="countries-heading">
      <h2 id="countries-heading" class="text-2xl font-extrabold tracking-tight mb-6">الجامعات حسب الدولة</h2>
      <div class="space-y-6">
        <div>
          <h3 class="text-xl font-bold text-slate-700 dark:text-slate-300 mb-3 flex items-center gap-2">🇪🇬 مصر <span class="text-sm font-normal text-slate-500">(مقياس 4.0)</span></h3>
          <div class="grid gap-3 sm:grid-cols-2">
            <a href="/ar/american-university-cairo-gpa" class="calc-shell p-4 hover:border-emerald-500 transition-all text-center">الجامعة الأمريكية بالقاهرة — 4.0</a>
            <a href="/ar/cairo-university-gpa" class="calc-shell p-4 hover:border-emerald-500 transition-all text-center">جامعة القاهرة — 4.0</a>
          </div>
        </div>
        <div>
          <h3 class="text-xl font-bold text-slate-700 dark:text-slate-300 mb-3 flex items-center gap-2">🇯🇴 الأردن <span class="text-sm font-normal text-slate-500">(مقياس 4.0 — 11 درجة)</span></h3>
          <div class="grid gap-3 sm:grid-cols-2">
            <a href="/ar/university-of-jordan-gpa" class="calc-shell p-4 hover:border-emerald-500 transition-all text-center">الجامعة الأردنية — 4.0</a>
            <a href="/ar/german-jordanian-university-gpa" class="calc-shell p-4 hover:border-emerald-500 transition-all text-center">الجامعة الألمانية الأردنية — 4.0</a>
          </div>
        </div>
        <div>
          <h3 class="text-xl font-bold text-slate-700 dark:text-slate-300 mb-3 flex items-center gap-2">🇸🇦 السعودية <span class="text-sm font-normal text-slate-500">(مقياس 5.0 و 4.0)</span></h3>
          <div class="grid gap-3 sm:grid-cols-3">
            <a href="/ar/king-saud-university-gpa" class="calc-shell p-4 hover:border-emerald-500 transition-all text-center">جامعة الملك سعود — 5.0</a>
            <a href="/ar/kaust-gpa" class="calc-shell p-4 hover:border-emerald-500 transition-all text-center">KAUST — 4.0</a>
            <a href="/ar/kfupm-gpa" class="calc-shell p-4 hover:border-emerald-500 transition-all text-center">جامعة الملك فهد — 4.0</a>
          </div>
        </div>
        <div>
          <h3 class="text-xl font-bold text-slate-700 dark:text-slate-300 mb-3 flex items-center gap-2">🇦🇪 الإمارات <span class="text-sm font-normal text-slate-500">(مقياس 4.0)</span></h3>
          <div class="grid gap-3 sm:grid-cols-3">
            <a href="/ar/uae-university-gpa" class="calc-shell p-4 hover:border-emerald-500 transition-all text-center">جامعة الإمارات — 4.0</a>
            <a href="/ar/khalifa-university-gpa" class="calc-shell p-4 hover:border-emerald-500 transition-all text-center">جامعة خليفة — 4.0</a>
            <a href="/ar/american-university-sharjah-gpa" class="calc-shell p-4 hover:border-emerald-500 transition-all text-center">الجامعة الأمريكية بالشارقة — 4.0</a>
          </div>
        </div>
        <div>
          <h3 class="text-xl font-bold text-slate-700 dark:text-slate-300 mb-3 flex items-center gap-2">🇱🇧 لبنان <span class="text-sm font-normal text-slate-500">(مقياس 4.0 و 20.0)</span></h3>
          <div class="grid gap-3 sm:grid-cols-3">
            <a href="/ar/american-university-beirut-gpa" class="calc-shell p-4 hover:border-emerald-500 transition-all text-center">الجامعة الأمريكية في بيروت — 4.0</a>
            <a href="/ar/lebanese-american-university-gpa" class="calc-shell p-4 hover:border-emerald-500 transition-all text-center">الجامعة اللبنانية الأمريكية — 4.0</a>
            <a href="/ar/saint-joseph-university-gpa" class="calc-shell p-4 hover:border-emerald-500 transition-all text-center">جامعة القديس يوسف — 20.0</a>
          </div>
        </div>
      </div>
    </section>

    <section class="mt-16" aria-labelledby="guides-heading">
      <h2 id="guides-heading" class="text-2xl font-extrabold tracking-tight mb-6">أدلة ونظم التقدير</h2>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <a href="/ar/guides/gpa-systems-mena" class="calc-shell p-5 hover:border-emerald-500 transition-all">
          <h3 class="font-bold text-lg text-slate-900 dark:text-white mb-2">أنظمة التقدير في المنطقة العربية</h3>
          <p class="text-sm text-slate-500 dark:text-zinc-400">مقارنة 4.0 أمريكي، 5.0 خليجي، 20.0 فرنسي، 100% مصري</p>
        </a>
        <a href="/ar/guides/grading-conversion" class="calc-shell p-5 hover:border-emerald-500 transition-all">
          <h3 class="font-bold text-lg text-slate-900 dark:text-white mb-2">تحويل الدرجات بين الأنظمة</h3>
          <p class="text-sm text-slate-500 dark:text-zinc-400">جداول تحويل: 4.0 ↔ 5.0 ↔ 20.0 ↔ نسبة مئوية</p>
        </a>
        <a href="/ar/guides/academic-standing" class="calc-shell p-5 hover:border-emerald-500 transition-all">
          <h3 class="font-bold text-lg text-slate-900 dark:text-white mb-2">الوضع الأكاديمي والإنذار</h3>
          <p class="text-sm text-slate-500 dark:text-zinc-400">شروط الإنذار، الفصل، مرتبة الشرف، والتخرج</p>
        </a>
        <a href="/ar/guides/international-recognition" class="calc-shell p-5 hover:border-emerald-500 transition-all">
          <h3 class="font-bold text-lg text-slate-900 dark:text-white mb-2">الاعتراف الدولي بالمعدلات العربية</h3>
          <p class="text-sm text-slate-500 dark:text-zinc-400">تحويل GPA عربي إلى أمريكي، أوروبي، كندي، أسترالي</p>
        </a>
        <a href="/ar/guides/scholarship-requirements" class="calc-shell p-5 hover:border-emerald-500 transition-all">
          <h3 class="font-bold text-lg text-slate-900 dark:text-white mb-2">متطلبات المنح الدراسية</h3>
          <p class="text-sm text-slate-500 dark:text-zinc-400">GPA المطلوب لـ: فولبرايت، تشيفنينغ، DAAD، MEXT، GKS</p>
        </a>
      </div>
    </section>
  </main>
</Layout>

<script is:inline>
  const GRADE_SYSTEMS = {
    '4.0': {
      grades: ['A+', 'A', 'A-', 'B+', 'B', 'B-', 'C+', 'C', 'C-', 'D', 'F'],
      points: { 'A+': 4.0, 'A': 4.0, 'A-': 3.7, 'B+': 3.3, 'B': 3.0, 'B-': 2.7, 'C+': 2.3, 'C': 2.0, 'C-': 1.7, 'D': 1.0, 'F': 0.0 },
      percentages: { 'A+': [95, 100], 'A': [90, 94], 'A-': [85, 89], 'B+': [80, 84], 'B': [75, 79], 'B-': [70, 74], 'C+': [65, 69], 'C': [60, 64], 'C-': [55, 59], 'D': [50, 54], 'F': [0, 49] }
    },
    '5.0': {
      grades: ['A+', 'A', 'B+', 'B', 'C+', 'C', 'D+', 'D', 'F'],
      points: { 'A+': 5.0, 'A': 4.75, 'B+': 4.5, 'B': 4.0, 'C+': 3.5, 'C': 3.0, 'D+': 2.5, 'D': 2.0, 'F': 1.0 },
      percentages: { 'A+': [95, 100], 'A': [90, 94], 'B+': [85, 89], 'B': [80, 84], 'C+': [75, 79], 'C': [70, 74], 'D+': [65, 69], 'D': [60, 64], 'F': [0, 59] }
    },
    '20.0': {
      grades: ['A', 'B', 'C', 'D', 'E', 'F'],
      points: { 'A': 18.0, 'B': 16.0, 'C': 14.0, 'D': 12.0, 'E': 10.0, 'F': 8.0 },
      percentages: { 'A': [18, 20], 'B': [16, 17], 'C': [14, 15], 'D': [12, 13], 'E': [10, 11], 'F': [0, 9] }
    }
  };

  function createCourseRow(system, index) {
    const sys = GRADE_SYSTEMS[system];
    const grades = sys.grades;
    const points = sys.points;
    const percentages = sys.percentages;

    const row = document.createElement('div');
    row.className = 'grid gap-3 sm:grid-cols-[1fr_80px_100px] items-end';
    row.setAttribute('role', 'listitem');
    row.innerHTML = `
      <div>
        <label class="calc-label" for="grade-${system}-${index}">المادة ${index + 1} - التقدير</label>
        <select id="grade-${system}-${index}" class="calc-select grade-select" aria-label="المادة ${index + 1} التقدير">
          ${grades.map(g => `<option value="${g}">${g} (${points[g]}) ${percentages[g] ? `↔ ${percentages[g][0]}~${percentages[g][1]}%` : ''}</option>`).join('')}
        </select>
      </div>
      <div>
        <label class="calc-label" for="credit-${system}-${index}">الساعات</label>
        <input type="number" id="credit-${system}-${index}" class="calc-input credit-input" value="3" min="1" max="6" step="1" aria-label="المادة ${index + 1} الساعات" />
      </div>
      <div>
        <label class="calc-label" for="course-name-${system}-${index}">اسم المادة (اختياري)</label>
        <input type="text" id="course-name-${system}-${index}" class="calc-input" placeholder="مثال: حساب التفاضل" aria-label="المادة ${index + 1} الاسم" />
      </div>
    `;
    return row;
  }

  function renderCourses(system, count) {
    const container = document.getElementById(`courses-${system}`);
    container.innerHTML = '';
    for (let i = 0; i < count; i++) {
      container.appendChild(createCourseRow(system, i));
    }
  }

  function calculateGPA(system) {
    const sys = GRADE_SYSTEMS[system];
    const points = sys.points;
    const gradeSelects = document.querySelectorAll(`#courses-${system} .grade-select`);
    const creditInputs = document.querySelectorAll(`#courses-${system} .credit-input`);

    let totalCredits = 0;
    let totalPoints = 0;

    gradeSelects.forEach((select, i) => {
      const grade = select.value;
      const credit = parseFloat(creditInputs[i].value) || 0;
      const point = points[grade] || 0;

      totalCredits += credit;
      totalPoints += credit * point;
    });

    const gpa = totalCredits > 0 ? totalPoints / totalCredits : 0;
    document.getElementById(`result-${system}`).textContent = gpa.toFixed(2);
    document.getElementById(`detail-${system}`).textContent = `إجمالي الساعات: ${totalCredits} | إجمالي النقاط: ${totalPoints.toFixed(2)}`;
  }

  function initSystem(system) {
    const countInput = document.getElementById(`course-count-${system}`);
    const calculateBtn = document.getElementById(`calculate-${system}`);
    const systemSelect = document.getElementById(`system-select-${system}`);

    let currentCount = parseInt(countInput.value) || 6;
    renderCourses(system, currentCount);
    calculateGPA(system);

    countInput.addEventListener('input', () => {
      let newCount = parseInt(countInput.value) || 1;
      newCount = Math.max(1, Math.min(30, newCount));
      currentCount = newCount;
      renderCourses(system, newCount);
      calculateGPA(system);
    });

    calculateBtn.addEventListener('click', () => calculateGPA(system));

    const container = document.getElementById(`courses-${system}`);
    container.addEventListener('change', e => {
      if (e.target.matches('.grade-select, .credit-input')) {
        calculateGPA(system);
      }
    });

    systemSelect.addEventListener('change', () => {
      if (systemSelect.value === 'custom') return;
    });
  }

  function switchTab(system) {
    document.querySelectorAll('[role="tab"]').forEach(btn => {
      btn.classList.remove('active');
      btn.setAttribute('aria-selected', 'false');
    });
    document.querySelectorAll('[role="tabpanel"]').forEach(panel => panel.classList.add('hidden'));

    const activeTab = document.getElementById(`tab-${system}`);
    const activePanel = document.querySelector(`[role="tabpanel"][data-system="${system}"]`);
    activeTab.classList.add('active');
    activeTab.setAttribute('aria-selected', 'true');
    activePanel.classList.remove('hidden');
  }

  document.querySelectorAll('[role="tab"]').forEach(btn => {
    btn.addEventListener('click', () => switchTab(btn.dataset.system));
  });

  systems.forEach(sys => initSystem(sys));
</script>
