---
import Layout from '@/layouts/Layout.astro';
import { getUniversityByKey } from '@/data/universities-global';

const univ = getUniversityByKey('ae-uaeu')!;
const pageTitle = `${univ.name} | حاسبة GPA ${univ.system} (أول جامعة في الإمارات)`;
const description = `${univ.name} (UAEU) حاسبة GPA. نظام ${univ.system} أمريكي. أول جامعة في الإمارات العربية المتحدة.`;
const canonical = `https://globalcgpa.in/ar/${univ.slug}`;
const ogImage = '/og-image-ar.png';
const lang = 'ar';
const alternates = [
  { hreflang: 'en', href: 'https://globalcgpa.in/university/uae' },
  { hreflang: 'ar', href: `https://globalcgpa.in/ar/${univ.slug}` },
];
---

<Layout title={pageTitle} description={description} canonical={canonical} ogImage={ogImage} lang={lang} alternates={alternates}>
  <main class="max-w-[780px] mx-auto px-6 py-14" style="flex:1;">
    <nav class="crumbs mb-6" aria-label="Breadcrumb">
      <a href="/ar/">حاسبة GPA العربية</a>
      <span class="sep">/</span>
      <a href="/ar/universities">الجامعات</a>
      <span class="sep">/</span>
      <span class="current">{univ.name}</span>
    </nav>

    <div class="text-xs font-bold uppercase tracking-wider text-emerald-500 mb-2">{univ.name} ({univ.nameEn})</div>
    <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight mb-3">{univ.name} — حاسبة GPA</h1>
    <p class="text-slate-500 dark:text-zinc-400 text-base mb-8">
      {univ.name} أول جامعة في الإمارات. نظام ${univ.system} أمريكي. أدخل الدرجات الحرفية والساعات لحساب GPA.
    </p>

    <div class="calc-shell space-y-6" id="univ-gpa-calculator">
      <div class="flex items-center gap-3">
        <span class="px-3 py-1 bg-emerald-100 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-300 text-xs font-bold rounded-full">
          {univ.system}
        </span>
        <span class="text-sm text-slate-500 dark:text-zinc-400">التقديرات: A, A-, B+, B, B-, C+, C, C-, D, F</span>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <label class="calc-label" for="course-count">عدد المواد</label>
          <input type="number" id="course-count" class="calc-input" min="1" max="30" value="6" aria-label="عدد المواد" />
        </div>
        <div>
          <label class="calc-label" for="semester">الفصل الدراسي (اختياري)</label>
          <select id="semester" class="calc-select" aria-label="الفصل الدراسي">
            <option value="">جميع الفصول (GPA تراكمي)</option>
            <option value="1">الفصل الأول</option>
            <option value="2">الفصل الثاني</option>
            <option value="3">الفصل الثالث</option>
            <option value="4">الفصل الرابع</option>
          </select>
        </div>
      </div>

      <div id="courses" class="space-y-3" role="list" aria-label="قائمة المواد"></div>

      <button type="button" class="w-full sm:w-auto px-6 py-3 bg-emerald-500 hover:bg-emerald-600 text-slate-900 font-bold text-sm rounded-xl transition-colors" id="calculate-btn">
        احسب GPA
      </button>

      <div class="calc-output" aria-live="polite" aria-label="نتيجة الحساب">
        <div class="calc-out-val" id="result">0.00</div>
        <div class="calc-out-lbl">GPA</div>
        <div class="calc-out-lbl" style="margin-top:8px; font-size:0.68rem;" id="detail">إجمالي الساعات: 0 | إجمالي النقاط: 0.00</div>
      </div>

      <div class="formula-block">
        <div class="f-label">صيغة الحساب</div>
        <div class="f-text">GPA = Σ(ساعات × نقاط) ÷ Σساعات</div>
        <div class="f-example" id="formula-example">مثال: 3 ساعات A(4.0) + 3 ساعات B+(3.3) = (12+9.9)÷6 = 3.65</div>
      </div>
    </div>

    <section class="mt-12" aria-labelledby="regulation-heading">
      <h2 id="regulation-heading" class="text-2xl font-extrabold tracking-tight mb-6">اللائحة الرسمية</h2>
      <div class="prose">
        <h3>جدول التقديرات ({univ.system})</h3>
        <div class="table-scroll">
          <table>
            <thead>
              <tr>
                <th>التقدير</th>
                <th class="text-center">نقاط 4.0</th>
                <th class="text-center">النسبة المئوية</th>
              </tr>
            </thead>
            <tbody>
              {Object.entries(univ.gradeMapping).map(([grade, point]) => (
                <tr>
                  <td><strong>{grade}</strong></td>
                  <td class="text-center font-mono">{point.toFixed(2)}</td>
                  <td class="text-center">
                    {univ.percentageMapping && univ.percentageMapping[grade]
                      ? `${univ.percentageMapping[grade][0]}~${univ.percentageMapping[grade][1]}%`
                      : '—'}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <h3 class="mt-6">قواعد أكاديمية مهمة</h3>
        <ul>
          <li><strong>GPA:</strong> Σ(ساعات × نقاط) ÷ Σساعات (مقياس 4.0 أمريكي)</li>
          <li><strong>النجاح:</strong> 60% فأكثر (C = 2.0 فأعلى)</li>
          <li><strong>التخرج:</strong> GPA ≥ 2.0، إكمال الساعات المطلوبة</li>
          <li><strong>إنذار أكاديمي:</strong> GPA فصلي < 2.0</li>
          <li><strong>فصل أكاديمي:</strong> GPA تراكمي < 1.0 أو 3 إنذارات</li>
        </ul>

        <h3 class="mt-6">المصدر الرسمي</h3>
        <p><strong>{univ.source}</strong></p>
        <p><a href={univ.sourceUrl} target="_blank" rel="noopener" class="underline hover:text-emerald-500">{univ.sourceUrl}</a></p>
        {univ.note && <p class="text-sm text-slate-500 dark:text-zinc-400"><strong>ملاحظة:</strong> {univ.note}</p>}
      </div>
    </section>

    <section class="mt-12" aria-labelledby="related-heading">
      <h2 id="related-heading" class="text-2xl font-extrabold tracking-tight mb-6">جامعات إماراتية أخرى</h2>
      <div class="grid gap-3 sm:grid-cols-3">
        <a href="/ar/khalifa-university-gpa" class="calc-shell p-4 hover:border-emerald-500 transition-all text-center">جامعة خليفة — 4.0</a>
        <a href="/ar/american-university-sharjah-gpa" class="calc-shell p-4 hover:border-emerald-500 transition-all text-center">الجامعة الأمريكية بالشارقة — 4.0</a>
      </div>
    </section>
  </main>
</Layout>

<script is:inline>
  const GRADES = ['A', 'A-', 'B+', 'B', 'B-', 'C+', 'C', 'C-', 'D', 'F'];
  const POINTS = { 'A': 4.0, 'A-': 3.7, 'B+': 3.3, 'B': 3.0, 'B-': 2.7, 'C+': 2.3, 'C': 2.0, 'C-': 1.7, 'D': 1.0, 'F': 0.0 };
  const PERCENTAGES = { 'A': [90, 100], 'A-': [85, 89], 'B+': [80, 84], 'B': [75, 79], 'B-': [70, 74], 'C+': [65, 69], 'C': [60, 64], 'C-': [55, 59], 'D': [50, 54], 'F': [0, 49] };

  function createCourseRow(index) {
    const row = document.createElement('div');
    row.className = 'grid gap-3 sm:grid-cols-[1fr_80px_100px] items-end';
    row.setAttribute('role', 'listitem');
    row.innerHTML = `
      <div>
        <label class="calc-label" for="grade-${index}">المادة ${index + 1} - التقدير</label>
        <select id="grade-${index}" class="calc-select grade-select" aria-label="المادة ${index + 1} التقدير">
          ${GRADES.map(g => `<option value="${g}">${g} (${POINTS[g]}) ↔ ${PERCENTAGES[g][0]}~${PERCENTAGES[g][1]}%</option>`).join('')}
        </select>
      </div>
      <div>
        <label class="calc-label" for="credit-${index}">الساعات</label>
        <input type="number" id="credit-${index}" class="calc-input credit-input" value="3" min="1" max="6" step="1" aria-label="المادة ${index + 1} الساعات" />
      </div>
      <div>
        <label class="calc-label" for="course-name-${index}">اسم المادة (اختياري)</label>
        <input type="text" id="course-name-${index}" class="calc-input" placeholder="مثال: Calculus" aria-label="المادة ${index + 1} الاسم" />
      </div>
    `;
    return row;
  }

  function renderCourses(count) {
    const container = document.getElementById('courses');
    container.innerHTML = '';
    for (let i = 0; i < count; i++) {
      container.appendChild(createCourseRow(i));
    }
  }

  function calculateGPA() {
    const gradeSelects = document.querySelectorAll('#courses .grade-select');
    const creditInputs = document.querySelectorAll('#courses .credit-input');

    let totalCredits = 0;
    let totalPoints = 0;

    gradeSelects.forEach((select, i) => {
      const grade = select.value;
      const credit = parseFloat(creditInputs[i].value) || 0;
      const point = POINTS[grade] || 0;

      totalCredits += credit;
      totalPoints += credit * point;
    });

    const gpa = totalCredits > 0 ? totalPoints / totalCredits : 0;
    document.getElementById('result').textContent = gpa.toFixed(2);
    document.getElementById('detail').textContent = `إجمالي الساعات: ${totalCredits} | إجمالي النقاط: ${totalPoints.toFixed(2)}`;
  }

  const countInput = document.getElementById('course-count');
  const calculateBtn = document.getElementById('calculate-btn');
  let currentCount = parseInt(countInput.value) || 6;

  renderCourses(currentCount);
  calculateGPA();

  countInput.addEventListener('input', () => {
    let newCount = parseInt(countInput.value) || 1;
    newCount = Math.max(1, Math.min(30, newCount));
    currentCount = newCount;
    renderCourses(newCount);
    calculateGPA();
  });

  calculateBtn.addEventListener('click', calculateGPA);

  document.getElementById('courses').addEventListener('change', e => {
    if (e.target.matches('.grade-select, .credit-input')) {
      calculateGPA();
    }
  });
</script>
