---
import Layout from '@/layouts/Layout.astro';
import SiteHeader from '../components/Nav.astro';
import SiteFooter from '../components/Footer.astro';
---

<Layout 
  title="Contact Us | Global CGPA"
  description="Contact the Global CGPA team. Report a formula error, suggest a university, or ask a question."
  canonical="https://globalcgpa.in/contact"
>
  <SiteHeader />

  <main class="max-w-[780px] mx-auto px-6 py-14" style="flex:1;">
    <div class="text-xs font-bold uppercase tracking-wider text-emerald-500 mb-2">Contact Us</div>
    <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight mb-3">Get in touch</h1>
    <p class="text-slate-500 dark:text-zinc-400 text-base mb-10">
      Have a question, feedback, or a formula suggestion for your university? Send us a message.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-5 gap-8 items-start">
      <div class="md:col-span-2 space-y-6">
        <div>
          <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">Direct Contact</h3>
          <p class="text-sm text-slate-700 dark:text-zinc-300 font-medium">support@globalcgpa.in</p>
          <p class="text-xs text-slate-500 dark:text-zinc-400 mt-1">We typically respond within 48 hours.</p>
        </div>

        <div class="space-y-3">
          <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400">Common Reasons</h3>
          <div class="p-3 bg-slate-50 dark:bg-zinc-900 border border-slate-200 dark:border-zinc-800 rounded-lg">
            <p class="text-xs font-bold text-slate-900 dark:text-white">University Formula Missing</p>
            <p class="text-xs text-slate-500 dark:text-zinc-400 mt-0.5">Tell us your university name and formula link.</p>
          </div>
          <div class="p-3 bg-slate-50 dark:bg-zinc-900 border border-slate-200 dark:border-zinc-800 rounded-lg">
            <p class="text-xs font-bold text-slate-900 dark:text-white">Report Calculation Bug</p>
            <p class="text-xs text-slate-500 dark:text-zinc-400 mt-0.5">Let us know which scale gave an incorrect result.</p>
          </div>
        </div>
      </div>

      <div class="md:col-span-3 bg-white dark:bg-zinc-900 border border-slate-200 dark:border-zinc-800 rounded-2xl p-6 shadow-sm">
        <form id="contact-form" class="space-y-4" action="https://api.web3forms.com/submit" method="POST">
          <input type="hidden" name="access_key" value="YOUR_WEB3FORMS_ACCESS_KEY" />
          <input type="hidden" name="subject" value="New Contact Form Submission" />
          <input type="hidden" name="from_name" value="GlobalCGPA Contact Form" />
          <input type="hidden" name="redirect" value="https://globalcgpa.in/contact?success=true" />

          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-zinc-400 mb-1">Your Name</label>
            <input type="text" name="name" required placeholder="John Doe" class="w-full px-3.5 py-2.5 bg-slate-50 dark:bg-zinc-800 border border-slate-200 dark:border-zinc-700 rounded-xl text-sm focus:outline-none focus:border-emerald-500" />
          </div>

          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-zinc-400 mb-1">Email Address</label>
            <input type="email" name="email" required placeholder="john@example.com" class="w-full px-3.5 py-2.5 bg-slate-50 dark:bg-zinc-800 border border-slate-200 dark:border-zinc-700 rounded-xl text-sm focus:outline-none focus:border-emerald-500" />
          </div>

          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-zinc-400 mb-1">Subject</label>
            <select name="topic" class="w-full px-3.5 py-2.5 bg-slate-50 dark:bg-zinc-800 border border-slate-200 dark:border-zinc-700 rounded-xl text-sm focus:outline-none focus:border-emerald-500">
              <option value="General Feedback / Question">General Feedback / Question</option>
              <option value="Report Formula Error">Report Formula Error</option>
              <option value="Suggest New University Formula">Suggest New University Formula</option>
            </select>
          </div>

          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-zinc-400 mb-1">Message</label>
            <textarea name="message" required rows="4" placeholder="How can we help?" class="w-full px-3.5 py-2.5 bg-slate-50 dark:bg-zinc-800 border border-slate-200 dark:border-zinc-700 rounded-xl text-sm focus:outline-none focus:border-emerald-500"></textarea>
          </div>

          <button type="submit" class="w-full py-3 bg-emerald-500 hover:bg-emerald-600 text-slate-900 font-bold text-sm rounded-xl transition-colors disabled:opacity-50 disabled:cursor-not-allowed" id="submit-btn">
            <span class="btn-text">Send Message</span>
            <span class="btn-loading hidden">Sending...</span>
          </button>

          <p id="form-status" class="text-sm text-center hidden" aria-live="polite"></p>
        </form>

        <p class="mt-4 text-center text-xs text-slate-500 dark:text-zinc-400">
          Or email us directly at <a href="mailto:support@globalcgpa.in" class="underline hover:text-emerald-500">support@globalcgpa.in</a>
        </p>
      </div>
    </div>
  </main>
  <SiteFooter />
</Layout>

<script is:inline>
  const form = document.getElementById('contact-form');
  const statusEl = document.getElementById('form-status');
  const submitBtn = document.getElementById('submit-btn');
  const btnText = submitBtn.querySelector('.btn-text');
  const btnLoading = submitBtn.querySelector('.btn-loading');

  const urlParams = new URLSearchParams(window.location.search);
  if (urlParams.get('success') === 'true') {
    statusEl.textContent = 'Thank you! Your message has been received. We\'ll get back to you within 48 hours.';
    statusEl.className = 'text-sm text-center text-emerald-600 dark:text-emerald-400';
    statusEl.classList.remove('hidden');
    urlParams.delete('success');
    window.history.replaceState({}, '', `${window.location.pathname}${urlParams.toString() ? '?' + urlParams.toString() : ''}`);
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    statusEl.classList.add('hidden');
    statusEl.className = 'text-sm text-center hidden';
    submitBtn.disabled = true;
    btnText.classList.add('hidden');
    btnLoading.classList.remove('hidden');

    const formData = new FormData(form);

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        body: formData,
        headers: { 'Accept': 'application/json' }
      });

      const data = await response.json();

      if (response.ok && data.success) {
        statusEl.textContent = 'Thank you! Your message has been received. We\'ll get back to you within 48 hours.';
        statusEl.className = 'text-sm text-center text-emerald-600 dark:text-emerald-400';
        form.reset();
      } else {
        throw new Error(data.message || 'Submission failed');
      }
    } catch (err) {
      statusEl.textContent = 'Something went wrong. Please try again or email us at support@globalcgpa.in';
      statusEl.className = 'text-sm text-center text-red-600 dark:text-red-400';
    } finally {
      statusEl.classList.remove('hidden');
      submitBtn.disabled = false;
      btnText.classList.remove('hidden');
      btnLoading.classList.add('hidden');
    }
  });
</script>

