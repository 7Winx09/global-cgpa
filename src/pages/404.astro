---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 Page Not Found | CGPA Calculator" description="The page you are looking for does not exist. Return to the CGPA to percentage calculator.">
  <main class="min-h-[70vh] flex items-center justify-center text-center px-4">
    <div class="max-w-md">
      <h1 class="text-6xl font-extrabold tracking-tight mb-4 text-emerald-500">404</h1>
      <h2 class="text-2xl font-bold mb-2">Page Not Found</h2>
      <p class="text-slate-500 dark:text-zinc-400 mb-6">
        Sorry, the page you are looking for doesn't exist or has been moved.
      </p>
      <a href="/" class="inline-block bg-emerald-500 hover:bg-emerald-600 text-white font-medium px-6 py-2.5 rounded-lg transition-colors">
        Back to Calculator
      </a>
    </div>
  </main>
</Layout>
