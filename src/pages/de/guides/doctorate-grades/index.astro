---
import Layout from '@/layouts/Layout.astro';

const pageTitle = 'Promotionsnoten (Dr. / PhD) | Summa/Magna/Cum Laude, Rite, Gewichtung Dissertation';
const description = 'Promotionsnoten an deutschen Unis: summa cum laude (<1,5), magna cum laude (1,5–2,5), cum laude (2,5–3,0), rite (3,0–4,0). Gewichtung Dissertation 2:1 Kolloquium, Gutachter, Prüfungsausschuss.';
const canonical = 'https://globalcgpa.in/de/guides/doctorate-grades';
const ogImage = '/og-image-de.png';
const lang = 'de';
const alternates = [
  { hreflang: 'en', href: 'https://globalcgpa.in/guides/phd-grades' },
  { hreflang: 'de', href: 'https://globalcgpa.in/de/guides/doctorate-grades' },
];
---

<Layout title={pageTitle} description={description} canonical={canonical} ogImage={ogImage} lang={lang} alternates={alternates}>
  <main class="max-w-[780px] mx-auto px-6 py-14" style="flex:1;">
    <nav class="crumbs mb-6" aria-label="Breadcrumb">
      <a href="/de/">Notenrechner</a>
      <span class="sep">/</span>
      <a href="/de/guides">Guides</a>
      <span class="sep">/</span>
      <span class="current">Promotionsnoten</span>
    </nav>

    <div class="text-xs font-bold uppercase tracking-wider text-emerald-500 mb-2">Akademischer Guide</div>
    <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight mb-3">Promotionsnoten (Dr. / PhD)</h1>
    <p class="text-slate-500 dark:text-zinc-400 text-base mb-10">
      Promotionsnoten an TUM, Heidelberg, HU Berlin, KIT, RWTH, LMU: lateinische Prädikate,
      Gewichtung Dissertation vs. Kolloquium/Disputation, Gutachterverfahren, Gesamtnote Berechnung.
    </p>

    <section class="prose mb-12">
      <h2>Lateinische Prädikate (Standard an 6 Unis)</h2>
      <div class="table-scroll">
        <table>
          <thead>
            <tr>
              <th>Prädikat</th>
              <th class="text-center">Gesamtnote</th>
              <th>Bedeutung</th>
              <th>Häufigkeit</th>
            </tr>
          </thead>
          <tbody>
            <tr><td><strong>summa cum laude</strong></td><td class="text-center">< 1,5</td><td>mit höchstem Lob / ausgezeichnet</td><td class="text-center">~5–10%</td></tr>
            <tr><td><strong>magna cum laude</strong></td><td class="text-center">1,5 – 2,5</td><td>mit großem Lob / sehr gut</td><td class="text-center">~20–30%</td></tr>
            <tr><td><strong>cum laude</strong></td><td class="text-center">2,5 – 3,0 (bis 3,5)</td><td>mit Lob / gut</td><td class="text-center">~40–50%</td></tr>
            <tr><td><strong>rite</strong></td><td class="text-center">3,0 – 4,0</td><td>bestanden / ausreichend</td><td class="text-center">~20–30%</td></tr>
            <tr><td><strong>non sufficit</strong></td><td class="text-center">> 4,0</td><td>nicht bestanden</td><td class="text-center">selten</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="prose mb-12">
      <h2>Gewichtung: Dissertation vs. Kolloquium/Disputation</h2>
      <div class="bg-emerald-50 dark:bg-emerald-900/20 border border-emerald-200 dark:border-emerald-800 rounded-xl p-6">
        <h3 class="font-bold mb-3">Standard: 2 : 1 (Dissertation : Mündliche Prüfung)</h3>
        <div class="formula-block mb-4">
          <div class="f-label">Gesamtnote = (2 × Note_Dissertation + 1 × Note_Kolloquium) ÷ 3</div>
          <div class="f-text">Unrounded Werte, dann 1 Dezimalstelle abschneiden</div>
          <div class="f-example">Dissertation 1,3 + Kolloquium 2,0 = (2,6 + 2,0) ÷ 3 = 1,533... → <strong>1,5</strong> (magna cum laude)</div>
        </div>
      </div>
    </section>

    <section class="prose mb-12">
      <h2>Gutachterverfahren & Notenfindung</h2>
      <div class="table-scroll">
        <table>
          <thead><tr><th>Schritt</th><th>Ablauf</th><th>Note</th></tr></thead>
          <tbody>
            <tr><td>1. Einreichung</td><td>Dissertation bei Promotionsausschuss / Dekanat</td><td>—</td></tr>
            <tr><td>2. Gutachter</td><td>Mind. 2 Professoren (1. + 2. Gutachter), teils extern</td><td>Jeweils Note: 1,0 / 1,3 / 1,7 / 2,0 / 2,3 / 2,7 / 3,0</td></tr>
            <tr><td>3. Dissertationsnote</td><td>Mittelwert der Gutachternoten (ungerundet)</td><td>z.B. (1,0 + 1,3) ÷ 2 = 1,15</td></tr>
            <tr><td>4. Kolloquium/Disputation</td><td>Öffentlicher Vortrag + Prüfung (30–60 min)</td><td>Note durch Prüfungskommission (1,0–4,0)</td></tr>
            <tr><td>5. Gesamtnote</td><td>Gewichtung 2:1 (Dissertation : Kolloquium)</td><td>Abschneiden 1 Dezimalstelle</td></tr>
            <tr><td>6. Prädikat</td><td>Zuordnung laut Skala</td><td>summa/magna/cum laude/rite</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="prose mb-12">
      <h2>Besonderheiten pro Universität</h2>
      <div class="table-scroll">
        <table>
          <thead><tr><th>Universität</th><th>Promotionsordnung</th><th>Gewichtung</th><th>summa cum laude</th><th>Besonderheit</th></tr></thead>
          <tbody>
            <tr><td><strong>TUM</strong></td><td>Allg. PromO §20–22</td><td>2:1 (Diss:Koll)</td><td>1,0 + einstimmig + Gutachter-Vorschlag</td><td>Promotionsausschuss entscheidet; "mit Auszeichnung" möglich</td></tr>
            <tr><td><strong>Heidelberg</strong></td><td>PromO Fakultäten (§18–19)</td><td>2:1</td><td>< 1,5</td><td>Länderspezifische Tabellen für ausländ. Master-Noten</td></tr>
            <tr><td><strong>HU Berlin</strong></td><td>PromO Fakultäten</td><td>2:1</td><td>< 1,5</td><td>summa/magna/cum laude/rite/non sufficit (PromO §15)</td></tr>
            <tr><td><strong>KIT</strong></td><td>PromO §20–21</td><td>2:1</td><td>< 1,5</td><td>Gesamtnote: <1,5 magna, 1,5–2,5 cum laude, 2,5–3,0 rite</td></tr>
            <tr><td><strong>RWTH</strong></td><td>PromO §18–19</td><td>2:1</td><td>< 1,5 (teilweise)</td><td>Fachspezifisch; 3. Gutachter bei Differenz >2,0</td></tr>
            <tr><td><strong>LMU</strong></td><td>PromO Fakultäten (BayHSchG)</td><td>2:1</td><td>< 1,5</td><td>Jura: eigene PromO; Medizin: Dr. med. eigene Regeln</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="prose mb-12">
      <h2>Dissertationsnoten (Gutachter) — Skala</h2>
      <p>Gutachter vergeben nur bestimmte Noten (Promotions-spezifisch):</p>
      <div class="table-scroll">
        <table>
          <thead><tr><th>Note</th><th class="text-center">Lateinisch</th><th>Bedeutung</th></tr></thead>
          <tbody>
            <tr><td class="font-mono">1,0</td><td class="text-center">summa cum laude</td><td>ausgezeichnet</td></tr>
            <tr><td class="font-mono">1,3</td><td class="text-center">magna cum laude</td><td>sehr gut</td></tr>
            <tr><td class="font-mono">1,7</td><td class="text-center">cum laude</td><td>gut</td></tr>
            <tr><td class="font-mono">2,0</td><td class="text-center">cum laude</td><td>gut</td></tr>
            <tr><td class="font-mono">2,3</td><td class="text-center">cum laude</td><td>gut</td></tr>
            <tr><td class="font-mono">2,7</td><td class="text-center">rite</td><td>genügend</td></tr>
            <tr><td class="font-mono">3,0</td><td class="text-center">rite</td><td>genügend</td></tr>
            <tr><td class="font-mono">4,0</td><td class="text-center">non sufficit</td><td>nicht genügend (Ablehnung)</td></tr>
          </tbody>
        </table>
      </div>
      <p class="mt-2">Bei abweichenden Gutachtern: Mittelwert bilden; bei großer Differenz → 3. Gutachter (TUM, RWTH, Heidelberg).</p>
    </section>

    <section class="prose mb-12">
      <h2>Beispielrechnung</h2>
      <div class="bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800 rounded-xl p-6">
        <h3 class="font-bold mb-3">Fall: Informatik Promotion an TUM</h3>
        <div class="space-y-2 text-sm">
          <p><strong>Gutachter 1:</strong> 1,0 (summa cum laude)</p>
          <p><strong>Gutachter 2:</strong> 1,3 (magna cum laude)</p>
          <p><strong>Dissertationsnote:</strong> (1,0 + 1,3) ÷ 2 = <strong>1,15</strong> (ungerundet)</p>
          <p><strong>Kolloquium (Disputation):</strong> Prüfungskommission vergibt <strong>1,7</strong></p>
          <p><strong>Gesamtnote:</strong> (2 × 1,15 + 1 × 1,7) ÷ 3 = 4,0 ÷ 3 = <strong>1,333...</strong></p>
          <p><strong>Offizielle Note (1 Dez., abschneiden):</strong> <strong>1,3</strong></p>
          <p><strong>Prädikat:</strong> <strong>magna cum laude</strong> (1,3 – 1,5)</p>
          <p class="mt-2"><strong>Urkundentext:</strong> "magna cum laude" — "mit großem Lob bestanden"</p>
        </div>
      </div>
    </section>

    <section class="prose mb-12">
      <h2>Ausländische Master-Noten für Promotions-Zulassung</h2>
      <p>Voraussetzung für Promotion: Master-Note konvertiert ins deutsche System:</p>
      <div class="table-scroll">
        <table>
          <thead><tr><th>Herkunft</th><th>Methode</th><th>Typische Anforderung</th></tr></thead>
          <tbody>
            <tr><td>EU (ECTS)</td><td>ECTS Grade / Prozentil + Bayerische Formel</td><td>≥ "gut" (ca. 2,5) oder besser</td></tr>
            <tr><td>USA (GPA 4.0)</td><td>Bayerische Formel (Nmax=4,0, Nmin=2,0)</td><td>≥ 3,5 (≈ 1,5–2,0 dt.)</td></tr>
            <tr><td>UK (Percentage)</td><td>Bayerische Formel (Nmax=100, Nmin=40)</td><td>≥ 70% (≈ 1,9 dt.)</td></tr>
            <tr><td>China (100 / 5.0)</td><td>Bayerische Formel + anabin</td><td>≥ 85/100 oder ≥ 4,0/5,0</td></tr>
            <tr><td>Indien (10 / %)</td><td>Bayerische Formel + anabin</td><td>≥ 8,0/10 oder ≥ 75%</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="prose mb-12">
      <h2>Fehlgeschlagene Promotion (non sufficit)</h2>
      <details class="faq-row">
        <summary>Was passiert bei "non sufficit" (> 4,0)?</summary>
        <div class="faq-body">
          <ul class="list-disc list-inside space-y-1">
            <li>Dissertation abgelehnt (Gutachter 4,0 = non sufficit)</li>
            <li>Kolloquium nicht bestanden (> 4,0)</li>
            <li>Gesamtnote > 4,0</li>
            <li><strong>Rechtsmittel:</strong> Widerspruch → Klage (Verwaltungsgericht) möglich</li>
            <li><strong>Wiederholung:</strong> Meist 1x möglich (neue Dissertation / neues Kolloquium), Frist 1–2 Jahre</li>
            <li><strong>Zweite Nicht-Bestehen:</strong> Endgültig, Promotionsrecht erlischt</li>
          </ul>
        </div>
      </details>
      <details class="faq-row">
        <summary>Kann man Prädikat anfechten?</summary>
        <div class="faq-body">
          <p>Ja, formeller Widerspruch gegen Prüfungsentscheidung (Verwaltungsakt). Frist: 1 Monat ab Bekanntgabe. Begründung: Verfahrensfehler, Bewertungsfehlerm, Befangenheit. Keine inhaltliche Neubewertung durch Gericht.</p>
        </div>
      </details>
    </section>

    <section class="prose">
      <h2>Referenzen</h2>
      <ul>
        <li>TUM: Allgemeine Promotionsordnung (Allg. PromO) §20–22</li>
        <li>Heidelberg: Promotionsordnungen der Fakultäten §18–19</li>
        <li>HU Berlin: Promotionsordnungen der Fakultäten (ZSP-HU Bezug)</li>
        <li>KIT: Promotionsordnung §20–21 (Gesamtnote, Prädikate)</li>
        <li>RWTH: Promotionsordnung §18–19 (Gutachter, Gewichtung, 3. Gutachter)</li>
        <li>LMU: Promotionsordnungen der Fakultäten (BayHSchG)</li>
        <li>HRK: "Empfehlungen zur Promotion" (Gutachterverfahren, Prädikate)</li>
      </ul>
    </section>
  </main>
</Layout>

