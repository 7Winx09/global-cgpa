---
import Layout from '@/layouts/Layout.astro';
import { getUniversityByKey } from '@/data/universities-global';

const univ = getUniversityByKey('de-tum')!;
const pageTitle = `${univ.name} Notendurchschnitt | ${univ.system} Skala`;
const description = `${univ.name} (TUM) Notendurchschnitt Rechner. Skala 1,0–4,0 (APSO §17). 1,0=sehr gut, 4,0=ausreichend. Gewichtung nach ECTS. Modifizierte Bayerische Formel (APSO §16) für Auslandsumrechnung.`;
const canonical = `https://globalcgpa.in/de/${univ.slug}`;
const ogImage = '/og-image-de.png';
const lang = 'de';
const alternates = [
  { hreflang: 'en', href: 'https://globalcgpa.in/university/tum' },
  { hreflang: 'de', href: `https://globalcgpa.in/de/${univ.slug}` },
];
---

<Layout title={pageTitle} description={description} canonical={canonical} ogImage={ogImage} lang={lang} alternates={alternates}>
  <main class="max-w-[780px] mx-auto px-6 py-14" style="flex:1;">
    <nav class="crumbs mb-6" aria-label="Breadcrumb">
      <a href="/de/">Notenrechner</a>
      <span class="sep">/</span>
      <a href="/de/universities">Universitäten</a>
      <span class="sep">/</span>
      <span class="current">{univ.name}</span>
    </nav>

    <div class="text-xs font-bold uppercase tracking-wider text-emerald-500 mb-2">{univ.name} ({univ.nameEn})</div>
    <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight mb-3">{univ.name} Notendurchschnitt</h1>
    <p class="text-slate-500 dark:text-zinc-400 text-base mb-8">
      {univ.name} offizielle Notenskala 1,0–4,0 (APSO §17, Fassung 12. Änderung 16.12.2025).
      Noten in 0,3-Schritten (1,0, 1,3, 1,7, 2,0, 2,3, 2,7, 3,0, 3,3, 3,7, 4,0). 0,7 und 5,3 ausgeschlossen.
      Modulnote & Gesamtnote gewichtet nach ECTS. 1. Dezimalstelle, keine Rundung.
    </p>

    <div class="calc-shell space-y-6" id="univ-gpa-calculator">
      <div class="flex items-center gap-3">
        <span class="px-3 py-1 bg-emerald-100 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-300 text-xs font-bold rounded-full">
          {univ.system}
        </span>
        <span class="text-sm text-slate-500 dark:text-zinc-400">Noten: 1,0–1,3 (sehr gut), 1,7–2,3 (gut), 2,7–3,3 (befriedigend), 3,7–4,0 (ausreichend)</span>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <label class="calc-label" for="course-count">Anzahl Module</label>
          <input type="number" id="course-count" class="calc-input" min="1" max="30" value="6" aria-label="Anzahl Module" />
        </div>
        <div>
          <label class="calc-label" for="semester">Semester (Optional)</label>
          <select id="semester" class="calc-select" aria-label="Semester">
            <option value="">Alle Semester (Gesamtnote)</option>
            <option value="1">1. Semester</option>
            <option value="2">2. Semester</option>
            <option value="3">3. Semester</option>
            <option value="4">4. Semester</option>
          </select>
        </div>
      </div>

      <div id="courses" class="space-y-3" role="list" aria-label="Modulliste"></div>

      <button type="button" class="w-full sm:w-auto px-6 py-3 bg-emerald-500 hover:bg-emerald-600 text-slate-900 font-bold text-sm rounded-xl transition-colors" id="calculate-btn">
        Notendurchschnitt Berechnen
      </button>

      <div class="calc-output" aria-live="polite" aria-label="Ergebnis">
        <div class="calc-out-val" id="result">1.00</div>
        <div class="calc-out-lbl">Gesamtnote (1,0–4,0)</div>
        <div class="calc-out-lbl" style="margin-top:8px; font-size:0.68rem;" id="detail">Gesamt LP: 0 | Gewichtete Summe: 0.00</div>
      </div>

      <div class="formula-block">
        <div class="f-label">Berechnungsformel (APSO §17)</div>
        <div class="f-text">Gesamtnote = Σ(LP × Note) ÷ ΣLP (1. Dezimalstelle, ohne Rundung)</div>
        <div class="f-example" id="formula-example">Beispiel: 6 LP × 1,3 + 6 LP × 2,0 = 19,8 ÷ 12 = 1,6 (gut)</div>
      </div>
    </div>

    <section class="mt-12" aria-labelledby="regulation-heading">
      <h2 id="regulation-heading" class="text-2xl font-extrabold tracking-tight mb-6">APSO Prüfungsordnung TUM</h2>
      <div class="prose">
        <h3>Notenskala ({univ.system})</h3>
        <div class="table-scroll">
          <table>
            <thead>
              <tr>
                <th>Note</th>
                <th class="text-center">Beurteilung</th>
                <th>Beschreibung</th>
              </tr>
            </thead>
            <tbody>
              {Object.entries(univ.gradeMapping).map(([grade, point]) => (
                <tr>
                  <td><strong>{grade}</strong></td>
                  <td class="text-center">
                    {grade <= '1,5' ? 'sehr gut' :
                     grade <= '2,5' ? 'gut' :
                     grade <= '3,5' ? 'befriedigend' :
                     grade <= '4,0' ? 'ausreichend' :
                     'nicht ausreichend'}
                  </td>
                  <td>
                    {grade <= '1,5' ? 'hervorragende Leistung' :
                     grade <= '2,5' ? 'Leistung weit über Durchschnitt' :
                     grade <= '3,5' ? 'durchschnittliche Anforderungen' :
                     grade <= '4,0' ? 'trotz Mängel noch genügend' :
                     'erhebliche Mängel'}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <h3 class="mt-6">Gesamtnote Bachelor/Master (APSO §17 Abs. 4)</h3>
        <div class="table-scroll">
          <table>
            <thead>
              <tr>
                <th>Gesamtnote</th>
                <th class="text-center">Prädikat</th>
                <th>Bedeutung</th>
              </tr>
            </thead>
            <tbody>
              <tr><td class="font-mono font-bold">≤ 1,5</td><td class="text-center">sehr gut</td><td>hervorragende Leistung</td></tr>
              <tr><td class="font-mono font-bold">1,6 – 2,5</td><td class="text-center">gut</td><td>deutlich über Durchschnitt</td></tr>
              <tr><td class="font-mono font-bold">2,6 – 3,5</td><td class="text-center">befriedigend</td><td>durchschnittlich</td></tr>
              <tr><td class="font-mono font-bold">3,6 – 4,0</td><td class="text-center">ausreichend</td><td>trotz Mängel bestanden</td></tr>
            </tbody>
          </table>
        </div>

        <h3 class="mt-6">Besondere Prädikate (APSO §17 Abs. 6)</h3>
        <ul>
          <li><strong>Mit Auszeichnung bestanden:</strong> Gesamtnote ≤ 1,2 = ganz hervorragende Leistung</li>
          <li><strong>Sehr gut bestanden:</strong> Gesamtnote 1,3 – 1,5 = besonders anzuerkennende Leistung</li>
          <li><strong>Gut bestanden:</strong> Gesamtnote 1,6 – 2,5 = über Durchschnitt</li>
          <li><strong>Befriedigend bestanden:</strong> Gesamtnote 2,6 – 3,5 = durchschnittlich</li>
          <li><strong>Bestanden:</strong> Gesamtnote 3,6 – 4,0 = durchschnittlich mit Mängeln</li>
        </ul>

        <h3 class="mt-6">Wichtige Regeln</h3>
        <ul>
          <li><strong>Modulnote:</strong> Gewichtet nach LP (Credits); 1. Dezimalstelle, keine Rundung</li>
          <li><strong>Gesamtnote:</strong> Gewichtet nach Credits aller Module + Abschlussarbeit</li>
          <li><strong>Auslandsumrechnung:</strong> Modifizierte Bayerische Formel (APSO §16 Abs. 6): x = 1 + 3 × (Nmax - Nd) ÷ (Nmax - Nmin)</li>
          <li><strong>ECTS Grading Table:</strong> Für jedes Modul & Gesamtnote (Kohorte letzte 2 Studienjahre)</li>
          <li><strong>Wahlmodule:</strong> Beste Ergebnisse bis max. Creditumfang zählen bei Überschreitung</li>
        </ul>

        <h3 class="mt-6">Quelle</h3>
        <p><strong>{univ.source}</strong></p>
        <p><a href={univ.sourceUrl} target="_blank" rel="noopener" class="underline hover:text-emerald-500">{univ.sourceUrl}</a></p>
        {univ.note && <p class="text-sm text-slate-500 dark:text-zinc-400"><strong>Hinweis:</strong> {univ.note}</p>}
      </div>
    </section>

    <section class="mt-12" aria-labelledby="related-heading">
      <h2 id="related-heading" class="text-2xl font-extrabold tracking-tight mb-6">Andere Universitäten</h2>
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        <a href="/de/universitaet-heidelberg-notendurchschnitt" class="calc-shell p-4 hover:border-emerald-500 transition-all text-center">Heidelberg — 1-6</a>
        <a href="/de/humboldt-universitaet-berlin-notendurchschnitt" class="calc-shell p-4 hover:border-emerald-500 transition-all text-center">HU Berlin — 1-6</a>
        <a href="/de/kit-karlsruhe-notendurchschnitt" class="calc-shell p-4 hover:border-emerald-500 transition-all text-center">KIT — 1-6</a>
        <a href="/de/rwth-aachen-notendurchschnitt" class="calc-shell p-4 hover:border-emerald-500 transition-all text-center">RWTH — 1-6</a>
        <a href="/de/lmu-muenchen-notendurchschnitt" class="calc-shell p-4 hover:border-emerald-500 transition-all text-center">LMU München — 1-6</a>
      </div>
    </section>
  </main>
</Layout>

<script is:inline>
  const GRADES = ['1,0', '1,3', '1,7', '2,0', '2,3', '2,7', '3,0', '3,3', '3,7', '4,0', '5,0'];
  const POINTS = { '1,0': 1.0, '1,3': 1.3, '1,7': 1.7, '2,0': 2.0, '2,3': 2.3, '2,7': 2.7, '3,0': 3.0, '3,3': 3.3, '3,7': 3.7, '4,0': 4.0, '5,0': 5.0 };

  function createCourseRow(index) {
    const row = document.createElement('div');
    row.className = 'grid gap-3 sm:grid-cols-[1fr_80px_100px] items-end';
    row.setAttribute('role', 'listitem');
    row.innerHTML = `
      <div>
        <label class="calc-label" for="grade-${index}">Modul ${index + 1} Note</label>
        <select id="grade-${index}" class="calc-select grade-select" aria-label="Modul ${index + 1} Note">
          ${GRADES.map(g => `<option value="${g}">${g} ${g <= '4,0' ? '(bestanden)' : '(nicht bestanden)'}</option>`).join('')}
        </select>
      </div>
      <div>
        <label class="calc-label" for="credit-${index}">LP/ECTS</label>
        <input type="number" id="credit-${index}" class="calc-input credit-input" value="6" min="1" max="30" step="1" aria-label="Modul ${index + 1} LP" />
      </div>
      <div>
        <label class="calc-label" for="course-name-${index}">Name (Optional)</label>
        <input type="text" id="course-name-${index}" class="calc-input" placeholder="z.B. Analysis" aria-label="Modul ${index + 1} Name" />
      </div>
    `;
    return row;
  }

  function renderCourses(count) {
    const container = document.getElementById('courses');
    container.innerHTML = '';
    for (let i = 0; i < count; i++) {
      container.appendChild(createCourseRow(i));
    }
  }

  function calculateGPA() {
    const gradeSelects = document.querySelectorAll('#courses .grade-select');
    const creditInputs = document.querySelectorAll('#courses .credit-input');

    let totalCredits = 0;
    let totalPoints = 0;

    gradeSelects.forEach((select, i) => {
      const grade = select.value;
      const credit = parseFloat(creditInputs[i].value) || 0;
      const point = POINTS[grade] || 0;

      totalCredits += credit;
      totalPoints += credit * point;
    });

    const gpa = totalCredits > 0 ? totalPoints / totalCredits : 0;
    document.getElementById('result').textContent = gpa.toFixed(2).replace('.', ',');
    document.getElementById('detail').textContent = `Gesamt LP: ${totalCredits} | Gewichtete Summe: ${totalPoints.toFixed(2)}`;
  }

  const countInput = document.getElementById('course-count');
  const calculateBtn = document.getElementById('calculate-btn');
  let currentCount = parseInt(countInput.value) || 6;

  renderCourses(currentCount);
  calculateGPA();

  countInput.addEventListener('input', () => {
    let newCount = parseInt(countInput.value) || 1;
    newCount = Math.max(1, Math.min(30, newCount));
    currentCount = newCount;
    renderCourses(newCount);
    calculateGPA();
  });

  calculateBtn.addEventListener('click', calculateGPA);

  document.getElementById('courses').addEventListener('change', e => {
    if (e.target.matches('.grade-select, .credit-input')) {
      calculateGPA();
    }
  });
</script>
